<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PPObjectSearch</RootNamespace>
    <AssemblyName>PPObjectSearch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <Version>1.12.0</Version>
    <Product>Power Platform Object Search</Product>
    <Description>Keyword search over the objects in a Power Platform solution.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PPObjectSearch.Tests" />
  </ItemGroup>

  <!-- The test project lives under the app's folder; keep its sources out of the app. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
