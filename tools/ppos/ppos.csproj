<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command line: a console exe beside the app, so a pipeline gets its output and its exit
    code the usual way - a windowed exe returns to the shell before it has finished. It runs the
    app's own read-only checks; nothing here can write to an environment.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The app's assembly refers to WPF, so the desktop runtime has to be there to load it. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PPObjectSearch.Cli</RootNamespace>
    <AssemblyName>ppos</AssemblyName>
    <Version>1.12.2</Version>
    <!-- The same product name as the app: signing (packaging/signpath) checks every exe carries it. -->
    <Product>Power Platform Object Search</Product>
    <AssemblyTitle>Power Platform Object Search command line</AssemblyTitle>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PPObjectSearch.csproj" />
  </ItemGroup>

</Project>
