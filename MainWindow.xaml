<Window x:Class="PPObjectSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPObjectSearch.Views"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="Power Platform Object Search"
        Style="{StaticResource AppWindow}"
        Tag="Main"
        Height="780" Width="1280"
        MinHeight="540" MinWidth="960"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding AddTabCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseCurrentCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Ctrl+Shift" Command="{Binding MoveTabLeftCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Ctrl+Shift" Command="{Binding MoveTabRightCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding GlobalSearchCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding CompareCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl+Shift" Command="{Binding CompareDataCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding ReadinessCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{Binding TableSettingsCommand}" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding CommandPaletteCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl+Shift" Command="{Binding CloseAllDetailsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- A group of the selected environment's tools: 10 SemiBold Faint. -->
        <!-- Every sidebar heading. Muted, not Faint: at 10px Faint is about 3:1 on the sidebar. -->
        <Style TargetType="TextBlock" x:Key="SidebarGroup">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="8,6,8,2" />
        </Style>

        <!-- The two halves of a two-column row of sidebar actions, 2px apart. -->
        <Style TargetType="Button" x:Key="SidebarLeft" BasedOn="{StaticResource SidebarAction}">
            <Setter Property="Margin" Value="0,0,1,0" />
        </Style>
        <Style TargetType="Button" x:Key="SidebarRight" BasedOn="{StaticResource SidebarAction}">
            <Setter Property="Margin" Value="1,0,0,0" />
        </Style>

        <!-- The screen tab strip's tabs: the look of the app's other tabs - muted until chosen,
             then an accent underline. The environment's own tab is a button; the screens are list items. -->
        <Style TargetType="Button" x:Key="HomeTab">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" Margin="0,0,2,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource Accent}"
                                       Visibility="{Binding Screens.IsHomeSelected, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Trigger>
                <DataTrigger Binding="{Binding Screens.IsHomeSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="ScreenTab">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Margin="0,0,2,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource Accent}"
                                       Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ sidebar -->
        <Grid Grid.Column="0" Margin="8,4,8,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,8,0,6">
                <TextBlock Text="ENVIRONMENTS" Style="{StaticResource SidebarGroup}" Margin="0" VerticalAlignment="Center" />
                <Button AutomationProperties.Name="Open another environment in a new tab (Ctrl+T)" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                        Width="22" Height="22" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="11"
                        Foreground="{DynamicResource Muted}" Content="&#xE710;"
                        ToolTip="Open another environment in a new tab (Ctrl+T)"
                        Command="{Binding AddTabCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ListBox x:Name="SessionList"
                             ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height" Value="40" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="AllowDrop" Value="True" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tab_PreviewMouseLeftButtonDown" />
                                <EventSetter Event="PreviewMouseMove" Handler="Tab_PreviewMouseMove" />
                                <EventSetter Event="DragOver" Handler="Tab_DragOver" />
                                <EventSetter Event="Drop" Handler="Tab_Drop" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding EnvironmentUrl}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EnvironmentTypeDescription}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" MaxWidth="400" />
                                            <TextBlock Text="{Binding BrowserProfileDescription}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" MaxWidth="400"
                                                       Visibility="{Binding BrowserProfileDescription, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding AppInsightsDescription}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" MaxWidth="400"
                                                       Visibility="{Binding AppInsightsDescription, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding WriteAccessDescription}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" MaxWidth="400" FontWeight="SemiBold"
                                                       Visibility="{Binding WriteAccessDescription, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>
                                    </Grid.ToolTip>
                                    <Grid.ContextMenu>
                                        <ContextMenu Opened="EnvironmentMenu_Opened">
                                            <!-- Where this environment's links and sign-ins open. -->
                                            <MenuItem Header="Open links in" ItemsSource="{Binding BrowserProfileOptions}">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="{Binding Label}" />
                                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                                        <Setter Property="Command"
                                                                Value="{Binding DataContext.SetBrowserProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <MenuItem Header="App Insights resource…" Command="{Binding ChooseAppInsightsCommand}"
                                                      ToolTip="Choose the Application Insights resource this environment's Dataverse data export writes to." />
                                            <MenuItem Header="Check Azure access…" Command="{Binding CheckAzureAccessCommand}"
                                                      ToolTip="Tries the Azure APIs the App Insights features use, as this tab's account, and says what worked." />
                                            <Separator />
                                            <MenuItem Header="Allow writes to this environment…"
                                                      Command="{Binding AllowWritesCommand}"
                                                      Visibility="{Binding IsWriteAllowlisted, Converter={StaticResource NotBoolToVis}}"
                                                      ToolTip="Lets Reconcile, the membership tools and quick actions change this environment. Only offered where the production guard applies." />
                                            <MenuItem Header="Stop allowing writes"
                                                      Command="{Binding RevokeWritesCommand}"
                                                      Visibility="{Binding IsWriteAllowlisted, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="Blocks writes here again, as the production guard does by default." />
                                            <Separator />
                                            <MenuItem Header="Close tab" InputGestureText="Ctrl+W"
                                                      Click="CloseTab_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource EnvBar}" Height="24" Margin="0,0,9,0"
                                            Tag="{Binding EnvironmentSku}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- A left-aligned grid rather than a stack panel, so a long name
                                             trims and the lock and connected dot after it stay in view. -->
                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE785;" FontSize="10" Margin="5,1,0,0"
                                                       Foreground="{DynamicResource Amber}"
                                                       ToolTip="Writes allowed. Every change is still previewed and confirmed."
                                                       Visibility="{Binding IsWriteAllowlisted, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Grid.Column="2" Margin="6,1,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                                                        <Setter Property="ToolTip" Value="Not connected" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Green}" />
                                                                <Setter Property="ToolTip" Value="Connected" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding EnvironmentHost}" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- The badge gives way to a close button while the row is hovered. -->
                                    <Grid Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <ContentControl x:Name="Badge" Style="{StaticResource EnvTypeBadge}"
                                                        AutomationProperties.Name="{Binding EnvironmentSku, Converter={StaticResource SkuBadge}}"
                                                        Tag="{Binding EnvironmentSku}"
                                                        Content="{Binding EnvironmentSku, Converter={StaticResource SkuBadge}, ConverterParameter=short}" />
                                        <Button AutomationProperties.Name="Close tab (Ctrl+W)" x:Name="CloseButton" Visibility="Collapsed" Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="0" HorizontalAlignment="Right"
                                                FontFamily="{StaticResource IconFont}" FontSize="9"
                                                Foreground="{DynamicResource Muted}" Content="&#xE8BB;"
                                                ToolTip="Close tab (Ctrl+W)"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Badge" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- The selected environment's own tools, once it is connected. Every row has a
                         fixed height, so the list fits at the default 780px without squeezing any. -->
                    <StackPanel DataContext="{Binding SelectedSession}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal" Margin="8,12,8,2">
                            <Border Style="{StaticResource EnvBar}" Width="3" Height="11" Margin="0,0,7,0"
                                    Tag="{Binding EnvironmentSku}" />
                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                       MaxWidth="190" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- What happened here: changes, failures, imports, who can do what. -->
                        <TextBlock Text="INVESTIGATE" Style="{StaticResource SidebarGroup}" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SidebarLeft}" Command="{Binding RecentChangesCommand}"
                                    ToolTip="What changed here, when and by whom">
                                <TextBlock Text="Recent changes" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}" Command="{Binding FailuresCommand}"
                                    ToolTip="Flow runs, workflow jobs and plug-ins that failed">
                                <TextBlock Text="Failures" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SidebarLeft}" Command="{Binding SolutionHistoryCommand}"
                                    ToolTip="Imports, upgrades, uninstalls and exports">
                                <TextBlock Text="Solution history" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}" Command="{Binding SecurityLookupCommand}"
                                    ToolTip="Who can…, effective access, secured columns, compare roles">
                                <TextBlock Text="Security lookup" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </UniformGrid>
                        <Button Style="{StaticResource SidebarAction}" Command="{Binding TableDataCommand}"
                                ToolTip="The rows of a table - reference and config data, lookups, option lists. Read-only.">
                            <TextBlock Text="Table data" VerticalAlignment="Center" />
                        </Button>

                        <!-- Read-only: who is here, what they can do, and how mail reaches them. -->
                        <TextBlock Text="ADMIN · READ-ONLY" Style="{StaticResource SidebarGroup}" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SidebarLeft}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Users"
                                    ToolTip="Users, with their teams and security roles">
                                <TextBlock Text="Users" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Roles"
                                    ToolTip="Privileges, and who holds each role">
                                <TextBlock Text="Security roles" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Style="{StaticResource SidebarLeft}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Mailboxes"
                                    ToolTip="Server-side sync: approval and test results">
                                <TextBlock Text="Mailboxes" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Queues"
                                    ToolTip="Owner, email settings, mailbox and members">
                                <TextBlock Text="Queues" VerticalAlignment="Center" />
                            </Button>
                        </UniformGrid>

                        <Button Style="{StaticResource SidebarAction}" Command="{Binding EntraTeamSyncCommand}"
                                ToolTip="Compare an Entra group team with its Entra (RBAC) group, sync it, and remove users the sync leaves behind. Previews and asks before writing.">
                            <Grid>
                                <TextBlock Text="Entra team sync…" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource WritesTag}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarAction}" Command="{Binding QueueSyncCommand}"
                                ToolTip="Make a queue's members match a team's members, adding and removing. Previews and asks before writing.">
                            <Grid>
                                <TextBlock Text="Queue membership sync…" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource WritesTag}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="ACROSS ENVIRONMENTS" Style="{StaticResource SidebarGroup}" Margin="8,12,8,2" />

                    <!-- Everything not listed here - import log, dependencies, documentation, closing windows - is in the palette. -->
                    <Button Height="28" Margin="0,2" Padding="8,0" HorizontalContentAlignment="Stretch"
                            Command="{Binding CommandPaletteCommand}"
                            ToolTip="Every command and object, by name (Ctrl+K)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <TextBlock Text="Command palette…" VerticalAlignment="Center" />
                            <TextBlock Text="Ctrl+K" Style="{StaticResource Shortcut}" />
                        </Grid>
                    </Button>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource SidebarLeft}" Command="{Binding GlobalSearchCommand}"
                                ToolTip="One keyword across every connected environment (Ctrl+Shift+F)">
                            <TextBlock Text="Search all" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource SidebarRight}" Command="{Binding CompareCommand}"
                                ToolTip="Diff the objects loaded in two environments (Ctrl+D)">
                            <TextBlock Text="Compare" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource SidebarLeft}" Command="{Binding CompareDataCommand}"
                                ToolTip="Diff reference data rows between two environments (Ctrl+Shift+D)">
                            <TextBlock Text="Compare data" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource SidebarRight}" Command="{Binding ReadinessCommand}"
                                ToolTip="Will a solution import cleanly into another environment? (Ctrl+Shift+R)">
                            <TextBlock Text="Readiness" VerticalAlignment="Center" />
                        </Button>
                    </UniformGrid>
                    <Button Style="{StaticResource SidebarAction}" Command="{Binding TableSettingsCommand}"
                            ToolTip="Audit, change tracking, Synapse Link and Dataverse search, table by table across environments (Ctrl+Shift+A)">
                        <TextBlock Text="Table settings" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" FontSize="11" Margin="2,0,0,6"
                        Content="{Binding UpdateLabel}" Command="{Binding OpenUpdateCommand}"
                        ToolTip="Open the release page on GitHub"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />

                <Grid Grid.Row="1">
                    <!-- The version is in this row's tooltip. -->
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"
                            Margin="0,0,34,0" Content="Sign out all"
                            Command="{Binding SignOutAllCommand}">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Forget every signed-in account across all tenants." />
                                <TextBlock Text="{x:Static core:AppVersion.Description}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </Button.ToolTip>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button AutomationProperties.Name="Settings and logs" HorizontalAlignment="Right" Width="30" Height="30" Padding="0"
                            Style="{StaticResource GhostButton}" FontFamily="{StaticResource IconFont}" FontSize="13"
                            Foreground="{DynamicResource Muted}" Content="&#xE793;" ToolTip="Settings and logs"
                            core:Ui.OpensMenu="True">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Use Windows setting" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                          Command="{Binding SetThemeCommand}" CommandParameter="System" />
                                <MenuItem Header="Light" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                          Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                                <MenuItem Header="Dark" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                          Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                                <Separator />
                                <!-- Where details, Failures, Compare and the other screens open. -->
                                <MenuItem Header="Open screens in">
                                    <MenuItem Header="Tabs in this window" IsChecked="{Binding OpensScreensInTabs, Mode=OneWay}"
                                              Command="{Binding SetScreenPlacementCommand}" CommandParameter="Tab"
                                              ToolTip="Each screen opens as a tab here, and can be popped out into a window of its own." />
                                    <MenuItem Header="New windows" IsChecked="{Binding OpensScreensInWindows, Mode=OneWay}"
                                              Command="{Binding SetScreenPlacementCommand}" CommandParameter="Window"
                                              ToolTip="Each screen opens in a window of its own, which can be moved into a tab here." />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Open log folder" Command="{Binding OpenLogFolderCommand}"
                                          ToolTip="The app's log - attach today's file to a problem report" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================ content panel -->
        <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Screens opened as tabs: the environment first, then each screen with its pop-out
                     and close buttons. Only there while a screen is open. -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,0,6,0"
                        Visibility="{Binding Screens.HasTabs, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource HomeTab}" VerticalAlignment="Top"
                                Command="{Binding Screens.ShowHomeCommand}"
                                AutomationProperties.Name="{Binding SelectedSession.Title}"
                                ToolTip="{Binding SelectedSession.EnvironmentUrl}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource EnvBar}" Width="3" Height="12" Margin="0,0,7,0"
                                        Tag="{Binding SelectedSession.EnvironmentSku}" />
                                <TextBlock Text="{Binding SelectedSession.Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Rectangle DockPanel.Dock="Left" Width="1" Height="16" Margin="4,9,6,0" VerticalAlignment="Top"
                                   Fill="{DynamicResource Border}" />

                        <ListBox ItemsSource="{Binding Screens.Tabs}" SelectedItem="{Binding Screens.SelectedTab}"
                                 ItemContainerStyle="{StaticResource ScreenTab}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Title}">
                                        <StackPanel.InputBindings>
                                            <MouseBinding Gesture="MiddleClick"
                                                          Command="{Binding DataContext.Screens.CloseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}" />
                                        </StackPanel.InputBindings>
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open in a new window"
                                                          Command="{Binding PlacementTarget.Tag.PopOutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Close tab" InputGestureText="Ctrl+W"
                                                          Command="{Binding PlacementTarget.Tag.CloseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <StackPanel.Tag>
                                            <Binding Path="DataContext.Screens" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </StackPanel.Tag>
                                        <TextBlock Text="{Binding Title}" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button AutomationProperties.Name="Open in a new window" Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="0" Margin="6,0,0,0"
                                                FontFamily="{StaticResource IconFont}" FontSize="10"
                                                Foreground="{DynamicResource Muted}" Content="&#xE8A7;"
                                                ToolTip="Open in a new window"
                                                Command="{Binding DataContext.Screens.PopOutCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button AutomationProperties.Name="Close tab (Ctrl+W)" Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="0"
                                                FontFamily="{StaticResource IconFont}" FontSize="9"
                                                Foreground="{DynamicResource Muted}" Content="&#xE8BB;"
                                                ToolTip="Close tab (Ctrl+W)"
                                                Command="{Binding DataContext.Screens.CloseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding SelectedSession}" Focusable="False"
                                Visibility="{Binding Screens.IsHomeSelected, Converter={StaticResource BoolToVis}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <views:EnvironmentSessionView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Every screen tab stays loaded, one over another, so moving between them keeps
                     each one's place; only the selected one shows. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Screens.Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Content}"
                                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
