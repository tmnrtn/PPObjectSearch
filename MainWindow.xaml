<Window x:Class="PPObjectSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPObjectSearch.Views"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="Power Platform Object Search"
        Style="{StaticResource AppWindow}"
        Tag="Main"
        Height="780" Width="1280"
        MinHeight="540" MinWidth="960"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding AddTabCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"
                    CommandParameter="{Binding SelectedSession}" />
        <KeyBinding Key="PageUp" Modifiers="Ctrl+Shift" Command="{Binding MoveTabLeftCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Ctrl+Shift" Command="{Binding MoveTabRightCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding GlobalSearchCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding CompareCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl+Shift" Command="{Binding CompareDataCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding ReadinessCommand}" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding CommandPaletteCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl+Shift" Command="{Binding CloseAllDetailsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- A group of the selected environment's tools: 10 SemiBold Faint. -->
        <Style TargetType="TextBlock" x:Key="SidebarGroup">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="Margin" Value="8,6,8,2" />
        </Style>

        <!-- The two halves of a two-column row of sidebar actions, 2px apart. -->
        <Style TargetType="Button" x:Key="SidebarLeft" BasedOn="{StaticResource SidebarAction}">
            <Setter Property="Margin" Value="0,0,1,0" />
        </Style>
        <Style TargetType="Button" x:Key="SidebarRight" BasedOn="{StaticResource SidebarAction}">
            <Setter Property="Margin" Value="1,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ sidebar -->
        <Grid Grid.Column="0" Margin="8,4,8,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,8,0,6">
                <TextBlock Text="Environments" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <Button AutomationProperties.Name="Open another environment in a new tab (Ctrl+T)" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                        Width="22" Height="22" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="11"
                        Foreground="{DynamicResource Muted}" Content="&#xE710;"
                        ToolTip="Open another environment in a new tab (Ctrl+T)"
                        Command="{Binding AddTabCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ListBox x:Name="SessionList"
                             ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height" Value="40" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="AllowDrop" Value="True" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tab_PreviewMouseLeftButtonDown" />
                                <EventSetter Event="PreviewMouseMove" Handler="Tab_PreviewMouseMove" />
                                <EventSetter Event="DragOver" Handler="Tab_DragOver" />
                                <EventSetter Event="Drop" Handler="Tab_Drop" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding EnvironmentUrl}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EnvironmentTypeDescription}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" MaxWidth="400" />
                                            <TextBlock Text="{Binding BrowserProfileDescription}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" MaxWidth="400"
                                                       Visibility="{Binding BrowserProfileDescription, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding WriteAccessDescription}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" MaxWidth="400" FontWeight="SemiBold"
                                                       Visibility="{Binding WriteAccessDescription, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>
                                    </Grid.ToolTip>
                                    <Grid.ContextMenu>
                                        <ContextMenu Opened="EnvironmentMenu_Opened">
                                            <!-- Where this environment's links and sign-ins open. -->
                                            <MenuItem Header="Open links in" ItemsSource="{Binding BrowserProfileOptions}">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="{Binding Label}" />
                                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                                        <Setter Property="Command"
                                                                Value="{Binding DataContext.SetBrowserProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Allow writes to this environment…"
                                                      Command="{Binding AllowWritesCommand}"
                                                      Visibility="{Binding IsWriteAllowlisted, Converter={StaticResource NotBoolToVis}}"
                                                      ToolTip="Add this environment to AllowProductionWrites, so reconciling and the admin tools may change it. Only offered where the production guard applies." />
                                            <MenuItem Header="Stop allowing writes"
                                                      Command="{Binding RevokeWritesCommand}"
                                                      Visibility="{Binding IsWriteAllowlisted, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="Remove this environment from AllowProductionWrites. The production guard applies again." />
                                            <Separator />
                                            <MenuItem Header="Close tab" InputGestureText="Ctrl+W"
                                                      Click="CloseTab_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource EnvBar}" Height="24" Margin="0,0,9,0"
                                            Tag="{Binding EnvironmentSku}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxWidth="120"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE785;" FontSize="10" Margin="5,1,0,0"
                                                       Foreground="{DynamicResource Amber}"
                                                       ToolTip="Writes allowed - this environment is in AllowProductionWrites."
                                                       Visibility="{Binding IsWriteAllowlisted, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Margin="6,1,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                                                        <Setter Property="ToolTip" Value="Not connected" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Green}" />
                                                                <Setter Property="ToolTip" Value="Connected" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </StackPanel>
                                        <TextBlock Text="{Binding EnvironmentHost}" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- The badge gives way to a close button while the row is hovered. -->
                                    <Grid Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <ContentControl x:Name="Badge" Style="{StaticResource EnvTypeBadge}"
                                                        AutomationProperties.Name="{Binding EnvironmentSku, Converter={StaticResource SkuBadge}}"
                                                        Tag="{Binding EnvironmentSku}"
                                                        Content="{Binding EnvironmentSku, Converter={StaticResource SkuBadge}, ConverterParameter=short}" />
                                        <Button AutomationProperties.Name="Close tab (Ctrl+W)" x:Name="CloseButton" Visibility="Collapsed" Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="0" HorizontalAlignment="Right"
                                                FontFamily="{StaticResource IconFont}" FontSize="9"
                                                Foreground="{DynamicResource Muted}" Content="&#xE8BB;"
                                                ToolTip="Close tab (Ctrl+W)"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Badge" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- The selected environment's own tools, once it is connected. Every row has a
                         fixed height, so the list fits at the default 780px without squeezing any. -->
                    <StackPanel DataContext="{Binding SelectedSession}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal" Margin="8,12,8,2">
                            <Border Style="{StaticResource EnvBar}" Width="3" Height="11" Margin="0,0,7,0"
                                    Tag="{Binding EnvironmentSku}" />
                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                       MaxWidth="190" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- What happened here: changes, failures, imports, who can do what. -->
                        <TextBlock Text="INVESTIGATE" Style="{StaticResource SidebarGroup}" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SidebarLeft}" Command="{Binding RecentChangesCommand}"
                                    ToolTip="What changed here, when and by whom">
                                <TextBlock Text="Recent changes" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}" Command="{Binding FailuresCommand}"
                                    ToolTip="Flow runs, workflow jobs and plug-ins that failed">
                                <TextBlock Text="Failures" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SidebarLeft}" Command="{Binding SolutionHistoryCommand}"
                                    ToolTip="Imports, upgrades, uninstalls and exports">
                                <TextBlock Text="Solution history" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}" Command="{Binding SecurityLookupCommand}"
                                    ToolTip="Who can…, effective access, secured columns, compare roles">
                                <TextBlock Text="Security lookup" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </UniformGrid>

                        <!-- Read-only: who is here, what they can do, and how mail reaches them. -->
                        <TextBlock Text="ADMIN · READ-ONLY" Style="{StaticResource SidebarGroup}" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SidebarLeft}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Users"
                                    ToolTip="Users, with their teams and security roles">
                                <TextBlock Text="Users" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Roles"
                                    ToolTip="Privileges, and who holds each role">
                                <TextBlock Text="Security roles" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Style="{StaticResource SidebarLeft}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Mailboxes"
                                    ToolTip="Server-side sync: approval and test results">
                                <TextBlock Text="Mailboxes" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SidebarRight}"
                                    Command="{Binding EnvironmentAdminCommand}" CommandParameter="Queues"
                                    ToolTip="Owner, email settings, mailbox and members">
                                <TextBlock Text="Queues" VerticalAlignment="Center" />
                            </Button>
                        </UniformGrid>

                        <Button Style="{StaticResource SidebarAction}" Command="{Binding EntraTeamSyncCommand}"
                                ToolTip="Compare an Entra group team with its Entra (RBAC) group, sync it, and remove users the sync leaves behind. Previews and asks before writing.">
                            <Grid>
                                <TextBlock Text="Entra team sync…" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource WritesTag}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarAction}" Command="{Binding QueueSyncCommand}"
                                ToolTip="Make a queue's members match a team's members, adding and removing. Previews and asks before writing.">
                            <Grid>
                                <TextBlock Text="Queue membership sync…" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource WritesTag}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Across environments" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" Margin="8,12,8,2" />

                    <!-- Everything not listed here - import log, dependencies, documentation, closing windows - is in the palette. -->
                    <Button Height="28" Margin="0,2" Padding="8,0" HorizontalContentAlignment="Stretch"
                            Command="{Binding CommandPaletteCommand}"
                            ToolTip="Every command and object, by name (Ctrl+K)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <TextBlock Text="Command palette…" VerticalAlignment="Center" />
                            <TextBlock Text="Ctrl+K" Style="{StaticResource Shortcut}" />
                        </Grid>
                    </Button>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource SidebarLeft}" Command="{Binding GlobalSearchCommand}"
                                ToolTip="One keyword across every connected environment (Ctrl+Shift+F)">
                            <TextBlock Text="Search all" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource SidebarRight}" Command="{Binding CompareCommand}"
                                ToolTip="Diff the objects loaded in two environments (Ctrl+D)">
                            <TextBlock Text="Compare" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource SidebarLeft}" Command="{Binding CompareDataCommand}"
                                ToolTip="Diff reference data rows between two environments (Ctrl+Shift+D)">
                            <TextBlock Text="Compare data" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource SidebarRight}" Command="{Binding ReadinessCommand}"
                                ToolTip="Will a solution import cleanly into another environment? (Ctrl+Shift+R)">
                            <TextBlock Text="Readiness" VerticalAlignment="Center" />
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" FontSize="11" Margin="2,0,0,6"
                        Content="{Binding UpdateLabel}" Command="{Binding OpenUpdateCommand}"
                        ToolTip="Open the release page on GitHub"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />

                <Grid Grid.Row="1">
                    <!-- The version is in this row's tooltip. -->
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"
                            Margin="0,0,34,0" Content="Sign out all"
                            Command="{Binding SignOutAllCommand}">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Forget every signed-in account across all tenants." />
                                <TextBlock Text="{x:Static core:AppVersion.Description}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </Button.ToolTip>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button AutomationProperties.Name="Theme" HorizontalAlignment="Right" Width="30" Height="30" Padding="0"
                            Style="{StaticResource GhostButton}" FontFamily="{StaticResource IconFont}" FontSize="13"
                            Foreground="{DynamicResource Muted}" Content="&#xE793;" ToolTip="Theme"
                            core:Ui.OpensMenu="True">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Use Windows setting" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                          Command="{Binding SetThemeCommand}" CommandParameter="System" />
                                <MenuItem Header="Light" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                          Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                                <MenuItem Header="Dark" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                          Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                                <Separator />
                                <MenuItem Header="Open log folder" Command="{Binding OpenLogFolderCommand}"
                                          ToolTip="The app's log - attach today's file to a problem report" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================ content panel -->
        <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
            <ContentControl Content="{Binding SelectedSession}" Focusable="False">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:EnvironmentSessionView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Grid>
</Window>
