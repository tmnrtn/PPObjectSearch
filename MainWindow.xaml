<Window x:Class="PPObjectSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPObjectSearch.Views"
        Title="Power Platform Object Search"
        Height="780" Width="1280"
        MinHeight="540" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding AddTabCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"
                    CommandParameter="{Binding SelectedSession}" />
    </Window.InputBindings>

    <TabControl ItemsSource="{Binding Sessions}"
                SelectedItem="{Binding SelectedSession}"
                Background="{StaticResource SurfaceAlt}"
                BorderThickness="0"
                Padding="0">

        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,2,0" />
            </Style>
        </TabControl.Resources>

        <TabControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding EnvironmentUrl}">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#C4C9D0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#1F9D55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                               MaxWidth="190" TextTrimming="CharacterEllipsis" />

                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                            Margin="10,0,0,0" Padding="4" MinWidth="0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextMuted}"
                            ToolTip="Close tab (Ctrl+W)"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate>
                <views:EnvironmentSessionView />
            </DataTemplate>
        </TabControl.ContentTemplate>

        <!-- Tab strip trailing actions -->
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,6,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True" />
                            </ScrollViewer>

                            <Button Grid.Column="1" Content="+ Environment" MinWidth="0" Padding="10,5"
                                    Margin="8,0,0,6" VerticalAlignment="Bottom"
                                    ToolTip="Open another environment in a new tab (Ctrl+T)"
                                    Command="{Binding AddTabCommand}" />

                            <Button Grid.Column="2" Content="Sign out all" MinWidth="0" Padding="10,5"
                                    Margin="6,0,0,6" VerticalAlignment="Bottom"
                                    ToolTip="Forget every signed-in account across all tenants."
                                    Command="{Binding SignOutAllCommand}" />
                        </Grid>
                    </Border>

                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
    </TabControl>
</Window>
