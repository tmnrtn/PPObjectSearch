<UserControl x:Class="PPObjectSearch.Views.DefinitionDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PPObjectSearch.Views"
             xmlns:models="clr-namespace:PPObjectSearch.Models">

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="PaneHeading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Tag = an EnvironmentSku, or "Beneath" / "Layer" for a layer diff. -->
        <Style TargetType="Border" x:Key="SideBar" BasedOn="{StaticResource EnvBar}">
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Beneath">
                    <Setter Property="Background" Value="{DynamicResource Border2}" />
                </Trigger>
                <Trigger Property="Tag" Value="Layer">
                    <Setter Property="Background" Value="{DynamicResource Amber}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="PaneHeader">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="RichTextBox" x:Key="DiffPane">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Which property differs -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding Changes}"
                      SelectedItem="{Binding SelectedChange}"
                      SelectionMode="Single" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Property" Binding="{Binding PropertyName}" Width="*"
                                        HeaderStyle="{StaticResource FirstHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellMonoFirst}">
                                <Setter Property="ToolTip" Value="{Binding PropertyName}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Change" Width="78" SortMemberPath="Kind">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Margin="8,0" Content="{Binding KindLabel}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource PillAmber}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DefinitionChangeKind.Added}">
                                                    <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DefinitionChangeKind.Removed}">
                                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- The two sides, scrolled together -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PaneHeader}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Copy"
                            VerticalAlignment="Center"
                            ToolTip="Copy this whole value to the clipboard."
                            Command="{Binding CopyBeforeCommand}" />
                    <Border Style="{StaticResource SideBar}" Tag="{Binding BeforeMarker}" />
                    <TextBlock Style="{StaticResource PaneHeading}" Text="{Binding BeforeHeading}"
                               ToolTip="{Binding BeforeHeading}" />
                </DockPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PaneHeader}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Copy"
                            VerticalAlignment="Center"
                            ToolTip="Copy this whole value to the clipboard."
                            Command="{Binding CopyAfterCommand}" />
                    <Border Style="{StaticResource SideBar}" Tag="{Binding AfterMarker}" />
                    <TextBlock Style="{StaticResource PaneHeading}" Text="{Binding AfterHeading}"
                               ToolTip="{Binding AfterHeading}" />
                </DockPanel>
            </Border>

            <RichTextBox x:Name="BeforePane" Grid.Row="1" Grid.Column="0"
                         Style="{StaticResource DiffPane}"
                         views:DiffDocument.Side="Left"
                         views:DiffDocument.Rows="{Binding SelectedChange.Diff, IsAsync=True}" />

            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Border}" />

            <RichTextBox x:Name="AfterPane" Grid.Row="1" Grid.Column="2"
                         Style="{StaticResource DiffPane}"
                         views:DiffDocument.Side="Right"
                         views:DiffDocument.Rows="{Binding SelectedChange.Diff, IsAsync=True}" />
        </Grid>
    </Grid>
</UserControl>
