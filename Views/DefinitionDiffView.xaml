<UserControl x:Class="PPObjectSearch.Views.DefinitionDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PPObjectSearch.Views"
             FontFamily="Segoe UI" FontSize="13"
             Foreground="{StaticResource TextPrimary}">

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Cell">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="TextBlock" x:Key="PaneHeading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="RichTextBox" x:Key="DiffPane">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="AcceptsReturn" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Which property differs -->
        <DataGrid Grid.Column="0" ItemsSource="{Binding Changes}"
                  SelectedItem="{Binding SelectedChange}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3"
                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                  Background="{StaticResource Surface}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Property" Binding="{Binding PropertyName}" Width="*"
                                    ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Change" Binding="{Binding KindLabel}" Width="80"
                                    ElementStyle="{StaticResource Cell}" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- The two sides, scrolled together -->
        <Border Grid.Column="2" BorderBrush="{StaticResource Border}" BorderThickness="1"
                Background="{StaticResource Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2" MinWidth="0"
                                ToolTip="Copy this whole value to the clipboard."
                                Command="{Binding CopyBeforeCommand}" />
                        <TextBlock Style="{StaticResource PaneHeading}" Text="{Binding BeforeHeading}"
                                   ToolTip="{Binding BeforeHeading}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,1" Padding="10,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2" MinWidth="0"
                                ToolTip="Copy this whole value to the clipboard."
                                Command="{Binding CopyAfterCommand}" />
                        <TextBlock Style="{StaticResource PaneHeading}" Text="{Binding AfterHeading}"
                                   ToolTip="{Binding AfterHeading}" />
                    </DockPanel>
                </Border>

                <RichTextBox x:Name="BeforePane" Grid.Row="1" Grid.Column="0"
                             Style="{StaticResource DiffPane}"
                             views:DiffDocument.Side="Left"
                             views:DiffDocument.Rows="{Binding SelectedChange.Diff}" />

                <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{StaticResource Border}" />

                <RichTextBox x:Name="AfterPane" Grid.Row="1" Grid.Column="2"
                             Style="{StaticResource DiffPane}"
                             views:DiffDocument.Side="Right"
                             views:DiffDocument.Rows="{Binding SelectedChange.Diff}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
