<Window x:Class="PPObjectSearch.Views.LayerChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPObjectSearch.Views"
        Title="{Binding Title}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,14">
            <StackPanel>
                <TextBlock Text="{Binding Layer.SolutionName}" FontSize="17" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Layer.StateLabel}" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="{Binding Layer.PublisherName}" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="{Binding BelowLabel}" Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}">
            <TabItem Header="Changes">
                <views:DefinitionDiffView />
            </TabItem>

            <TabItem Header="Definition in this layer">
                <TextBox Text="{Binding Definition, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         BorderThickness="0" Background="{StaticResource Surface}"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}"
                           Text="Select text in either pane to copy it." />
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
