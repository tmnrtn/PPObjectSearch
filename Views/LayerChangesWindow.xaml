<Window x:Class="PPObjectSearch.Views.LayerChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPObjectSearch.Views"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="18,14,18,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource WindowHeading}" Text="{Binding Layer.SolutionName}" />
                    <ContentControl Margin="10,2,0,0">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                <Setter Property="Content" Value="{Binding Layer.StateLabel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layer.IsUnmanagedLayer}" Value="True">
                                        <Setter Property="Content" Value="Unmanaged layer" />
                                        <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AmberSoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>

                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ComponentLabel, Mode=OneWay}" />
                    <Run Text="·" Foreground="{DynamicResource Faint}" />
                    <Run Text="{Binding Layer.PublisherName, Mode=OneWay, StringFormat=Publisher {0}, TargetNullValue=No publisher}" />
                    <Run Text="·" Foreground="{DynamicResource Faint}" />
                    <Run Text="{Binding BelowLabel, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="Changes" core:Ui.Count="{Binding Changes.Count}">
                    <views:DefinitionDiffView />
                </TabItem>

                <TabItem Header="Definition in this layer">
                    <TextBox Style="{StaticResource CodeBox}" Text="{Binding Definition, Mode=OneWay}"
                             Background="{DynamicResource Surface}" />
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               Text="Select text in either pane to copy it" />
                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
