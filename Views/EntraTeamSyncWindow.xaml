<Window x:Class="PPObjectSearch.Views.EntraTeamSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        xmlns:svc="clr-namespace:PPObjectSearch.Services"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="760" Width="1280"
        MinHeight="500" MinWidth="960"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="ContentControl" x:Key="MatchPill" BasedOn="{StaticResource StatusPill}">
            <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Green}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:EntraMatchStatus.DataverseOnly}">
                    <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:EntraMatchStatus.EntraOnly}">
                    <Setter Property="Background" Value="{DynamicResource BlueSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Blue}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the environment, then what the window is. -->
            <StackPanel Grid.Row="0" Margin="18,12,18,12">
                <local:EnvironmentLine DataContext="{Binding Session}" />
                <TextBlock Text="Entra team sync" Style="{StaticResource WindowHeading}" />
            </StackPanel>

            <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Border}" />
            <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============================================================ team picker -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                        Background="{DynamicResource Surface2}">
                    <Grid Margin="10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="4,0,0,8">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center">
                                <Run Text="Entra group teams" /><Run Text="{Binding Teams.Count, Mode=OneWay, StringFormat=' · {0:N0}'}" />
                            </TextBlock>
                            <Button AutomationProperties.Name="Read the teams again" Style="{StaticResource GhostButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                    FontFamily="{StaticResource IconFont}" FontSize="11" Padding="0"
                                    Foreground="{DynamicResource Muted}"
                                    Width="24" Height="24" Command="{Binding RefreshTeamsCommand}" ToolTip="Read the teams again" />
                        </Grid>

                        <TextBox Grid.Row="1" Height="28" Margin="0,0,0,8"
                                 core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Team or business unit"
                                 Text="{Binding TeamSearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

                        <ListBox Grid.Row="2" ItemsSource="{Binding TeamsView}" SelectedItem="{Binding SelectedTeam}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,7" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding BusinessUnit, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding TypeDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ============================================================ comparison -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.RowSpan="4" Margin="0,80,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Muted}"
                               Text="Pick a team to compare its members with its Entra group."
                               Visibility="{Binding HasTeam, Converter={StaticResource NotBoolToVis}}" />

                    <!-- team ⇄ group, and how fresh the comparison is -->
                    <Grid Grid.Row="0" Margin="16,14,16,10"
                          Visibility="{Binding HasTeam, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Dataverse team" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding SelectedTeam.Name}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0">
                                    <Run Text="{Binding SelectedTeam.TypeDisplay, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding SelectedTeam.MembershipTypeLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" Margin="18,0" />
                            <StackPanel>
                                <TextBlock Text="Entra group" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding GroupLabel}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedTeam.AadObjectId}" Style="{StaticResource Mono}" FontSize="11"
                                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding LastReadLabel}" FontSize="11" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button AutomationProperties.Name="Read the team and the group again, without changing anything." Style="{StaticResource IconButton}" Content="&#xE72C;" Height="28"
                                    Command="{Binding ReloadCommand}"
                                    ToolTip="Read the team and the group again, without changing anything." />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="16,0,16,10"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" />
                    </Border>

                    <!-- filter, search, and the read-only tools -->
                    <Grid Grid.Row="2" Margin="16,0,16,10" Visibility="{Binding HasTeam, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Segmented}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedToggle}" Content="All" GroupName="EntraFilter"
                                             core:Ui.DotBrush="{DynamicResource Muted}" core:Ui.Count="{Binding CountAll, StringFormat=N0}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                                <RadioButton Style="{StaticResource SegmentedToggle}" Content="Both" GroupName="EntraFilter"
                                             core:Ui.DotBrush="{DynamicResource Green}" core:Ui.Count="{Binding CountBoth, StringFormat=N0}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Both}" />
                                <RadioButton Style="{StaticResource SegmentedToggle}" Content="Team only" GroupName="EntraFilter"
                                             core:Ui.DotBrush="{DynamicResource Amber}" core:Ui.Count="{Binding CountDataverseOnly, StringFormat=N0}"
                                             ToolTip="In the Dataverse team but not in the Entra group"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=DataverseOnly}" />
                                <RadioButton Style="{StaticResource SegmentedToggle}" Content="Group only" GroupName="EntraFilter"
                                             core:Ui.DotBrush="{DynamicResource Blue}" core:Ui.Count="{Binding CountEntraOnly, StringFormat=N0}"
                                             ToolTip="In the Entra group but not in the Dataverse team"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=EntraOnly}" />
                            </StackPanel>
                        </Border>

                        <TextBox Grid.Column="1" Height="30" Margin="8,0,0,0"
                                 core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Name, UPN or diagnosis"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Diagnose" Height="30" Command="{Binding DiagnoseCommand}"
                                    ToolTip="{Binding DiagnoseHint}" ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Copy provisioning script" Height="30" Margin="6,0,0,0"
                                    Command="{Binding CopyUserSyncScriptCommand}"
                                    ToolTip="{Binding CopyScriptHint}" ToolTipService.ShowOnDisabled="True" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding RowsView}" IsReadOnly="True"
                              BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                              Visibility="{Binding HasTeam, Converter={StaticResource BoolToVis}}">
                        <DataGrid.RowStyle>
                            <!-- How the sides were matched, and the Entra object id, without a column each. -->
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding RowToolTip}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="112" SortMemberPath="StatusLabel"
                                                    HeaderStyle="{StaticResource FirstHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource MatchPill}" Margin="16,0,8,0" Content="{Binding StatusLabel}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="UPN" Binding="{Binding Upn}" Width="220" ElementStyle="{StaticResource CellMuted}" />
                            <DataGridTemplateColumn Header="Diagnosis" Width="*" MinWidth="200" SortMemberPath="DiagnosisLabel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Cell}" ToolTip="{Binding DiagnosisDetail}">
                                            <Run Text="{Binding DiagnosisLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding DiagnosisDetail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Account" Width="150" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Only when something is wrong with the account. -->
                                        <ItemsControl ItemsSource="{Binding AccountFlags}" Margin="8,0" VerticalAlignment="Center"
                                                      Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentControl Style="{StaticResource Chip}" Content="{Binding}" FontSize="10"
                                                                    Margin="0,0,4,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- ============================================================ footer: the writes, each previewed first -->
            <Border Grid.Row="3" Style="{StaticResource Footer}" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding RemoveLeftoversLabel}" Height="30" Command="{Binding RemoveLeftoversCommand}"
                                ToolTip="{Binding RemoveLeftoversHint}" ToolTipService.ShowOnDisabled="True" />
                        <Button Content="{Binding PullInLabel}" Height="30" Margin="6,0,0,0" Command="{Binding PullInCommand}"
                                ToolTip="{Binding PullInHint}" ToolTipService.ShowOnDisabled="True" />
                        <Button Content="Sync from Entra…" Height="30" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SyncCommand}"
                                ToolTip="{Binding SyncHint}" ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
