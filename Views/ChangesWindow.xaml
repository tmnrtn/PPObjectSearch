<Window x:Class="PPObjectSearch.Views.ChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="700" Width="1150"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="16,14,16,12">
                <ComboBox Width="170" Height="32" Margin="0,0,8,6" core:Ui.InlineLabel="Show"
                          AutomationProperties.Name="Time range"
                          ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" />
                <ComboBox Width="240" Height="32" Margin="0,0,8,6" core:Ui.InlineLabel="Type"
                          AutomationProperties.Name="Type"
                          ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" />
                <CheckBox Content="Unmanaged only" Margin="4,0,12,6" VerticalAlignment="Center" IsChecked="{Binding UnmanagedOnly}"
                          ToolTip="Direct customisations - changes made in this environment rather than imported" />
                <Button Content="Refresh" Height="32" Margin="0,0,8,6" Command="{Binding RefreshCommand}" />
                <Button Content="Stop" Height="32" Margin="0,0,8,6" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Content="Audit history" Height="32" Margin="0,0,8,6" Command="{Binding AuditCommand}"
                        ToolTip="Who turned a flow on or off, enabled or disabled a step, or changed a variable's value - where Dataverse auditing records it" />
                <Button Content="Export CSV" Height="32" Margin="0,0,8,6" Command="{Binding ExportCsvCommand}" />
                <Button Content="Export Markdown" Height="32" Margin="0,0,8,6" Command="{Binding ExportMarkdownCommand}"
                        ToolTip="For an incident write-up" />
            </WrapPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}" IsReadOnly="True"
                      AutomationProperties.Name="Changes, newest first"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Width="140" SortMemberPath="When" HeaderStyle="{StaticResource FirstHeader}"
                                        Binding="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm}}" ElementStyle="{StaticResource CellFirst}" />
                    <DataGridTextColumn Header="Kind" Width="90" Binding="{Binding Kind}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="What" Width="*" Binding="{Binding What}" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Type" Width="220" Binding="{Binding Type}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Modified by" Width="180" Binding="{Binding By}" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Result" Width="220" Binding="{Binding Detail}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="State" Width="90" Binding="{Binding ManagedLabel}" ElementStyle="{StaticResource CellMuted}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Status}" />
            </Border>
        </Grid>
    </Border>
</Window>
