<Window x:Class="PPObjectSearch.Views.EntityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add tables"
        Height="620" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SEARCH" Style="{StaticResource Label}" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <CheckBox Grid.Column="1" Content="Hide managed tables" Margin="14,0,0,6"
                          VerticalAlignment="Bottom" IsChecked="{Binding HideManaged}"
                          ToolTip="Reference data normally lives in tables this tenant owns." />
            </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding ItemsView}" BorderThickness="0"
                 Background="{StaticResource Surface}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="4,3"
                              IsEnabled="{Binding IsAlreadyAdded, Converter={StaticResource NotBool}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Margin="10,0,0,0"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Summary}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Clear" MinWidth="0" Padding="12,5"
                            Command="{Binding ClearSelectionCommand}" />
                    <Button Content="Add" Margin="8,0,0,0" IsDefault="True" Click="Add_Click" />
                    <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
