<Window x:Class="PPObjectSearch.Views.EntityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="Add tables"
        Style="{StaticResource DialogWindow}"
        Height="620" Width="620"
        MinHeight="360" MinWidth="460"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,14,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Height="30"
                         core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Search tables by name"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Column="1" Content="Hide managed tables" Margin="14,0,0,0"
                          VerticalAlignment="Center" IsChecked="{Binding HideManaged}"
                          ToolTip="Reference data normally lives in tables this tenant owns." />
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding ItemsView}"
                     BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Height="32" Padding="16,0" Background="Transparent"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox x:Name="Pick" IsChecked="{Binding IsTicked}"
                                  HorizontalContentAlignment="Stretch"
                                  IsEnabled="{Binding IsAlreadyAdded, Converter={StaticResource NotBool}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontWeight="SemiBold"
                                           MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LogicalName}" Margin="8,0,0,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource Muted}" FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </CheckBox>
                        <DataTemplate.Triggers>
                            <!-- Already added: a grey ticked box, not a live control. -->
                            <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                                <Setter TargetName="Pick" Property="Background" Value="{DynamicResource Faint}" />
                                <Setter TargetName="Pick" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Style="{StaticResource Footer}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                        <Button Style="{StaticResource LinkButton}" Content="Clear" Height="24" Margin="6,0,0,0"
                                Command="{Binding ClearSelectionCommand}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Height="30" IsCancel="True" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding AddLabel}" Height="30"
                                Margin="8,0,0,0" IsDefault="True" Click="Add_Click"
                                IsEnabled="{Binding HasSelection}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
