<Window x:Class="PPObjectSearch.Views.DocumentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <StackPanel>
            <!-- ============================================================ header -->
            <StackPanel Margin="18,12,18,12">
                <local:EnvironmentLine DataContext="{Binding Session}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Documentation" Style="{StaticResource WindowHeading}" />
                    <!-- It writes a file on this machine, never to the environment. -->
                    <ContentControl Style="{StaticResource Chip}" Content="Read-only" Foreground="{DynamicResource Muted}"
                                    Margin="8,2,0,0" ToolTip="Reads the environment - nothing is written" />
                </StackPanel>
                <TextBlock Text="{Binding SolutionLabel}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SolutionLabel}" />
            </StackPanel>

            <!-- ============================================================ solutions -->
            <StackPanel Margin="18,4,18,0">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear" Height="22"
                            Command="{Binding ClearCommand}" ToolTip="Untick every solution" />
                    <TextBlock Text="Solutions" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox Height="30" Margin="0,0,0,6"
                         core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Filter solutions by name"
                         AutomationProperties.Name="Filter solutions"
                         Text="{Binding SolutionFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                <ListBox ItemsSource="{Binding ChoicesView}" Height="150"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Solutions to document">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChosen}" Margin="0,3"
                                      AutomationProperties.Name="{Binding Solution.FriendlyName}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Solution.DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <CheckBox Content="Include the patches of the ticked solutions" IsChecked="{Binding IncludePatches}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- ============================================================ options -->
            <Grid Margin="18,14,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Components" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                    <CheckBox Content="Tables - custom columns, relationships, keys" IsChecked="{Binding Options.Tables}" Margin="0,3" />
                    <CheckBox Content="Cloud flows - trigger, connectors, Mermaid diagram" IsChecked="{Binding Options.Flows}" Margin="0,3" />
                    <CheckBox Content="Environment variables (secrets redacted)" IsChecked="{Binding Options.EnvironmentVariables}" Margin="0,3"
                              ToolTip="Type, default and current value - a secret's value is never written" />
                    <CheckBox Content="Plug-in steps - message, table, stage, mode" IsChecked="{Binding Options.PluginSteps}" Margin="0,3" />
                    <CheckBox Content="Security roles - privileges on the tables" IsChecked="{Binding Options.SecurityRoles}" Margin="0,3" />
                    <CheckBox Content="Dependencies on other components" IsChecked="{Binding Options.Dependencies}" Margin="0,3"
                              ToolTip="Components the solutions need but do not hold" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Inventory - for support scoping" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                    <CheckBox Content="Processes - by category, triggers, business rules" IsChecked="{Binding Options.Processes}" Margin="0,3" />
                    <CheckBox Content="Plug-ins and custom APIs - classes, steps per table" IsChecked="{Binding Options.PluginsAndApis}" Margin="0,3" />
                    <CheckBox Content="Integrations - endpoints, connections, connectors" IsChecked="{Binding Options.Integrations}" Margin="0,3" />
                    <CheckBox Content="Data volumes - tables, columns, record counts" IsChecked="{Binding Options.DataVolumes}" Margin="0,3" />
                    <CheckBox Content="Execution volumes - runs in the last 30 days" IsChecked="{Binding Options.ExecutionVolumes}" Margin="0,3" />
                    <CheckBox Content="Add environment-wide facts" IsChecked="{Binding Options.EnvironmentWide}" Margin="0,3"
                              ToolTip="Application users, SharePoint and email, records across every table, attachments and system jobs - the environment's, not any solution's" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="18,0,18,16">
                <TextBlock Text="Output" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                <RadioButton Content="One Markdown file" IsChecked="{Binding Options.FilePerComponent, Converter={StaticResource NotBool}}" Margin="0,3" />
                <RadioButton Content="A folder with an index and one file per component - for a docs repository"
                             IsChecked="{Binding Options.FilePerComponent}" Margin="0,3" />
            </StackPanel>

            <!-- A fixed 2px row, so the dialog does not change height while it works. -->
            <Grid Height="2">
                <ProgressBar Style="{StaticResource BusyBar}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- What it writes, how far it has got, or where it wrote - beside the buttons. -->
            <Border Style="{StaticResource Footer}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="Stop" Height="30" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Export…" Height="30" Padding="16,0" Command="{Binding ExportCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
