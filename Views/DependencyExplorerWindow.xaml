<Window x:Class="PPObjectSearch.Views.DependencyExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        xmlns:vm="clr-namespace:PPObjectSearch.ViewModels"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="680" Width="1000"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Grid.Row="0" Margin="18,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <!-- Which environment this came from - collapsed when no tab was passed. -->
                    <local:EnvironmentLine DataContext="{Binding Session}"
                                           Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource WindowHeading}" ToolTip="{Binding Heading}" />
                        <ContentControl Style="{StaticResource Chip}" Content="Read-only" Foreground="{DynamicResource Muted}"
                                        Margin="8,2,0,0" ToolTip="Reads the environment - nothing is written" />
                    </StackPanel>
                </StackPanel>

                <!-- One format, so a plain button rather than an Export menu. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Copy as Mermaid" Margin="6,0,0,0" Command="{Binding CopyMermaidCommand}"
                            ToolTip="The removal impact once walked, otherwise the tree as expanded - each arrow reads 'depends on'" />
                </StackPanel>
            </Grid>

            <!-- A walk cut short at its limits, under the header. -->
            <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="18,0,18,10"
                    Visibility="{Binding Warning, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
            </Border>

            <ProgressBar Grid.Row="2" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TabControl Grid.Row="3">
                <TabItem Header="Tree">
                    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0" Padding="8"
                              AutomationProperties.Name="Dependency tree">
                        <TreeView.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}"
                                          CommandParameter="{Binding SelectedItem, ElementName=Tree}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=Tree}" />
                        </TreeView.InputBindings>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:DependencyTreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ContentControl Style="{StaticResource Chip}" Margin="8,0,0,0" Content="{Binding TypeName}"
                                                    Visibility="{Binding TypeName, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Text="{Binding ManagedLabel}"
                                               Foreground="{DynamicResource Muted}" />
                                    <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Text="outside this solution"
                                               Foreground="{DynamicResource Amber}"
                                               Visibility="{Binding IsOutside, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </TabItem>

                <TabItem Header="Removal impact">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12,16,10">
                            <Button Style="{StaticResource PrimaryButton}" Content="What breaks if I remove this?" Height="32" Padding="14,0"
                                    Command="{Binding ImpactCommand}"
                                    ToolTip="Follows what depends on this, and what depends on those, up to four levels" />
                            <Button Content="Stop" Height="32" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="ImpactGrid" ItemsSource="{Binding Impact}" IsReadOnly="True"
                                      AutomationProperties.Name="Components that would be affected"
                                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                      Visibility="{Binding HasImpact, Converter={StaticResource BoolToVis}}">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}"
                                                  CommandParameter="{Binding SelectedItem, ElementName=ImpactGrid}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Component" Width="*" Binding="{Binding Name}" HeaderStyle="{StaticResource FirstHeader}"
                                                        ElementStyle="{StaticResource CellFirst}" />
                                    <DataGridTextColumn Header="Type" Width="180" Binding="{Binding TypeName}" ElementStyle="{StaticResource CellMuted}" />
                                    <DataGridTextColumn Header="Level" Width="60" Binding="{Binding Level}" />
                                    <DataGridTextColumn Header="Where" Width="170" Binding="{Binding Where}" />
                                    <DataGridTextColumn Header="State" Width="100" Binding="{Binding ManagedLabel}" ElementStyle="{StaticResource CellMuted}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Nothing to list: not walked yet, or nothing depends on this. -->
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                    Visibility="{Binding HasImpact, Converter={StaticResource NotBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                                    <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="4" Style="{StaticResource StatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusLine}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding StatusLine}" />
                    <TextBlock Grid.Column="1" Text="{Binding ImpactCountLabel}" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
