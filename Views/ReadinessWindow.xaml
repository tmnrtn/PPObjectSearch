<Window x:Class="PPObjectSearch.Views.ReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PPObjectSearch.Services"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        Title="Readiness check"
        Style="{StaticResource AppWindow}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Grid.Row="0" Margin="18,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <!-- Both environments, source → target. -->
                    <StackPanel Orientation="Horizontal">
                        <local:EnvironmentLine DataContext="{Binding Source}"
                                               Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}" />
                        <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource Muted}" Margin="9,0,9,4"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Target, Converter={StaticResource EmptyToCollapsed}}" />
                        <local:EnvironmentLine DataContext="{Binding Target}"
                                               Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Readiness check" Style="{StaticResource WindowHeading}" />
                        <ContentControl Style="{StaticResource Chip}" Content="Read-only" Foreground="{DynamicResource Muted}"
                                        Margin="8,2,0,0" ToolTip="Reads both environments - nothing is written" />
                    </StackPanel>
                </StackPanel>

                <!-- Check again, then export. The pickers are in the row below - they do not fit here. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Stop" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button AutomationProperties.Name="Check again" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                            Command="{Binding RunCommand}" ToolTip="Check again" />
                    <Button Content="Export Markdown…" Margin="6,0,0,0" Command="{Binding ExportCommand}"
                            ToolTip="The report as Markdown, for a pull request or a change ticket" />
                </StackPanel>
            </Grid>

            <!-- What to check: a solution, where it comes from, where it is going. -->
            <WrapPanel Grid.Row="1" Margin="18,0,18,0">
                <ComboBox Style="{StaticResource EnvPicker}" Width="240" Margin="0,0,8,6"
                          core:Ui.InlineLabel="From"
                          AutomationProperties.Name="Source environment"
                          ItemsSource="{Binding Sessions}" SelectedItem="{Binding Source}" />

                <ComboBox Width="280" Height="32" Margin="0,0,8,6" Padding="7,0"
                          core:Ui.InlineLabel="Solution" core:Ui.Placeholder="Choose a solution"
                          AutomationProperties.Name="Solution"
                          ItemsSource="{Binding Solutions}" SelectedItem="{Binding Solution}"
                          DisplayMemberPath="DisplayLabel" />

                <ComboBox Style="{StaticResource EnvPicker}" Width="240" Margin="0,0,8,6"
                          core:Ui.InlineLabel="To"
                          AutomationProperties.Name="Target environment"
                          ItemsSource="{Binding Sessions}" SelectedItem="{Binding Target}" />

                <Button Style="{StaticResource PrimaryButton}" Content="Check" Height="32" Padding="16,0" Margin="0,0,8,6"
                        Command="{Binding RunCommand}"
                        ToolTip="Reads both environments - nothing is written" />
            </WrapPanel>

            <!-- Checks that could not run, so their silence is not read as a pass. -->
            <Border Grid.Row="2" Style="{StaticResource Banner}" Margin="18,4,18,0"
                    Visibility="{Binding HasNotChecked, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NotChecked}" TextWrapping="Wrap" />
            </Border>

            <ProgressBar Grid.Row="3" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

            <!-- ============================================================ findings -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <DataGrid ItemsSource="{Binding Findings}"
                          SelectedItem="{Binding SelectedFinding}"
                          IsReadOnly="True"
                          AutomationProperties.Name="Readiness findings"
                          BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                          Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVis}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenFindingCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding OpenFindingCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Severity" Width="104" SortMemberPath="Severity"
                                                HeaderStyle="{StaticResource FirstHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Margin="16,0,8,0" Content="{Binding SeverityLabel}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static services:ReadinessSeverity.Blocker}">
                                                        <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static services:ReadinessSeverity.Warning}">
                                                        <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Area" Width="150" Binding="{Binding Area}" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTextColumn Header="Component" Width="260" Binding="{Binding Component}" ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="Finding" Width="*" Binding="{Binding Message}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="ToolTip" Value="{Binding Message}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Nothing to list: say why, and what to change. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="5" Style="{StaticResource StatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusLine}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding StatusLine}" />
                    <TextBlock Grid.Column="1" Text="{Binding FindingCountLabel}" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
