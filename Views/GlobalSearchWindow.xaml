<Window x:Class="PPObjectSearch.Views.GlobalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search all environments"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="SEARCH EVERY CONNECTED ENVIRONMENT" Style="{StaticResource Label}" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Space separated keywords. Environment names match too, so you can narrow to one." />
                </StackPanel>

                <Button Grid.Column="1" Content="Export CSV" Margin="0,16,0,0" VerticalAlignment="Bottom"
                        MinWidth="100" Command="{Binding ExportCommand}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding RowsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF0F3"
                  Background="{StaticResource Surface}"
                  BorderThickness="0"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style TargetType="TextBlock" x:Key="Cell">
                    <Setter Property="Margin" Value="8,6" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <Style TargetType="TextBlock" x:Key="MutedCell" BasedOn="{StaticResource Cell}">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="190"
                                    ElementStyle="{StaticResource Cell}" />

                <DataGridTemplateColumn Header="Name" Width="360" SortMemberPath="Item.PrimaryLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="8,6" TextTrimming="CharacterEllipsis">
                                <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="{Binding Item.MakerUrl}">
                                    <Hyperlink.Style>
                                        <Style TargetType="Hyperlink">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter Property="TextDecorations" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Item.MakerUrl}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Hyperlink.Style>
                                    <Run Text="{Binding Item.PrimaryLabel, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Object type" Binding="{Binding Item.ComponentTypeName}" Width="170"
                                    ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Sub type" Binding="{Binding Item.SubType}" Width="150"
                                    ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="State" Binding="{Binding Item.ManagedLabel}" Width="110"
                                    ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Solution" Binding="{Binding Solution}" Width="160"
                                    ElementStyle="{StaticResource MutedCell}" />
                <DataGridTextColumn Header="Modified"
                                    Binding="{Binding Item.ModifiedOn, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="140" ElementStyle="{StaticResource MutedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" />
        </Border>
    </Grid>
</Window>
