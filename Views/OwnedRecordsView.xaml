<local:ScreenView x:Class="PPObjectSearch.Views.OwnedRecordsView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:core="clr-namespace:PPObjectSearch.Core"
                  xmlns:local="clr-namespace:PPObjectSearch.Views"
                  ScreenTitle="{Binding Title}"
                  WindowHeight="640"
                  WindowWidth="860"
                  WindowMinHeight="400"
                  WindowMinWidth="620">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the environment, then whose records these are, with Stop, Refresh and Export on
                 the right as on every screen. Read-only throughout. -->
            <Grid Grid.Row="0" Margin="18,12,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <local:EnvironmentLine DataContext="{Binding Session}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Owned records" Style="{StaticResource WindowHeading}" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource Chip}" Content="Read-only" Margin="8,2,0,0" VerticalAlignment="Center"
                                    ToolTip="Counts rows - nothing is changed" />
                </StackPanel>
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
                    <Run Text="{Binding OwnerKind, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding OwnerName, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text}" />
                    <Run Text="·" Foreground="{DynamicResource Faint}" />
                    <Run Text="Rows it owns itself - not rows owned by a team it is in. Only rows your account can read are counted." />
                </TextBlock>
            </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Stop" Command="{Binding CancelCommand}" Margin="6,0,0,0"
                            ToolTip="Stop counting"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button AutomationProperties.Name="Refresh" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                            Command="{Binding RunCommand}" ToolTip="Refresh - count again" />
                    <Button Margin="6,0,0,0" core:Ui.OpensMenu="True" ToolTip="Every table listed, with its count - or why it could not be counted">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="7,1,0,0"
                                       Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Style="{StaticResource MenuGroupHeader}" Header="Save" />
                                <MenuItem Header="CSV: every table counted…" Command="{Binding ExportCsvCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- What was found. -->
            <TextBlock Grid.Row="1" Margin="18,6,18,10" Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />

            <ProgressBar Grid.Row="2" Style="{StaticResource BusyBar}"
                         AutomationProperties.Name="Counting"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Single"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,6,0,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Table" Width="*" MinWidth="220" SortMemberPath="Table.Label"
                                            HeaderStyle="{StaticResource FirstHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CellFirst}" ToolTip="{Binding Table.LogicalName}">
                                    <Run Text="{Binding Table.DisplayName, Mode=OneWay}" />
                                    <Run Text="{Binding Table.LogicalName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                         Foreground="{DynamicResource Faint}" />
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Rows owned" Width="130" SortMemberPath="Rows" HeaderStyle="{StaticResource RightHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                            <Setter Property="Text" Value="{Binding Rows, StringFormat={}{0:N0}}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <!-- Not a zero: unknown. The reason is in the column beside it. -->
                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                    <Setter Property="Text" Value="Could not count" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                    <Setter Property="ToolTip" Value="{Binding Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- The rows themselves, or - where they could not be counted - why, in words rather
                         than a tooltip. -->
                    <DataGridTemplateColumn Header="Rows" Width="*" MinWidth="200" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Style="{StaticResource LinkButton}" Content="Show rows →" Height="20" Padding="2,0" Margin="12,0,0,0"
                                            HorizontalAlignment="Left"
                                            ToolTip="Open this table in Table data, filtered to these rows"
                                            Command="{Binding DataContext.ShowRowsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding Failed, Converter={StaticResource NotBoolToVis}}" />
                                    <TextBlock Style="{StaticResource CellMuted}" Text="{Binding Error}" ToolTip="{Binding Error}"
                                               Visibility="{Binding Failed, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Style="{StaticResource EmptyHint}" Text="Nothing counted yet."
                       Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

            <Border Grid.Row="4" Style="{StaticResource StatusBar}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource StatusCount}" Text="{Binding Rows.Count, StringFormat={}{0:N0} tables}" />
                    <Grid>
                        <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Style="{StaticResource StatusText}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource NotBoolToVis}}" />
                        <TextBlock Text="{Binding Progress}" Style="{StaticResource StatusText}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</local:ScreenView>
