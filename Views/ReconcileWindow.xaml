<Window x:Class="PPObjectSearch.Views.ReconcileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        xmlns:svc="clr-namespace:PPObjectSearch.Services"
        Title="{Binding Title}"
        Style="{StaticResource DialogWindow}"
        Height="700" Width="1020"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ where, and whether -->
            <StackPanel Grid.Row="0" Margin="18,16,18,14">
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="From" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EnvBar}" Height="14" Margin="0,0,7,0" Tag="{Binding SourceSku}" />
                            <TextBlock Text="{Binding SourceName}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="11" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Muted}" Margin="14,0,14,3" />

                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Writing to" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EnvBar}" Height="18" Margin="0,0,7,0" Tag="{Binding TargetSku}" />
                            <TextBlock Text="{Binding TargetName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource EnvTypeBadge}" Margin="8,1,0,0" Tag="{Binding TargetSku}"
                                            Content="{Binding TargetSku, Converter={StaticResource SkuBadge}}"
                                            ToolTip="{Binding TargetDescription}" />
                            <TextBlock Text="{Binding TargetHost}" Foreground="{DynamicResource Muted}" Margin="8,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Margin="0,12,0,0" CornerRadius="4" Padding="10,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusCircle}">
                                    <Setter Property="Background" Value="{DynamicResource Green}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Surface}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="FontSize" Value="9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                                                <Setter Property="Text" Value="!" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run FontWeight="SemiBold">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="Writes permitted." />
                                        <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter Property="Text" Value="Writes blocked." />
                                                <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                            <Run Text="{Binding GuardMessage, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============================================================ what to do -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,14,18,14">
                <StackPanel>
                    <Grid IsEnabled="{Binding CanEditActions}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Style="{StaticResource ActionCard}" IsChecked="{Binding Create}">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Create" FontSize="13" FontWeight="SemiBold" />
                                    <Run Text="{Binding AvailableCreates, Mode=OneWay, StringFormat=N0}" FontSize="13" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardText}" Text="Rows missing from the target, reusing the source id" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Grid.Column="2" Style="{StaticResource ActionCard}" IsChecked="{Binding Update}">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Update" FontSize="13" FontWeight="SemiBold" />
                                    <Run Text="{Binding AvailableUpdates, Mode=OneWay, StringFormat=N0}" FontSize="13" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardText}" Text="Rows whose values differ; only differing columns" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Grid.Column="4" Style="{StaticResource ActionCard}" Tag="Danger"
                                  Background="{DynamicResource Red}" IsChecked="{Binding Delete}">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Delete" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Red}" />
                                    <Run Text="{Binding AvailableDeletes, Mode=OneWay, StringFormat=N0}" FontSize="13" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardText}" Text="Rows only in the target. Off by default." />
                            </StackPanel>
                        </CheckBox>
                    </Grid>

                    <Expander Margin="0,10,0,0" Header="{Binding ColumnsSummary}"
                              IsEnabled="{Binding CanEditActions}"
                              AutomationProperties.Name="Columns written by this run"
                              Visibility="{Binding HasColumns, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="4,6,0,0">
                            <TextBlock Style="{StaticResource CardText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Untick a column to leave it out of this run only. The saved configuration is not changed, and key columns are always written." />
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsIncluded}"
                                                      Margin="0,2,16,2" ToolTip="{Binding Column.TypeLabel}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>

                    <Border Margin="0,10,0,0" Padding="12,9" Background="{DynamicResource RedSoft}" CornerRadius="4"
                            Visibility="{Binding HasDeletes, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DeleteImpactText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding HasDeleteImpact, Converter={StaticResource BoolToVis}}" />
                            <CheckBox Style="{StaticResource DangerCheckBox}" IsChecked="{Binding DeleteAcknowledged}"
                                      IsEnabled="{Binding CanAcknowledgeDelete}" VerticalContentAlignment="Center">
                                <TextBlock Text="{Binding DeleteAcknowledgement}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================================ rows -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Rows}"
                      IsReadOnly="True"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Action" Width="96" SortMemberPath="ActionLabel"
                                            HeaderStyle="{StaticResource FirstHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Margin="16,0,8,0" Content="{Binding Action}" ToolTip="{Binding ActionLabel}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource PillAmber}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static svc:ReconcileAction.Create}">
                                                    <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static svc:ReconcileAction.Delete}">
                                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="140"
                                        ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="110"
                                        ElementStyle="{StaticResource CellMono}" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"
                                        ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="What changes" Binding="{Binding Detail}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}">
                                <Setter Property="ToolTip" Value="{Binding Detail}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultLabel}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellFaint}">
                                <Setter Property="ToolTip" Value="{Binding Result}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ============================================================ footer -->
            <Border Grid.Row="3" Style="{StaticResource Footer}" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding FooterText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"
                               ToolTip="{Binding FooterText}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="Export plan…" Height="30" Margin="0,0,8,0"
                                Command="{Binding ExportPlanCommand}"
                                IsEnabled="{Binding IsNotRunning}"
                                ToolTip="Save every planned change as CSV, for review or a change ticket" />

                        <Button Content="Open run log" Height="30" Margin="0,0,8,0"
                                Command="{Binding OpenRunLogCommand}"
                                ToolTip="Each write is recorded - with the row as it was - under %LOCALAPPDATA%\PPObjectSearch\writes" />

                        <Button Content="Undo run" Height="30" Margin="0,0,8,0"
                                Command="{Binding UndoCommand}"
                                ToolTip="Put back what this run changed, from the copies kept before each write"
                                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Stop" Height="30" Margin="0,0,8,0"
                                Command="{Binding CancelRunCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Retry failed" Height="30" Margin="0,0,8,0"
                                Command="{Binding RetryFailedCommand}"
                                ToolTip="Write the rows that failed again - for example after throttling or a lost connection"
                                Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Close" Height="30" Click="Close_Click" IsEnabled="{Binding IsNotRunning}" />

                        <Button Height="30" Margin="8,0,0,0" Content="{Binding ApplyLabel}"
                                Command="{Binding ApplyCommand}"
                                Visibility="{Binding HasRun, Converter={StaticResource NotBoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructiveApply}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBg}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
