<local:ScreenView x:Class="PPObjectSearch.Views.SecurityLookupView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:core="clr-namespace:PPObjectSearch.Core"
                  xmlns:local="clr-namespace:PPObjectSearch.Views"
                  ScreenTitle="{Binding Title}"
                  WindowHeight="720"
                  WindowWidth="1180">

    <local:ScreenView.Resources>
        <!-- A matrix cell: the depth as a pill, with the roles that grant it on hover. -->
        <DataTemplate x:Key="EffectiveCellTemplate">
            <ContentControl Style="{StaticResource DepthPill}" Tag="{Binding Depth}"
                            Content="{Binding Depth, Converter={StaticResource DepthShort}}" ToolTip="{Binding GrantedByLabel}" />
        </DataTemplate>

        <!-- DataGrid columns are outside the visual tree; this carries the view model to their headers. -->
        <core:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <!-- A compared role's column header: the environment's colour, then "{role} · {env}". -->
        <DataTemplate x:Key="RoleColumnHeader">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource EnvBar}" Height="12" Margin="0,0,6,0" Tag="{Binding Sku}" />
                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </local:ScreenView.Resources>

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Grid.Row="0" Margin="18,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <local:EnvironmentLine DataContext="{Binding Session}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Security lookup" Style="{StaticResource WindowHeading}" />
                        <ContentControl Style="{StaticResource Chip}" Content="Read-only" Foreground="{DynamicResource Muted}"
                                        Margin="8,2,0,0" ToolTip="Reads the environment - nothing is written" />
                    </StackPanel>
                </StackPanel>

                <!-- Look up again, then export. The inputs belong to each tab, below. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Stop" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button AutomationProperties.Name="Look up again" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                            Command="{Binding RunCommand}" ToolTip="Look up again" />
                    <Button Content="Export CSV…" Margin="6,0,0,0" Command="{Binding ExportCommand}"
                            ToolTip="Export what this tab shows" />
                </StackPanel>
            </Grid>

            <!-- Warnings - the pickers' lists could not be read - under the header. -->
            <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="18,0,18,10"
                    Visibility="{Binding Notes, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
            </Border>

            <ProgressBar Grid.Row="2" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TabControl Grid.Row="3" SelectedIndex="{Binding TabIndex}">

                <!-- ============================================================ who can -->
                <TabItem Header="Who can…">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                            <ComboBox Width="140" Height="32" Margin="0,0,8,6" core:Ui.InlineLabel="Do"
                                      AutomationProperties.Name="Privilege"
                                      ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" />
                            <ComboBox Width="320" Height="32" Margin="0,0,8,6" IsEditable="True" core:Ui.InlineLabel="Table"
                                      core:Ui.Placeholder="logical name, e.g. contoso_invoice"
                                      AutomationProperties.Name="Table" TextSearch.TextPath="LogicalName"
                                      ItemsSource="{Binding Tables}"
                                      Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Margin="0,0,8,0"
                                                       Visibility="{Binding DisplayName, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding LogicalName}" Style="{StaticResource Mono}" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{StaticResource PrimaryButton}" Content="Look up" Height="32" Padding="16,0" Margin="0,0,8,6"
                                    Command="{Binding RunCommand}" />
                        </WrapPanel>
                        <Grid>
                            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DataGrid ItemsSource="{Binding Grants}" IsReadOnly="True" AutomationProperties.Name="Roles that grant it"
                                          BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Role" Width="*" Binding="{Binding Role}" HeaderStyle="{StaticResource FirstHeader}"
                                                            ElementStyle="{StaticResource CellFirst}" />
                                        <DataGridTemplateColumn Header="Reach" Width="80" SortMemberPath="Depth">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><ContentPresenter Content="{Binding Depth}" ContentTemplate="{StaticResource DepthCell}" ToolTip="{Binding DepthLabel}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid Grid.Column="1" ItemsSource="{Binding Holders}" IsReadOnly="True" AutomationProperties.Name="Who holds it"
                                          BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Width="220" Binding="{Binding Name}" HeaderStyle="{StaticResource FirstHeader}"
                                                            ElementStyle="{StaticResource CellFirst}" />
                                        <DataGridTextColumn Header="Kind" Width="70" Binding="{Binding Kind}" />
                                        <DataGridTemplateColumn Header="Reach" Width="80" SortMemberPath="Depth">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><ContentPresenter Content="{Binding Depth}" ContentTemplate="{StaticResource DepthCell}" ToolTip="{Binding DepthLabel}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Via" Width="*" Binding="{Binding Via}" ElementStyle="{StaticResource CellMuted}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <!-- Nothing to list: say why, and what to change. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ============================================================ effective access -->
                <TabItem Header="Effective access">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                            <ComboBox Width="360" Height="32" Margin="0,0,8,6" IsEditable="True" IsTextSearchEnabled="True"
                                      core:Ui.InlineLabel="User" AutomationProperties.Name="User"
                                      ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="FullName" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Show" Height="32" Padding="16,0" Margin="0,0,8,6"
                                    Command="{Binding RunCommand}"
                                    ToolTip="The widest depth across every role the user holds, directly and through their teams" />
                            <ContentControl Style="{StaticResource ReachKey}" Margin="8,0,0,6" />
                        </WrapPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding EffectiveRows}" IsReadOnly="True" AutomationProperties.Name="Effective privileges"
                                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Table" Width="220" Binding="{Binding Table}" HeaderStyle="{StaticResource FirstHeader}"
                                                        ElementStyle="{StaticResource CellFirst}" />
                                    <DataGridTemplateColumn Header="Create" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Create}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Read" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Read}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Write" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Write}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Delete" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Delete}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Append" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Append}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Append to" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding AppendTo}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Assign" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Assign}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Share" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentPresenter Content="{Binding Share}" ContentTemplate="{StaticResource EffectiveCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Nothing to list: say why, and what to change. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ============================================================ secured column -->
                <TabItem Header="Secured column">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                            <ComboBox Width="300" Height="32" Margin="0,0,8,6" IsEditable="True" core:Ui.InlineLabel="Table"
                                      AutomationProperties.Name="Table" TextSearch.TextPath="LogicalName"
                                      ItemsSource="{Binding Tables}"
                                      Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Margin="0,0,8,0"
                                                       Visibility="{Binding DisplayName, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding LogicalName}" Style="{StaticResource Mono}" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- The table's columns, secured ones first and tagged; any name can still be typed. -->
                            <ComboBox Width="300" Height="32" Margin="0,0,8,6" IsEditable="True" core:Ui.InlineLabel="Column"
                                      AutomationProperties.Name="Column" TextSearch.TextPath="LogicalName"
                                      ItemsSource="{Binding Columns}"
                                      Text="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Margin="0,0,8,0"
                                                       Visibility="{Binding DisplayName, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding LogicalName}" Style="{StaticResource Mono}" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                            <ContentControl Style="{StaticResource ChipAmber}" Content="Secured" FontSize="10" Margin="8,0,0,0"
                                                            Visibility="{Binding IsSecured, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{StaticResource PrimaryButton}" Content="Look up" Height="32" Padding="16,0" Margin="0,0,8,6"
                                    Command="{Binding RunCommand}" />
                        </WrapPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding FieldGrants}" IsReadOnly="True" AutomationProperties.Name="Field security profiles"
                                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Profile" Width="240" Binding="{Binding ProfileName}" HeaderStyle="{StaticResource FirstHeader}"
                                                        ElementStyle="{StaticResource CellFirst}" />
                                    <DataGridTextColumn Header="Read" Width="60" SortMemberPath="CanRead" Binding="{Binding CanRead, Mode=OneWay, Converter={StaticResource YesNo}, ConverterParameter=dash}" ElementStyle="{StaticResource Cell}" />
                                    <DataGridTextColumn Header="Create" Width="60" SortMemberPath="CanCreate" Binding="{Binding CanCreate, Mode=OneWay, Converter={StaticResource YesNo}, ConverterParameter=dash}" ElementStyle="{StaticResource Cell}" />
                                    <DataGridTextColumn Header="Update" Width="60" SortMemberPath="CanUpdate" Binding="{Binding CanUpdate, Mode=OneWay, Converter={StaticResource YesNo}, ConverterParameter=dash}" ElementStyle="{StaticResource Cell}" />
                                    <DataGridTextColumn Header="Users" Width="*" Binding="{Binding UsersLabel}" />
                                    <DataGridTextColumn Header="Teams" Width="*" Binding="{Binding TeamsLabel}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Nothing to list: say why, and what to change. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ============================================================ compare roles -->
                <TabItem Header="Compare roles">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                            <ComboBox Style="{StaticResource EnvPicker}" Width="200" Margin="0,0,8,6" core:Ui.InlineLabel="In"
                                      AutomationProperties.Name="Left environment"
                                      ItemsSource="{Binding Sessions}" SelectedItem="{Binding LeftSession}" />
                            <ComboBox Width="260" Height="32" Margin="0,0,16,6" IsEditable="True" core:Ui.InlineLabel="Role"
                                      AutomationProperties.Name="Left role"
                                      ItemsSource="{Binding LeftRoles}" SelectedItem="{Binding LeftRole}" DisplayMemberPath="Name" />
                            <ComboBox Style="{StaticResource EnvPicker}" Width="200" Margin="0,0,8,6" core:Ui.InlineLabel="In"
                                      AutomationProperties.Name="Right environment"
                                      ItemsSource="{Binding Sessions}" SelectedItem="{Binding RightSession}" />
                            <ComboBox Width="260" Height="32" Margin="0,0,8,6" IsEditable="True" core:Ui.InlineLabel="Role"
                                      AutomationProperties.Name="Right role"
                                      ItemsSource="{Binding RightRoles}" SelectedItem="{Binding RightRole}" DisplayMemberPath="Name" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Compare" Height="32" Padding="16,0" Margin="0,0,8,6"
                                    Command="{Binding RunCommand}"
                                    ToolTip="Two roles side by side - or the same role in two environments" />
                            <ContentControl Style="{StaticResource ReachKey}" Margin="8,0,0,6" />
                        </WrapPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding Differences}" IsReadOnly="True" AutomationProperties.Name="Privileges that differ"
                                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource NotBoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Table" Width="240" Binding="{Binding Table}" HeaderStyle="{StaticResource FirstHeader}"
                                                        ElementStyle="{StaticResource CellFirst}" />
                                    <DataGridTextColumn Header="Privilege" Width="200" Binding="{Binding Action}" />
                                    <DataGridTemplateColumn Width="*" SortMemberPath="Left" Header="{Binding Data.LeftColumn, Source={StaticResource Proxy}}"
                                                            HeaderTemplate="{StaticResource RoleColumnHeader}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><ContentPresenter Content="{Binding Left}" ContentTemplate="{StaticResource DepthCell}" ToolTip="{Binding LeftLabel}" HorizontalAlignment="Left" Margin="12,0,0,0" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" SortMemberPath="Right" Header="{Binding Data.RightColumn, Source={StaticResource Proxy}}"
                                                            HeaderTemplate="{StaticResource RoleColumnHeader}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><ContentPresenter Content="{Binding Right}" ContentTemplate="{StaticResource DepthCell}" ToolTip="{Binding RightLabel}" HorizontalAlignment="Left" Margin="12,0,0,0" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Nothing to list: say why, and what to change. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="4" Style="{StaticResource StatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusLine}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding StatusLine}" />
                    <TextBlock Grid.Column="1" Text="{Binding ResultCountLabel}" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ScreenView>
