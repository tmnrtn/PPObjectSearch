<UserControl x:Class="PPObjectSearch.Views.EnvironmentSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PPObjectSearch.Core"
             Background="Transparent">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="U" Modifiers="Ctrl+Shift" Command="{Binding ContentSearchCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Detail pane key/value rows. -->
        <Style TargetType="TextBlock" x:Key="DetailKey">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,0,8,7" />
        </Style>
        <Style TargetType="TextBlock" x:Key="DetailValue">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The search dropdown: a heading, and rows that never take focus from the box. -->
        <Style TargetType="TextBlock" x:Key="DropdownHeading">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="Margin" Value="10,8,10,3" />
        </Style>
        <Style TargetType="Button" x:Key="DropdownRow">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle x:Name="Bar" Width="2" HorizontalAlignment="Left" Fill="{DynamicResource Accent}"
                                       Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Selected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ header -->
        <Grid Grid.Row="0" Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource EnvTypeBadge}" Margin="8,1,0,0"
                                    Tag="{Binding EnvironmentSku}"
                                    Content="{Binding EnvironmentSku, Converter={StaticResource SkuBadge}}"
                                    ToolTip="{Binding EnvironmentTypeDescription}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                    <!-- As every other window's environment line shows it. -->
                    <ContentControl Style="{StaticResource ChipAmber}" Margin="8,1,0,0" Content="Writes allowed" FontWeight="SemiBold"
                                    FontSize="10" VerticalAlignment="Center" ToolTip="Writes allowed. Every change is still previewed and confirmed."
                                    Visibility="{Binding IsWriteAllowlisted, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding EnvironmentUrl}" FontSize="11" Foreground="{DynamicResource Muted}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Enter an environment URL to connect." FontSize="11"
                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                           Visibility="{Binding IsConnected, Converter={StaticResource NotBoolToVis}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Not connected: URL + Connect. -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsConnected, Converter={StaticResource NotBoolToVis}}">
                    <TextBox x:Name="EnvironmentBox" Width="340"
                             core:Ui.Placeholder="https://contoso.crm11.dynamics.com"
                             Text="{Binding EnvironmentUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. https://contoso.crm11.dynamics.com">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ConnectCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource PrimaryButton}" Content="Connect" Margin="6,0,0,0"
                            Command="{Binding ConnectCommand}" />
                </StackPanel>

                <!-- Connected: solution + refresh. -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <ComboBox MinWidth="250" MaxWidth="360"
                              core:Ui.InlineLabel="Solution"
                              ItemsSource="{Binding SolutionsView}"
                              SelectedItem="{Binding SelectedSolution}"
                              Text="{Binding SolutionSearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              DisplayMemberPath="DisplayLabel"
                              FontWeight="SemiBold"
                              IsEnabled="{Binding IsSolutionPickerEnabled}"
                              DropDownClosed="SolutionPicker_SearchEnded"
                              LostKeyboardFocus="SolutionPicker_LostKeyboardFocus"
                              ToolTip="Defaults to this environment's default solution. Type to narrow the list by name, unique name or publisher.">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="FontWeight" Value="Normal" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!-- What can be done with the solution picked: the shell's view model rides in Tag for Readiness. -->
                    <Button Margin="12,0,0,0" Padding="9,0" core:Ui.OpensMenu="True"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding IsSolutionPickerEnabled}"
                            ToolTip="Document, deployment settings and readiness check for this solution">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Solution tools" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="7,1,0,0"
                                       Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Document solutions…" Command="{Binding DocumentSolutionCommand}"
                                          ToolTip="Write a readable inventory of the selected solution, and any others you tick, as Markdown - tables, flows with diagrams, environment variables, plug-in steps, roles and dependencies, and a support-scoping summary of their processes, plug-ins, integrations, data and run volumes" />
                                <MenuItem Header="Deployment settings…" Command="{Binding ExportDeploymentSettingsCommand}"
                                          ToolTip="Write the settings file pac solution import --settings-file takes for the selected solution: a value for each environment variable and a connection for each connection reference - this environment's, or blank as a template." />
                                <MenuItem Header="Readiness check…" InputGestureText="Ctrl+Shift+R"
                                          Command="{Binding PlacementTarget.Tag.ReadinessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}"
                                          ToolTip="Will the selected solution import cleanly into another environment, and work there?" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button AutomationProperties.Name="Refresh (F5) - reads the solution list and the solution's objects again, bypassing the cache." Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="12,0,0,0"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh (F5) - reads the solution list and the solution's objects again, bypassing the cache." />
                </StackPanel>

                <!-- Account -->
                <Button Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="6,0,8,0"
                        core:Ui.OpensMenu="True"
                        ToolTip="{Binding TenantId, StringFormat=Tenant: {0}}"
                        Visibility="{Binding AccountName, Converter={StaticResource EmptyToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border2}" BorderThickness="1">
                            <TextBlock Text="{Binding AccountInitials}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding AccountName}" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="8,1,0,0"
                                   Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Opened="AccountMenu_Opened">
                            <!-- Where this environment's links and sign-ins open - the sidebar's menu, here too. -->
                            <MenuItem Header="Open links in" ItemsSource="{Binding BrowserProfileOptions}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.SetBrowserProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="App Insights resource…" Command="{Binding ChooseAppInsightsCommand}"
                                      ToolTip="Choose the Application Insights resource this environment's Dataverse data export writes to." />
                            <MenuItem Header="Check Azure access…" Command="{Binding CheckAzureAccessCommand}"
                                      ToolTip="Tries the Azure APIs the App Insights features use, as this tab's account, and says what worked." />
                            <Separator />
                            <MenuItem Header="Switch account…" Command="{Binding SwitchAccountCommand}"
                                      ToolTip="Sign this tab in with a different account or tenant." />
                            <MenuItem Header="Copy tenant id" Command="{Binding CopyTenantIdCommand}" />
                            <Separator />
                            <MenuItem Header="Disconnect this tab" Command="{Binding DisconnectCommand}"
                                      ToolTip="Drops this tab's connection and loaded objects. Sign out all, in the sidebar, forgets the accounts too." />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================ toolbar -->
        <Grid Grid.Row="1" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Esc, ↑↓ and Enter are handled in code: they drive the dropdown first. -->
                <TextBox x:Name="SearchBox" Width="280" Margin="0,0,6,0"
                         core:Ui.Icon="&#xE721;" core:Ui.KeyHint="Esc" core:Ui.Placeholder="Search"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                         LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                         PreviewMouseLeftButtonUp="SearchBox_PreviewMouseLeftButtonUp"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="Space separated keywords; every keyword must match the name, display name, schema name, type, owner or id." />

                <!-- Search inside definitions, saved searches and recent objects, under the box. -->
                <Popup x:Name="SearchDropdown" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                       IsOpen="{Binding SearchDropdownOpen}" StaysOpen="True" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="None">
                    <Grid Margin="0,4,10,10">
                        <Border Width="380" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border2}"
                                BorderThickness="1" CornerRadius="6" Padding="0,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- First and highlighted: Enter searches inside definitions for the words typed. -->
                                <Button Style="{StaticResource DropdownRow}" Height="34"
                                        DataContext="{Binding ContentSuggestion}"
                                        Command="{Binding DataContext.RunSuggestionCommand, ElementName=SearchBox}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Search inside definitions">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="11"
                                                   Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   DataContext="{Binding DataContext, ElementName=SearchBox}">
                                            <Run Text="{Binding SearchInsideLabel, Mode=OneWay}" /><Run
                                                 Text="{Binding SearchInsideTerm, Mode=OneWay}" FontWeight="SemiBold" /><Run
                                                 Text="  flows, scripts, forms, views…" FontSize="11" Foreground="{DynamicResource Muted}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="Ctrl+Shift+U" Style="{StaticResource Shortcut}" Margin="8,0,0,0" />
                                    </Grid>
                                </Button>

                                <StackPanel Visibility="{Binding HasSavedSearches, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="SAVED SEARCHES" Style="{StaticResource DropdownHeading}" />
                                    <ItemsControl ItemsSource="{Binding SavedSuggestions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DropdownRow}"
                                                        Command="{Binding DataContext.RunSuggestionCommand, ElementName=SearchBox}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <Grid Background="Transparent">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run
                                                                 Text="{Binding Detail, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter='  '}"
                                                                 FontSize="11" Foreground="{DynamicResource Muted}" />
                                                        </TextBlock>
                                                        <!-- Shown on hover: rename or delete this search. -->
                                                        <Button Grid.Column="1" Width="22" Height="20" Padding="0" Margin="6,0,0,0"
                                                                Focusable="False" Content="⋯" Foreground="{DynamicResource Faint}"
                                                                AutomationProperties.Name="Rename or delete this saved search"
                                                                ToolTip="Rename or delete"
                                                                Tag="{Binding DataContext, ElementName=SearchBox}"
                                                                core:Ui.OpensMenu="True">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Setter Property="Opacity" Value="0" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Rename…"
                                                                              Command="{Binding PlacementTarget.Tag.RenameSavedSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Payload}" />
                                                                    <MenuItem Header="Delete"
                                                                              Command="{Binding PlacementTarget.Tag.DeleteSavedSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Payload}" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasRecentObjects, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="RECENT" Style="{StaticResource DropdownHeading}" />
                                    <ItemsControl ItemsSource="{Binding RecentSuggestions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DropdownRow}"
                                                        Command="{Binding DataContext.RunSuggestionCommand, ElementName=SearchBox}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                        <Run Text="{Binding Title, Mode=OneWay}" /><Run
                                                             Text="{Binding Detail, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter='  '}"
                                                             FontSize="11" Foreground="{DynamicResource Muted}" />
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="4,4,10,0">
                                    <Grid>
                                        <Button Style="{StaticResource LinkButton}" Content="Save this search…" FontSize="11" Height="22"
                                                HorizontalAlignment="Left" Focusable="False"
                                                Command="{Binding SaveSearchCommand}"
                                                ToolTip="Name this search - its words and filters - so it can be picked again" />
                                        <TextBlock Text="↑↓ Enter" FontSize="11" Foreground="{DynamicResource Faint}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>

                <ComboBox MinWidth="120" MaxWidth="260" Margin="0,0,6,0" Padding="7,0"
                          core:Ui.InlineLabel="Type" core:Ui.Placeholder="All types"
                          core:Ui.IsActive="{Binding SelectedTypeFilter.IsAll, Converter={StaticResource IsFalse}}"
                          ItemsSource="{Binding TypeFiltersView}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          Text="{Binding TypeFilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding IsConnected}"
                          ToolTip="Object type. Type to narrow the list." />

                <ComboBox Margin="0,0,6,0" Padding="7,0"
                          core:Ui.InlineLabel="Sub type"
                          core:Ui.SelectionText="{Binding SelectedSubTypeFilter.ShortLabel}"
                          core:Ui.IsActive="{Binding SelectedSubTypeFilter.IsAll, Converter={StaticResource IsFalse}}"
                          ItemsSource="{Binding SubTypeFilters}"
                          SelectedItem="{Binding SelectedSubTypeFilter}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding HasSubTypes}"
                          ToolTip="Categorisation within the selected object type, e.g. cloud flow or business rule for a process." />

                <ComboBox Margin="0,0,6,0" Padding="7,0"
                          core:Ui.InlineLabel="State"
                          core:Ui.SelectionText="{Binding SelectedStateFilter.ShortLabel}"
                          core:Ui.IsActive="{Binding SelectedStateFilter.IsAll, Converter={StaticResource IsFalse}}"
                          ItemsSource="{Binding StateFilters}"
                          SelectedItem="{Binding SelectedStateFilter}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding IsConnected}"
                          ToolTip="Managed and unmanaged" />

                <ComboBox Margin="0,0,6,0" Padding="7,0"
                          core:Ui.InlineLabel="Layer"
                          core:Ui.SelectionText="{Binding SelectedLayerFilter.ShortLabel}"
                          core:Ui.IsActive="{Binding SelectedLayerFilter.IsAll, Converter={StaticResource IsFalse}}"
                          ItemsSource="{Binding LayerFilters}"
                          SelectedItem="{Binding SelectedLayerFilter}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding CanFilterByLayer}"
                          ToolTipService.ShowOnDisabled="True">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="ToolTip" Value="Whether the object has an unmanaged customization on top of its managed layer." />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Run Check layers first" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <!-- On: the active filter look, like the boxes beside it. -->
                <ToggleButton Style="{StaticResource FilterToggle}" Margin="0,0,6,0" IsChecked="{Binding FavouritesOnly}"
                              IsEnabled="{Binding IsConnected}" ToolTip="Show only starred objects"
                              AutomationProperties.Name="Favourites only">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" Margin="0,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Amber}" />
                        <TextBlock Text="Favourites" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Button Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>

            <!-- The environment's own tools (solution history, admin) are in the sidebar; solution tools in the header. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Content="Check layers"
                        Command="{Binding CheckUnmanagedLayersCommand}"
                        ToolTip="Queries Dataverse's solution layers for every object currently on screen that hasn't been checked yet - one request per object, so narrowing the filters first is faster. Results are kept until the environment reconnects." />
                <Button Content="Stop" Margin="6,0,0,0"
                        Command="{Binding CancelLayerCheckCommand}"
                        Visibility="{Binding IsCheckingLayers, Converter={StaticResource BoolToVis}}"
                        ToolTip="Stop checking layers" />
                <Button Content="Export CSV…" Margin="6,0,0,0"
                        Command="{Binding ExportCsvCommand}"
                        ToolTip="Exports the rows currently on screen, filters and all." />
                <Button AutomationProperties.Name="Show or hide the detail pane" Content="&#xE8A0;" Margin="6,0,0,0"
                        Command="{Binding ToggleDetailPaneCommand}"
                        ToolTip="Show or hide the detail pane">
                    <!-- On while the pane is open, like an active filter. -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailPaneOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Link}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>


        <!-- ============================================================ busy -->
        <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Border}" />
        <ProgressBar Grid.Row="2" Style="{StaticResource BusyBar}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <!-- ============================================================ results -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Nothing to list: say why in its place, and clear the filters where they are the cause. -->
            <ContentControl Grid.Column="0" Panel.ZIndex="1" Style="{StaticResource EmptyState}"
                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" />

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      PreviewMouseRightButtonDown="OnGridRightButtonDown"
                      SelectionChanged="OnGridSelectionChanged"
                      MouseDoubleClick="OnGridDoubleClick"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      ScrollViewer.CanContentScroll="True">

                <DataGrid.ContextMenu>
                    <!--
                        No CommandParameter: the menu closes before the command runs, which detaches
                        a RelativeSource binding and hands the command a null. The commands read
                        SelectedItem instead, and right-clicking a row selects it first.
                    -->
                    <ContextMenu>
                        <!-- Open · copy · the selection · then, kept apart at the bottom, what writes. -->
                        <MenuItem Header="Open details" Command="{Binding ShowDetailsCommand}" FontWeight="SemiBold"
                                  InputGestureText="Double-click" />
                        <MenuItem Header="Open in maker portal" Command="{Binding OpenLinkCommand}" />
                        <MenuItem Header="Audit history" Command="{Binding AuditHistoryCommand}"
                                  ToolTip="Who changed it and how - each audited change, where Dataverse auditing records it"
                                  Visibility="{Binding CanShowAuditHistory, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{Binding FavouriteHeader}" Command="{Binding ToggleFavouriteCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding CopyNameHeader}" Command="{Binding CopyNameCommand}" />
                        <MenuItem Header="{Binding CopyLinkHeader}" Command="{Binding CopyLinkCommand}" />
                        <MenuItem Header="{Binding CopyIdHeader}" Command="{Binding CopyIdCommand}" />
                        <MenuItem Header="Copy as table" Command="{Binding CopyAsTableCommand}"
                                  ToolTip="Tab-separated with a header row - pastes into Excel as a table" />
                        <Separator Visibility="{Binding HasMultipleSelected, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{Binding SelectionHeader}" IsEnabled="False"
                                  Visibility="{Binding HasMultipleSelected, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Open details for each" Command="{Binding OpenSelectionDetailsCommand}"
                                  Visibility="{Binding HasMultipleSelected, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Check layers for selection" Command="{Binding CheckSelectionLayersCommand}"
                                  Visibility="{Binding HasMultipleSelected, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Export selection to CSV…" Command="{Binding ExportSelectionCommand}"
                                  Visibility="{Binding HasMultipleSelected, Converter={StaticResource BoolToVis}}" />
                        <!-- Change in {env} · WRITES: each asks first, so each ends in "…". -->
                        <Separator Visibility="{Binding ShowsChangeGroup, Converter={StaticResource BoolToVis}}" />
                        <MenuItem IsEnabled="False" Visibility="{Binding ShowsChangeGroup, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title, StringFormat=Change in {0}}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource WritesTag}" Margin="8,0,0,0" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Header="{Binding SwitchOnLabel}" Command="{Binding SwitchOnCommand}"
                                  ToolTip="{Binding Title, StringFormat='Turn on flows, activate processes, enable plug-in steps in {0} - guarded, confirmed and logged'}"
                                  Visibility="{Binding HasSwitchableSelection, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{Binding SwitchOffLabel}" Command="{Binding SwitchOffCommand}"
                                  ToolTip="{Binding Title, StringFormat='Turn off flows, deactivate processes, disable plug-in steps in {0} - guarded, confirmed and logged'}"
                                  Visibility="{Binding HasSwitchableSelection, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Turn on every flow listed that is off…" Command="{Binding TurnOnSolutionFlowsCommand}"
                                  ToolTip="{Binding Title, StringFormat='Checks every cloud flow in the loaded list and turns on the ones that are off, in {0} - guarded, confirmed and logged'}"
                                  Visibility="{Binding HasCloudFlows, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- A star for a favourite; sorting by it brings them together. -->
                    <DataGridTemplateColumn Width="26" SortMemberPath="IsFavourite" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="11" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Amber}" ToolTip="Favourite"
                                           Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="220" SortMemberPath="PrimaryLabel"
                                            HeaderStyle="{StaticResource FirstHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CellFirst}">
                                    <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{Binding MakerUrl}">
                                        <Hyperlink.Style>
                                            <Style TargetType="Hyperlink" BasedOn="{StaticResource {x:Type Hyperlink}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MakerUrl}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Hyperlink.Style>
                                        <Run Text="{Binding PrimaryLabel, Mode=OneWay}" />
                                    </Hyperlink>
                                    <Run Text="{Binding SecondaryLabel, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter='  '}"
                                         FontSize="11" Foreground="{DynamicResource Faint}" />
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Type" Width="150" SortMemberPath="ComponentTypeName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Cell}">
                                    <Run Text="{Binding ComponentTypeName, Mode=OneWay}" /><Run
                                         Text="{Binding SubType, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter=' · '}"
                                         Foreground="{DynamicResource Muted}" />
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="State" Binding="{Binding ManagedLabel}" Width="84">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Layer" Width="144" SortMemberPath="UnmanagedLayerLabel">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="Whether the object has an unmanaged layer. — until Check layers has been run." />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="LayerDot" Style="{StaticResource Dot}" Margin="0,1,6,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="LayerText" Text="—" Foreground="{DynamicResource Faint}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasUnmanagedLayer}" Value="True">
                                        <Setter TargetName="LayerDot" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="LayerDot" Property="Fill" Value="{DynamicResource Amber}" />
                                        <Setter TargetName="LayerText" Property="Text" Value="Unmanaged layer" />
                                        <Setter TargetName="LayerText" Property="Foreground" Value="{DynamicResource Amber}" />
                                    </DataTrigger>
                                    <!-- The same words and colours everywhere: Unmanaged layer in Amber, No unmanaged layer neutral. -->
                                    <DataTrigger Binding="{Binding HasUnmanagedLayer}" Value="False">
                                        <Setter TargetName="LayerText" Property="Text" Value="No unmanaged layer" />
                                        <Setter TargetName="LayerText" Property="Foreground" Value="{DynamicResource Muted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Modified"
                                        Binding="{Binding ModifiedOn, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                        Width="112" SortMemberPath="ModifiedOn"
                                        ElementStyle="{StaticResource CellMuted}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- ============================================================ detail pane -->
            <Border Grid.Column="1" Width="280" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="Select an object to see its details." Foreground="{DynamicResource Faint}"
                               Margin="16,14" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedItem, Converter={StaticResource EmptyToCollapsed}}">
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,14,16,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding PrimaryLabel}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SecondaryLabel}" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding SecondaryLabel, Converter={StaticResource EmptyToCollapsed}}" />

                                    <WrapPanel Margin="0,8,0,0">
                                        <ContentControl Style="{StaticResource Chip}" Margin="0,0,4,4">
                                            <TextBlock>
                                                <Run Text="{Binding ComponentTypeName, Mode=OneWay}" /><Run
                                                     Text="{Binding SubType, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter=' · '}" />
                                            </TextBlock>
                                        </ContentControl>
                                        <ContentControl Style="{StaticResource Chip}" Margin="0,0,4,4"
                                                        Content="{Binding ManagedLabel}" />
                                        <ContentControl Margin="0,0,4,4">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                                    <Setter Property="Content" Value="Not checked for layers" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnmanagedLayer}" Value="True">
                                                            <Setter Property="Content" Value="Unmanaged layer" />
                                                            <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AmberSoft}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasUnmanagedLayer}" Value="False">
                                                            <Setter Property="Content" Value="No unmanaged layer" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </WrapPanel>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Details is where the app does its work, so it leads; the portal is a step away. -->
                                        <Button Style="{StaticResource PrimaryButton}" Content="Open details"
                                                ToolTip="Solutions, layers and dependencies - and runs, design, source or columns, by type (double-click a row)"
                                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Grid.Column="1" Content="Open in maker portal" Margin="6,0,0,0"
                                                ToolTip="Open this object in make.powerapps.com"
                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="16,10,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Related table" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}">
                                    <TextBlock.Text>
                                        <Binding Path="PrimaryEntityName" TargetNullValue="—" />
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Text="Owner" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}">
                                    <TextBlock.Text>
                                        <Binding Path="Owner" TargetNullValue="—" />
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Text="Modified" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}"
                                           Text="{Binding ModifiedOn, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=—}" />

                                <TextBlock Grid.Row="3" Text="Object id" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           TextWrapping="Wrap" Text="{Binding ObjectId}" />
                            </Grid>

                            <!-- A cloud flow's latest run, read with the selection. -->
                            <Border Margin="16,4,16,6" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource Border}"
                                    DataContext="{Binding DataContext.LatestRun, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"
                                                   Text="{Binding Run.StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        <TextBlock Text="Last run" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <ContentControl Style="{StaticResource OutcomePill}" Content="{Binding Run.Status}" />
                                        <TextBlock Text="{Binding FailedLabel}" FontSize="11" Foreground="{DynamicResource Muted}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ErrorLine}" FontSize="11" Foreground="{DynamicResource Red}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Run.ErrorMessage}"
                                               Visibility="{Binding ErrorLine, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                            </Border>

                            <!-- An environment variable's value, in place of reading it in the window. -->
                            <StackPanel Margin="16,4,16,6"
                                        Visibility="{Binding DataContext.SelectedVariableValue, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="Current value" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding DataContext.SelectedVariableValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           ToolTip="{Binding DataContext.SelectedVariable.EffectiveSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Straight to a tab of the details window. -->
                            <TextBlock Text="Open in details" Style="{StaticResource Label}" Margin="16,6,16,0" />
                            <ItemsControl Margin="16,6,10,6"
                                          ItemsSource="{Binding DataContext.DetailShortcuts, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" ToolTip="{Binding ToolTip}"
                                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Text="→" Foreground="{DynamicResource Faint}" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Copy" Style="{StaticResource Label}" Margin="16,6,16,0" />
                            <StackPanel Orientation="Horizontal" Margin="16,6,16,6">
                                <Button Style="{StaticResource SmallButton}" Content="Name"
                                        Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Style="{StaticResource SmallButton}" Content="Maker link" Margin="6,0,0,0"
                                        Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Style="{StaticResource SmallButton}" Content="Object id" Margin="6,0,0,0"
                                        Command="{Binding DataContext.CopyIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>

                            <!-- Writes last, as in the grid menu, apart from what reads: only for types that have such actions. -->
                            <StackPanel Visibility="{Binding DataContext.HasQuickActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="16,6,16,0">
                                    <TextBlock Text="Change" Style="{StaticResource Label}" Margin="0" />
                                    <TextBlock Style="{StaticResource WritesTag}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,6,16,12">
                                    <Button Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                            Content="{Binding DataContext.SwitchOffLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.SwitchOffToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Command="{Binding DataContext.SwitchOffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding DataContext.ShowSwitchOff, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                            Content="{Binding DataContext.SwitchOnLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.SwitchOnToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Command="{Binding DataContext.SwitchOnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding DataContext.ShowSwitchOn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Asks first" FontSize="11" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ status -->
        <Border Grid.Row="4" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Status}" />
                <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
