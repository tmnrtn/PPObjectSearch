<UserControl x:Class="PPObjectSearch.Views.EnvironmentSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="13"
             Foreground="{StaticResource TextPrimary}"
             Background="{StaticResource SurfaceAlt}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ENVIRONMENT URL" Style="{StaticResource Label}" />
                    <TextBox x:Name="EnvironmentBox"
                             Text="{Binding EnvironmentUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. https://contoso.crm11.dynamics.com">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ConnectCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <Button Grid.Column="1" Margin="10,16,0,0" VerticalAlignment="Bottom"
                        Content="Connect" Command="{Binding ConnectCommand}" />

                <Button Grid.Column="2" Margin="8,16,0,0" VerticalAlignment="Bottom"
                        Content="Switch account" MinWidth="110"
                        Command="{Binding SwitchAccountCommand}"
                        ToolTip="Sign this tab in with a different account or tenant." />

                <StackPanel Grid.Column="3" Margin="16,16,0,0" VerticalAlignment="Bottom" MaxWidth="240">
                    <TextBlock Text="{Binding AccountName}" Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding TenantId, StringFormat=Tenant: {0}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Solution + search -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="SOLUTION" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Solutions}"
                              SelectedItem="{Binding SelectedSolution}"
                              DisplayMemberPath="DisplayLabel"
                              IsEnabled="{Binding IsSolutionPickerEnabled}"
                              ToolTip="Defaults to this environment's default solution." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="SEARCH" Style="{StaticResource Label}" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Space separated keywords; every keyword must match the name, display name, schema name, type, owner or id.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <Button Grid.Column="2" Margin="0,16,0,0" VerticalAlignment="Bottom"
                        Content="Refresh" Command="{Binding RefreshCommand}"
                        ToolTip="F5 - re-reads the environment, bypassing the cache." />
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="OBJECT TYPE" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding TypeFiltersView}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              Text="{Binding TypeFilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding IsConnected}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="SUB TYPE" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding SubTypeFilters}"
                              SelectedItem="{Binding SelectedSubTypeFilter}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding HasSubTypes}"
                              ToolTip="Categorisation within the selected object type, e.g. cloud flow or business rule for a process." />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="STATE" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding StateFilters}"
                              SelectedItem="{Binding SelectedStateFilter}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding IsConnected}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="LAYER" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding LayerFilters}"
                              SelectedItem="{Binding SelectedLayerFilter}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding IsConnected}"
                              ToolTip="Whether the object has an unmanaged customization on top of its managed layer. Unknown until 'Check unmanaged layers' has been run." />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Bottom">
                    <Button Content="Check unmanaged layers" MinWidth="160"
                            Command="{Binding CheckUnmanagedLayersCommand}"
                            ToolTip="Queries Dataverse's solution layers for every object currently on screen that hasn't been checked yet - one request per object, so narrowing the filters first is faster." />
                    <Button Content="Clear filters" MinWidth="100" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
                    <Button Content="Export CSV" MinWidth="100" Margin="8,0,0,0"
                            Command="{Binding ExportCsvCommand}"
                            ToolTip="Exports the rows currently on screen, filters and all." />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="3" Height="3" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <!-- Results -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding ItemsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF0F3"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  Background="{StaticResource Surface}"
                  BorderThickness="0"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>

                <Style TargetType="TextBlock" x:Key="CellText">
                    <Setter Property="Margin" Value="8,6" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>

                <Style TargetType="TextBlock" x:Key="MutedCellText" BasedOn="{StaticResource CellText}">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in maker portal"
                              Command="{Binding OpenLinkCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Details - solutions and dependencies..."
                              Command="{Binding ShowDetailsCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Copy name"
                              Command="{Binding CopyNameCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Copy maker portal link"
                              Command="{Binding CopyLinkCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Copy object id"
                              Command="{Binding CopyIdCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="420" SortMemberPath="PrimaryLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{Binding MakerUrl}">
                                        <Hyperlink.Style>
                                            <Style TargetType="Hyperlink">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                <Setter Property="TextDecorations" Value="{x:Null}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding MakerUrl}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Hyperlink.Style>
                                        <Run Text="{Binding PrimaryLabel, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{Binding SecondaryLabel}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SecondaryLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Object type" Binding="{Binding ComponentTypeName}" Width="180"
                                    ElementStyle="{StaticResource CellText}" />

                <DataGridTextColumn x:Name="SubTypeColumn"
                                    Header="Sub type" Binding="{Binding SubType}" Width="160"
                                    ElementStyle="{StaticResource CellText}" />

                <DataGridTextColumn x:Name="RelatedTableColumn"
                                    Header="Related table" Binding="{Binding PrimaryEntityName}" Width="160"
                                    ElementStyle="{StaticResource MutedCellText}" />

                <DataGridTextColumn Header="State" Binding="{Binding ManagedLabel}" Width="110"
                                    ElementStyle="{StaticResource CellText}" />

                <DataGridTextColumn Header="Layer" Binding="{Binding UnmanagedLayerLabel}" Width="130"
                                    ElementStyle="{StaticResource MutedCellText}" />

                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="170"
                                    ElementStyle="{StaticResource CellText}" />

                <DataGridTextColumn Header="Modified"
                                    Binding="{Binding ModifiedOn, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="140"
                                    ElementStyle="{StaticResource MutedCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <Border Grid.Row="5" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" FontWeight="SemiBold" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
