<Window x:Class="PPObjectSearch.Views.EnvironmentDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPObjectSearch.Views"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="Border" x:Key="PaneHeading">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,14,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource WindowHeading}" Text="{Binding ComponentLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding ComponentTypeName}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="·" Foreground="{DynamicResource Faint}" Margin="8,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource EnvBar}" Height="14" Margin="0,0,6,0" Tag="{Binding LeftSku}" />
                        <TextBlock Text="{Binding LeftEnvironment}" VerticalAlignment="Center" />
                        <TextBlock Text="vs" Foreground="{DynamicResource Muted}" Margin="8,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource EnvBar}" Height="14" Margin="0,0,6,0" Tag="{Binding RightSku}" />
                        <TextBlock Text="{Binding RightEnvironment}" VerticalAlignment="Center" />
                        <TextBlock Text="·" Foreground="{DynamicResource Faint}" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IdentityLabel}" Foreground="{DynamicResource Muted}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" Height="30" Width="30"
                        VerticalAlignment="Top" Command="{Binding RefreshCommand}" ToolTip="Read both definitions again" />
            </Grid>

            <Grid Grid.Row="1">
                <TabControl>
                    <TabItem Header="Definition" core:Ui.Count="{Binding ChangeCountLabel}">
                        <views:DefinitionDiffView />
                    </TabItem>

                    <TabItem Header="Layers">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource EnvBar}" Height="14" Margin="0,0,8,0" Tag="{Binding LeftSku}" />
                                        <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding LeftEnvironment}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding LeftLayers}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="*"
                                                            HeaderStyle="{StaticResource FirstHeader}"
                                                            ElementStyle="{StaticResource CellFirst}" />
                                        <DataGridTextColumn Header="Publisher" Binding="{Binding PublisherName}" Width="120"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                        <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="120"
                                                            ElementStyle="{StaticResource Cell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource EnvBar}" Height="14" Margin="0,0,8,0" Tag="{Binding RightSku}" />
                                            <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding RightEnvironment}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding RightLayers}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="*"
                                                                HeaderStyle="{StaticResource FirstHeader}"
                                                                ElementStyle="{StaticResource CellFirst}" />
                                            <DataGridTextColumn Header="Publisher" Binding="{Binding PublisherName}" Width="120"
                                                                ElementStyle="{StaticResource CellMuted}" />
                                            <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="120"
                                                                ElementStyle="{StaticResource Cell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <ProgressBar Style="{StaticResource BusyBar}" VerticalAlignment="Top" Margin="0,31,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               Text="Select text in either pane to copy it" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
