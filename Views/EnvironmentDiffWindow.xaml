<Window x:Class="PPObjectSearch.Views.EnvironmentDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PPObjectSearch.Views"
        Title="{Binding Title}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Cell">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="DataGrid" x:Key="LayerGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F3" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ComponentLabel}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ComponentTypeName}" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding IdentityLabel}" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh" Padding="12,6" MinWidth="0"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <TabControl Grid.Row="2" Margin="16" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}">
            <TabItem Header="Definition">
                <views:DefinitionDiffView />
            </TabItem>

            <TabItem Header="Layers">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LeftEnvironment}"
                               FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RightEnvironment}"
                               FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

                    <DataGrid Grid.Row="1" Grid.Column="0" Style="{StaticResource LayerGrid}"
                              ItemsSource="{Binding LeftLayers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="*"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Publisher" Binding="{Binding PublisherName}" Width="120"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="120"
                                                ElementStyle="{StaticResource Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="1" Grid.Column="2" Style="{StaticResource LayerGrid}"
                              ItemsSource="{Binding RightLayers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="*"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Publisher" Binding="{Binding PublisherName}" Width="120"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="120"
                                                ElementStyle="{StaticResource Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
