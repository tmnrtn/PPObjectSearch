<Window x:Class="PPObjectSearch.Views.FailuresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="760" Width="1200"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- A source in the summary band: a round toggle with a tick and its count. -->
        <Style TargetType="ToggleButton" x:Key="SourcePill">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Tick" Text="✓" FontSize="10" Width="10" Foreground="{DynamicResource Link}"
                                           VerticalAlignment="Center" Visibility="Hidden" />
                                <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Grid.Row="0" Margin="18,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <local:EnvironmentLine DataContext="{Binding Session}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Failures" Style="{StaticResource WindowHeading}" />
                        <ContentControl Style="{StaticResource Chip}" Content="Read-only" Foreground="{DynamicResource Muted}"
                                        Margin="8,2,0,0" ToolTip="Reads the environment - nothing is written" />
                    </StackPanel>
                </StackPanel>

                <!-- Period first, then read again, then export. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ComboBox Width="170" core:Ui.InlineLabel="Period" FontWeight="SemiBold"
                              AutomationProperties.Name="Period"
                              ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="FontWeight" Value="Normal" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <DatePicker Width="130" Height="28" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                AutomationProperties.Name="From date"
                                SelectedDate="{Binding CustomFrom}" ToolTip="The first day of the period"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                    <DatePicker Width="130" Height="28" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                AutomationProperties.Name="To date"
                                SelectedDate="{Binding CustomTo}" ToolTip="The last day of the period, included to its end"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Stop" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button AutomationProperties.Name="Read again" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                            Command="{Binding LoadCommand}" ToolTip="Read again" />
                    <Button Margin="6,0,0,0" core:Ui.OpensMenu="True" ToolTip="CSV: every failure · Markdown: the overview">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="7,1,0,0"
                                       Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="CSV: every failure…" Command="{Binding ExportCsvCommand}"
                                          ToolTip="Every failure shown, one per line" />
                                <MenuItem Header="Markdown: the overview…" Command="{Binding ExportMarkdownCommand}"
                                          ToolTip="The overview, for an incident write-up" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================ summary band -->
            <Border Grid.Row="1" Padding="18,12" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalFailures, StringFormat={}{0:N0}}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalLabel}" FontSize="11" Foreground="{DynamicResource Muted}" />
                    </StackPanel>

                    <!-- The trend: a bar per day (per hour over a day or two), a tooltip each. -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Trend}" Margin="22,0,0,0" VerticalAlignment="Center"
                                  Focusable="False" AutomationProperties.Name="Failures over the period">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,3,0" Width="{Binding Width}" ToolTip="{Binding ToolTip}"
                                            AutomationProperties.Name="{Binding ToolTip}" Background="Transparent">
                                    <Grid Height="30">
                                        <Border Height="{Binding Height}" Opacity="{Binding Opacity}" VerticalAlignment="Bottom"
                                                Background="{DynamicResource Red}" CornerRadius="2,2,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding Short}" FontSize="10" Foreground="{DynamicResource Faint}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Which sources count. All three are always read, so these just narrow what is shown. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Include" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <ToggleButton Style="{StaticResource SourcePill}" Content="Flow runs" Tag="{Binding FlowFailureCount}"
                                      IsChecked="{Binding IncludeFlows}" ToolTip="Cloud flow runs that failed" />
                        <ToggleButton Style="{StaticResource SourcePill}" Content="Workflow jobs" Tag="{Binding WorkflowFailureCount}"
                                      IsChecked="{Binding IncludeClassicWorkflows}" ToolTip="Classic workflow system jobs that failed" />
                        <ToggleButton Style="{StaticResource SourcePill}" Content="Plug-ins" Tag="{Binding PluginFailureCount}"
                                      IsChecked="{Binding IncludePlugins}"
                                      ToolTip="Plug-in trace log entries with an exception - only where plug-in trace logging is on" />
                        <CheckBox Content="This solution only" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SolutionOnly}"
                                  ToolTip="{Binding SolutionLabel}"
                                  Visibility="{Binding HasSolution, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Warnings - a source that could not be read, or tracing that is off - under the band. -->
            <Border Grid.Row="2" Style="{StaticResource Banner}" Margin="18,10,18,0"
                    Visibility="{Binding Notes, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
            </Border>

            <ProgressBar Grid.Row="3" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- ============================================================ components | detail -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" IsReadOnly="True"
                          AutomationProperties.Name="Failing components, most failures first" RowHeight="34"
                          BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                          Visibility="{Binding HasComponents, Converter={StaticResource BoolToVis}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenLatestFailedRunCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding OpenLatestFailedRunCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Component" Width="*" SortMemberPath="ComponentName"
                                                HeaderStyle="{StaticResource FirstHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="16,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ComponentName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TopError}" FontSize="11" Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TopError}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Source" Width="110" Binding="{Binding SourceLabel}" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTextColumn Header="Failures" Width="64" Binding="{Binding Failures, StringFormat={}{0:N0}}"
                                            SortMemberPath="Failures" SortDirection="Descending"
                                            HeaderStyle="{StaticResource RightHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last failed" Width="120" SortMemberPath="Last"
                                            Binding="{Binding Last, StringFormat={}{0:yyyy-MM-dd HH:mm}}" ElementStyle="{StaticResource CellMuted}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Nothing to list: say why, and what to change. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding HasComponents, Converter={StaticResource NotBoolToVis}}">
                    <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- The selected component: its failures grouped by error, and the latest ones. -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,14,16,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedComponent.ComponentName}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <ContentControl Style="{StaticResource Chip}" Margin="0,0,4,0"
                                                        Content="{Binding SelectedComponent.SourceLabel}" />
                                        <ContentControl Margin="0,0,4,0" Content="{Binding SelectedStateLabel}"
                                                        Visibility="{Binding SelectedStateLabel, Converter={StaticResource EmptyToCollapsed}}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedOn}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GreenSoft}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SelectedRunsLabel}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Open latest failed run"
                                                Command="{Binding OpenLatestFailedRunCommand}"
                                                ToolTip="The newest failure, in the details window: a flow's or workflow's runs, a plug-in's trace log" />
                                        <Button Grid.Column="1" Content="Details…" Margin="6,0,0,0"
                                                Command="{Binding OpenComponentDetailsCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding SelectedErrorsHeading}" Style="{StaticResource SectionHeading}" Margin="16,10,16,4" />
                            <ItemsControl ItemsSource="{Binding SelectedErrors}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="16,4" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource Border}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Margin="8,0,0,0"
                                                               Text="{Binding Failures, StringFormat={}{0:N0}×}" />
                                                    <TextBlock Text="{Binding Events[0].StepLabel}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource Red}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="60"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Events[0].ErrorMessage}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Recent failures" Style="{StaticResource SectionHeading}" Margin="16,10,16,4" />
                            <ItemsControl ItemsSource="{Binding RecentFailures}" Focusable="False" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28" Padding="16,0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <DockPanel VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"
                                                           Text="{Binding When, StringFormat={}{0:MM-dd HH:mm}}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="11" Height="22"
                                                        Content="Run →" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Open this failure in the details window" />
                                                <TextBlock Text="{Binding ErrorLine}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ErrorMessage}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="5" Style="{StaticResource StatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusLine}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding StatusLine}" />
                    <TextBlock Grid.Column="1" Text="{Binding ComponentCountLabel}" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
