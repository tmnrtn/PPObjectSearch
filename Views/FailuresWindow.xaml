<Window x:Class="PPObjectSearch.Views.FailuresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="760" Width="1200"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="100" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The period, and what to read. -->
            <WrapPanel Grid.Row="0" Margin="16,14,16,12">
                <ComboBox Width="170" Height="32" Margin="0,0,8,6" core:Ui.InlineLabel="Show"
                          AutomationProperties.Name="Period"
                          ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" />
                <DatePicker Width="130" Height="32" Margin="0,0,8,6" VerticalContentAlignment="Center"
                            AutomationProperties.Name="From date"
                            SelectedDate="{Binding CustomFrom}" ToolTip="The first day of the period"
                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                <DatePicker Width="130" Height="32" Margin="0,0,8,6" VerticalContentAlignment="Center"
                            AutomationProperties.Name="To date"
                            SelectedDate="{Binding CustomTo}" ToolTip="The last day of the period, included to its end"
                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                <CheckBox Content="Cloud flows" Margin="4,0,12,6" VerticalAlignment="Center" IsChecked="{Binding IncludeFlows}"
                          ToolTip="Flow runs that failed" />
                <CheckBox Content="Classic workflows" Margin="0,0,12,6" VerticalAlignment="Center" IsChecked="{Binding IncludeClassicWorkflows}"
                          ToolTip="Workflow system jobs that failed" />
                <CheckBox Content="Plug-ins" Margin="0,0,12,6" VerticalAlignment="Center" IsChecked="{Binding IncludePlugins}"
                          ToolTip="Plug-in trace log entries with an exception - only where plug-in trace logging is on" />
                <CheckBox Content="This solution only" Margin="0,0,12,6" VerticalAlignment="Center" IsChecked="{Binding SolutionOnly}"
                          ToolTip="{Binding SolutionLabel}"
                          Visibility="{Binding HasSolution, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Refresh" Height="32" Padding="16,0" Margin="0,0,8,6"
                        Command="{Binding LoadCommand}" ToolTip="Reads the environment - nothing is written" />
                <Button Content="Stop" Height="32" Margin="0,0,8,6" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Content="Export CSV" Height="32" Margin="0,0,8,6" Command="{Binding ExportCsvCommand}"
                        ToolTip="Every failure in the period, one per line" />
                <Button Content="Export Markdown" Height="32" Margin="0,0,8,6" Command="{Binding ExportMarkdownCommand}"
                        ToolTip="The overview, for an incident write-up" />
            </WrapPanel>

            <!-- Sources that could not be read, said rather than left empty. -->
            <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="16,0,16,10"
                    Visibility="{Binding Notes, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource Amber}" />
            </Border>

            <TabControl Grid.Row="2" Margin="0,6,0,0">
                <TabItem Header="By component">
                    <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" IsReadOnly="True"
                              AutomationProperties.Name="Failures by component, most first"
                              BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Component" Width="*" Binding="{Binding ComponentName}"
                                                HeaderStyle="{StaticResource FirstHeader}" ElementStyle="{StaticResource CellFirst}" />
                            <DataGridTextColumn Header="Kind" Width="120" Binding="{Binding SourceLabel}" ElementStyle="{StaticResource CellMuted}" />
                            <DataGridTextColumn Header="Failures" Width="80" Binding="{Binding Failures, StringFormat={}{0:N0}}"
                                                SortMemberPath="Failures" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Runs" Width="80" Binding="{Binding RunsLabel}" SortMemberPath="Runs"
                                                ElementStyle="{StaticResource CellMuted}" />
                            <DataGridTextColumn Header="Rate" Width="70" Binding="{Binding RateLabel}" SortMemberPath="FailureRate"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="First" Width="130" SortMemberPath="First"
                                                Binding="{Binding First, StringFormat={}{0:yyyy-MM-dd HH:mm}}" ElementStyle="{StaticResource CellMuted}" />
                            <DataGridTextColumn Header="Last" Width="130" SortMemberPath="Last"
                                                Binding="{Binding Last, StringFormat={}{0:yyyy-MM-dd HH:mm}}" ElementStyle="{StaticResource CellMuted}" />
                            <DataGridTextColumn Header="Most common error" Width="2*" Binding="{Binding TopError}" ElementStyle="{StaticResource Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="By error">
                    <DataGrid ItemsSource="{Binding Errors}" SelectedItem="{Binding SelectedError}" IsReadOnly="True"
                              AutomationProperties.Name="Failures by error, most first"
                              BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Error" Width="2*" Binding="{Binding Error}"
                                                HeaderStyle="{StaticResource FirstHeader}" ElementStyle="{StaticResource CellFirst}" />
                            <DataGridTextColumn Header="Failures" Width="80" Binding="{Binding Failures, StringFormat={}{0:N0}}"
                                                SortMemberPath="Failures" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Components" Width="100" Binding="{Binding Components, StringFormat={}{0:N0}}"
                                                SortMemberPath="Components" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Last" Width="130" SortMemberPath="Last"
                                                Binding="{Binding Last, StringFormat={}{0:yyyy-MM-dd HH:mm}}" ElementStyle="{StaticResource CellMuted}" />
                            <DataGridTextColumn Header="Which" Width="*" Binding="{Binding ComponentNames}" ElementStyle="{StaticResource CellMuted}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Trend">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Trend}" Margin="16,10,16,10"
                                      AutomationProperties.Name="Failures over the period">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1" AutomationProperties.Name="{Binding Label}"
                                          AutomationProperties.HelpText="{Binding Failures, StringFormat={}{0} failure(s)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Height="12" Minimum="0" Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                                     Foreground="{DynamicResource Red}" Background="Transparent" BorderThickness="0"
                                                     VerticalAlignment="Center" Focusable="False" />
                                        <TextBlock Grid.Column="2" Text="{Binding Failures, StringFormat={}{0:N0}}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" ResizeDirection="Rows" ToolTip="Drag to resize" Focusable="False" />

            <!-- The failures behind the row chosen above. -->
            <DataGrid Grid.Row="4" ItemsSource="{Binding DrillEvents}" SelectedItem="{Binding SelectedEvent}" IsReadOnly="True"
                      AutomationProperties.Name="Failures for the chosen row, newest first"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenEventCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding OpenEventCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Width="140" SortMemberPath="When" HeaderStyle="{StaticResource FirstHeader}"
                                        Binding="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" ElementStyle="{StaticResource CellFirst}" />
                    <DataGridTextColumn Header="Kind" Width="120" Binding="{Binding SourceLabel}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Component" Width="220" Binding="{Binding ComponentName}" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Error" Width="2*" Binding="{Binding ErrorLine}" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Context" Width="180" Binding="{Binding Context}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Regarding" Width="*" Binding="{Binding Regarding}" ElementStyle="{StaticResource CellMuted}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="5" Style="{StaticResource StatusBar}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Status}" />
            </Border>
        </Grid>
    </Border>
</Window>
