<Window x:Class="PPObjectSearch.Views.AuditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Grid.Row="0" Margin="18,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <local:EnvironmentLine DataContext="{Binding Session}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audit history" Style="{StaticResource WindowHeading}" />
                        <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource Muted}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                   ToolTip="{Binding Heading}" />
                        <ContentControl Style="{StaticResource Chip}" Content="Read-only" Foreground="{DynamicResource Muted}"
                                        Margin="8,2,0,0" ToolTip="Reads the environment - nothing is written" />
                    </StackPanel>
                    <!-- Whether auditing is on for the environment and the table. -->
                    <TextBlock Text="{Binding AuditState}" Margin="0,6,12,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>

                <Button Grid.Column="1" AutomationProperties.Name="Read again" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        VerticalAlignment="Bottom" Command="{Binding RefreshCommand}" ToolTip="Read again" />
            </Grid>

            <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <DataGrid Grid.Row="2" ItemsSource="{Binding Records}" IsReadOnly="True"
                      AutomationProperties.Name="Audited changes, newest first"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Width="140" SortMemberPath="When" HeaderStyle="{StaticResource FirstHeader}"
                                        Binding="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm}}" ElementStyle="{StaticResource CellFirst}" />
                    <DataGridTextColumn Header="By" Width="180" Binding="{Binding By}" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Action" Width="110" Binding="{Binding Action}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Row" Width="110" Binding="{Binding Row}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Changes" Width="*" Binding="{Binding ChangesLabel}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="None" />
                                <Setter Property="Margin" Value="8,4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource StatusBar}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Status}" />
            </Border>
        </Grid>
    </Border>
</Window>
