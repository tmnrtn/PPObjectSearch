<Window x:Class="PPObjectSearch.Views.AuditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,14,16,12">
                <Button DockPanel.Dock="Right" Content="Refresh" Height="32" VerticalAlignment="Top"
                        Command="{Binding RefreshCommand}" />
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AuditState}" Margin="0,4,12,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" IsReadOnly="True"
                      AutomationProperties.Name="Audited changes, newest first"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Width="140" SortMemberPath="When" HeaderStyle="{StaticResource FirstHeader}"
                                        Binding="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm}}" ElementStyle="{StaticResource CellFirst}" />
                    <DataGridTextColumn Header="By" Width="180" Binding="{Binding By}" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Action" Width="110" Binding="{Binding Action}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Row" Width="110" Binding="{Binding Row}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Changes" Width="*" Binding="{Binding ChangesLabel}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="None" />
                                <Setter Property="Margin" Value="8,4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Status}" />
            </Border>
        </Grid>
    </Border>
</Window>
