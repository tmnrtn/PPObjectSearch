<Window x:Class="PPObjectSearch.Views.AuditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- DataGrid columns are not in the visual tree, so the Row column reads the view model through this. -->
        <core:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Window.Resources>

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Grid.Row="0" Margin="18,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <local:EnvironmentLine DataContext="{Binding Session}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audit history" Style="{StaticResource WindowHeading}" />
                        <ContentControl Style="{StaticResource Chip}" Content="Read-only" Foreground="{DynamicResource Muted}"
                                        Margin="8,2,0,0" ToolTip="Reads the environment - nothing is written" />
                    </StackPanel>
                    <!-- What the history is of: its name, then what it is. -->
                    <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run
                             Text="{Binding TypeLabel, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                    </TextBlock>
                    <!-- Auditing fully on: one quiet line. Off, or started after the component was made: the banner below. -->
                    <TextBlock Text="{Binding AuditState}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                               Visibility="{Binding ShowsAuditBanner, Converter={StaticResource NotBoolToVis}}" />
                </StackPanel>

                <Button Grid.Column="1" AutomationProperties.Name="Read again" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}" ToolTip="Read again" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="18,0,18,10"
                    Visibility="{Binding ShowsAuditBanner, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding AuditState}" TextWrapping="Wrap" />
            </Border>

            <ProgressBar Grid.Row="2" Style="{StaticResource BusyBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="3">
                <!-- Rows grow to fit: one line per column changed. -->
                <DataGrid ItemsSource="{Binding Records}" IsReadOnly="True" RowHeight="NaN"
                          AutomationProperties.Name="Audited changes, newest first"
                          BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                          Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Width="130" SortMemberPath="When" HeaderStyle="{StaticResource FirstHeader}"
                                            Binding="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellFirst}">
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                    <Setter Property="Margin" Value="16,7,8,7" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="By" Width="170" Binding="{Binding By}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                    <Setter Property="Margin" Value="8,7" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Action" Width="90" Binding="{Binding Action}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}">
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                    <Setter Property="Margin" Value="8,7" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Row" Width="110" Binding="{Binding Row}"
                                            Visibility="{Binding Data.ShowsRow, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}">
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                    <Setter Property="Margin" Value="8,7" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Each column changed: its name, the old value struck through, then the new one. -->
                        <DataGridTemplateColumn Header="Changes" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Changes}" Margin="8,7" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ColumnLabel}" Foreground="{DynamicResource Muted}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Column}" />
                                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="10,0,0,0">
                                                        <Run Text="{Binding OldShown, Mode=OneWay}" Foreground="{DynamicResource Muted}"
                                                             TextDecorations="Strikethrough" /><Run Text="  →  " Foreground="{DynamicResource Faint}" /><Run
                                                             Text="{Binding NewShown, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Nothing to list: say whether auditing is off or nothing changed. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding HasRecords, Converter={StaticResource NotBoolToVis}}">
                    <TextBlock Text="{Binding EmptyHeading}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource StatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding Status}" />
                    <TextBlock Grid.Column="1" Text="{Binding CountLabel}" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
