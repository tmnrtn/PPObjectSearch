<Window x:Class="PPObjectSearch.Views.AppInsightsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="{Binding Title}"
        Style="{StaticResource DialogWindow}"
        Height="700" Width="660"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Where this environment's Dataverse export goes; the list is everything the account sees in Azure. -->
            <StackPanel Grid.Row="0" Margin="16,14,16,10">
                <TextBlock Text="Choose the Application Insights resource this environment's Dataverse data export writes to."
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentLabel}" Margin="0,4,0,0" Foreground="{DynamicResource Muted}" />
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="16,0,16,12" AutomationProperties.Name="Search resources"
                     core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Search by name, subscription or resource group"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ListBox Grid.Row="2" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}"
                     BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Padding="16,6" Background="Transparent"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Where}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Current" Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Subscriptions that could not be read are said, not left out silently. -->
            <Border Grid.Row="3" Style="{StaticResource Banner}" Margin="16,10,16,0"
                    Visibility="{Binding Notes, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="4" Margin="16,10,16,12">
                <CheckBox Content="Only this environment's telemetry" IsChecked="{Binding OnlyThisEnvironment}"
                          ToolTip="Keeps requests made to this environment's host, and the plug-ins and exceptions in the same operations - for a resource that receives several environments' export. Untick for a resource that receives this one alone, to include plug-ins run outside a request." />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding CheckText}"
                           Visibility="{Binding CheckText, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CheckFoundTelemetry}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CheckFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Can this tab's account reach Azure at all: each API, OK or failed, listed here. -->
                <DockPanel Margin="0,12,0,0" Visibility="{Binding CanCheckAccess, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Left" Content="Check Azure access" Command="{Binding CheckAccessCommand}"
                            ToolTip="Tries each Azure API App Insights uses, as this tab's account, and says what worked. Changes nothing." />
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Copy results" Margin="10,0,0,0"
                            Command="{Binding CopyAccessCommand}" VerticalAlignment="Center"
                            Visibility="{Binding HasAccessResults, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding AccessSummary}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccessFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding AccessResults}" Margin="0,8,0,0" Focusable="False"
                              Visibility="{Binding HasAccessResults, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" CornerRadius="9" Padding="7,1" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Failed" />
                                                <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter Property="Text" Value="OK" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Check, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run
                                         Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Row="5" Style="{StaticResource Footer}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                        <Button Content="Remove" Margin="10,0,0,0" Foreground="{DynamicResource Red}"
                                Click="Remove_Click" ToolTip="Stop reading App Insights for this environment"
                                Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Height="30" IsCancel="True" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Use this resource" Height="30"
                                Margin="8,0,0,0" IsDefault="True" Click="Save_Click"
                                IsEnabled="{Binding CanSave}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
