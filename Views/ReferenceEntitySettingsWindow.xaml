<Window x:Class="PPObjectSearch.Views.ReferenceEntitySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        xmlns:svc="clr-namespace:PPObjectSearch.Services"
        Title="{Binding Title}"
        Style="{StaticResource DialogWindow}"
        Height="680" Width="720"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- A DataGrid column lives outside the visual tree, so it reaches the view model through this. -->
        <core:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <!-- A key option as a radio card: Accent border and AccentSoft fill when chosen. -->
        <Style TargetType="ListBoxItem" x:Key="KeyCard">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border2}"
                                BorderThickness="1" CornerRadius="6" Padding="10,9" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,9,0">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Border2}" StrokeThickness="1"
                                             Fill="{DynamicResource Surface}" />
                                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Faint}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The All | None | Defaults group. -->
        <Style TargetType="Button" x:Key="GroupButton" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ key and filter -->
            <StackPanel Grid.Row="0" Margin="16,12,16,14">
                <TextBlock Text="What identifies a row" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />

                <ListBox ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding SelectedKey}"
                         ItemContainerStyle="{StaticResource KeyCard}" Margin="0,0,-8,-8"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ToolTip="Primary ids only agree between environments where the rows were deployed rather than created separately.">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Value" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Source}" Value="{x:Static svc:RecordKeySource.Columns}">
                                    <Setter TargetName="Value" Property="Text" Value="Tick Key below" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Margin="0,14,0,6">
                    <Run Text="Row filter" FontWeight="SemiBold" />
                    <Run Text="· OData $filter, optional, applied to both environments" Foreground="{DynamicResource Muted}" />
                </TextBlock>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Height="30"
                         FontFamily="{StaticResource MonoFont}" core:Ui.Placeholder="e.g. statecode eq 0"
                         ToolTip="Applied to both environments, e.g. statecode eq 0" />
            </StackPanel>

            <!-- ============================================================ columns -->
            <Grid Grid.Row="1" Margin="16,12,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Columns to compare" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Height="28" core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Filter columns"
                         Text="{Binding ColumnSearch, UpdateSourceTrigger=PropertyChanged}" />

                <Border Grid.Column="2" Margin="8,0,0,0" BorderBrush="{DynamicResource Border2}" BorderThickness="1"
                        CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Surface}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GroupButton}" Content="All" Command="{Binding CompareAllCommand}"
                                ToolTip="Compare every column currently listed." />
                        <Rectangle Width="1" Fill="{DynamicResource Border2}" />
                        <Button Style="{StaticResource GroupButton}" Content="None" Command="{Binding CompareNoneCommand}" />
                        <Rectangle Width="1" Fill="{DynamicResource Border2}" />
                        <Button Style="{StaticResource GroupButton}" Content="Defaults" Command="{Binding ResetDefaultsCommand}"
                                ToolTip="Compare everything except the primary id and the created/modified/owner housekeeping columns." />
                    </StackPanel>
                </Border>
            </Grid>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding ColumnsView}"
                      IsReadOnly="True"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Compare" Width="72" SortMemberPath="IsCompared"
                                            HeaderStyle="{StaticResource FirstHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="16,0,0,0" Focusable="False"
                                          IsChecked="{Binding IsCompared, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Key" Width="52" SortMemberPath="IsKey"
                                            Visibility="{Binding Data.IsCustomKey, Source={StaticResource Proxy},
                                                                 Converter={StaticResource BoolToVis}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="8,0,0,0" Focusable="False"
                                          IsChecked="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Column" Width="*" SortMemberPath="LogicalName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Name" Text="{Binding LogicalName}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock x:Name="KeyTag" Text="KEY" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Link}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsKey, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCompared}" Value="False">
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Faint}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompared}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="120"
                                        ElementStyle="{StaticResource CellMuted}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- ============================================================ footer -->
            <Border Grid.Row="3" Style="{StaticResource Footer}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Muted}" ToolTip="{Binding Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding CompareSummary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompareSummary}" Value="">
                                        <Setter Property="Text" Value="{Binding Status}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Height="30" IsCancel="True" />
                        <Button Style="{StaticResource PrimaryButton}" Content="OK" Height="30" Margin="8,0,0,0"
                                MinWidth="56" IsDefault="True" Click="Ok_Click"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
