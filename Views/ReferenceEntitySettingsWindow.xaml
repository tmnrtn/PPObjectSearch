<Window x:Class="PPObjectSearch.Views.ReferenceEntitySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="{Binding Title}"
        Height="680" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <!-- A DataGrid column lives outside the visual tree, so it reaches the view model through this. -->
        <core:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="WHAT IDENTIFIES A ROW" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding SelectedKey}"
                          DisplayMemberPath="Label"
                          ToolTip="Primary ids only agree between environments where the rows were deployed rather than created separately." />

                <TextBlock Text="Tick the Key column below for each column the key is made of."
                           Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                           Visibility="{Binding IsCustomKey, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="ROW FILTER (ODATA, OPTIONAL)" Style="{StaticResource Label}" Margin="0,12,0,3" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Applied to both environments, e.g. statecode eq 0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="COLUMNS TO COMPARE" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding ColumnSearch, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button Content="All" MinWidth="0" Padding="12,5" Command="{Binding CompareAllCommand}"
                            ToolTip="Compare every column currently listed." />
                    <Button Content="None" MinWidth="0" Padding="12,5" Margin="6,0,0,0"
                            Command="{Binding CompareNoneCommand}" />
                    <Button Content="Defaults" MinWidth="0" Padding="12,5" Margin="6,0,0,0"
                            Command="{Binding ResetDefaultsCommand}"
                            ToolTip="Compare everything except the primary id and the created/modified/owner housekeeping columns." />
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding ColumnsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF0F3"
                      Background="{StaticResource Surface}"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{StaticResource Border}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                    <Style TargetType="TextBlock" x:Key="Cell">
                        <Setter Property="Margin" Value="8,6" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Compare" Binding="{Binding IsCompared, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80" />

                    <DataGridCheckBoxColumn Header="Key" Binding="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60"
                                            Visibility="{Binding Data.IsCustomKey, Source={StaticResource Proxy},
                                                                 Converter={StaticResource BoolToVis}}" />

                    <DataGridTextColumn Header="Column" Binding="{Binding LogicalName}" Width="*"
                                        IsReadOnly="True" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"
                                        IsReadOnly="True" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="140"
                                        IsReadOnly="True" ElementStyle="{StaticResource Cell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="OK" IsDefault="True" Click="Ok_Click"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                    <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
