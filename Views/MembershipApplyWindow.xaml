<Window x:Class="PPObjectSearch.Views.MembershipApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PPObjectSearch.ViewModels"
        Title="{Binding Title}"
        Style="{StaticResource DialogWindow}"
        Height="700" Width="1020"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ what, where, and whether -->
            <StackPanel Grid.Row="0" Margin="18,16,18,14">
                <TextBlock Text="{Binding Operation}" Style="{StaticResource WindowHeading}" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding SourceKind, StringFormat='Match {0}'}" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding SourceName}" FontSize="13" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="11" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Muted}" Margin="14,0,14,3" />

                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TargetKind, StringFormat='Changing {0}'}" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding TargetName}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="28,0,0,0">
                        <TextBlock Text="In" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EnvBar}" Height="16" Margin="0,0,7,0" Tag="{Binding Sku}" />
                            <TextBlock Text="{Binding EnvironmentName}" FontSize="13" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource EnvTypeBadge}" Margin="8,1,0,0" Tag="{Binding Sku}"
                                            Content="{Binding Sku, Converter={StaticResource SkuBadge}}" />
                            <TextBlock Text="{Binding EnvironmentHost}" Foreground="{DynamicResource Muted}" Margin="8,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- The write guard's verdict, green or red. -->
                <Border Margin="0,12,0,0" CornerRadius="4" Padding="10,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusCircle}">
                                    <Setter Property="Background" Value="{DynamicResource Green}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Surface}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="FontSize" Value="9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                                                <Setter Property="Text" Value="!" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run FontWeight="SemiBold">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="Writes permitted." />
                                        <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter Property="Text" Value="Writes blocked." />
                                                <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                            <Run Text="{Binding GuardMessage, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Banner}" Margin="0,8,0,0" Background="{DynamicResource AmberSoft}"
                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
                </Border>
            </StackPanel>

            <!-- ============================================================ what to do -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,14,18,14">
                <StackPanel>
                    <Grid IsEnabled="{Binding CanEditActions}"
                          Visibility="{Binding IsPerRow, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Style="{StaticResource ActionCard}" IsChecked="{Binding Add}">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="{Binding AddVerb, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                    <Run Text="{Binding AvailableAdds, Mode=OneWay, StringFormat=N0}" FontSize="13" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardText}" Text="{Binding SourceKind, StringFormat='Users in the {0} but not here'}" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Grid.Column="2" Style="{StaticResource ActionCard}" Tag="Danger"
                                  Background="{DynamicResource Red}" IsChecked="{Binding Remove}">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Remove" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Red}" />
                                    <Run Text="{Binding AvailableRemoves, Mode=OneWay, StringFormat=N0}" FontSize="13" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardText}" Text="{Binding SourceKind, StringFormat='Users here but not in the {0}'}" />
                            </StackPanel>
                        </CheckBox>
                    </Grid>

                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                               Visibility="{Binding IsForecast, Converter={StaticResource BoolToVis}}"
                               Text="Dataverse's own sync runs as one request and decides what changes. The list below is the forecast from comparing the team with the group; after the run, each row says whether it happened." />

                    <Border Padding="12,9" Background="{DynamicResource RedSoft}" CornerRadius="4"
                            Visibility="{Binding HasRemoves, Converter={StaticResource BoolToVis}}">
                        <CheckBox Style="{StaticResource DangerCheckBox}" IsChecked="{Binding RemoveAcknowledged}"
                                  IsEnabled="{Binding CanAcknowledge}" VerticalContentAlignment="Center">
                            <TextBlock Text="{Binding RemoveAcknowledgement}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </CheckBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================================ rows -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Rows}"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" HeaderStyle="{StaticResource FirstHeader}" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="16,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsEditable}"
                                          ToolTip="Untick to leave this user as they are" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Change" Width="96" SortMemberPath="Kind">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Margin="8,0,8,0" Content="{Binding Kind}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource PillGreen}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:MembershipChangeKind.Remove}">
                                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190" IsReadOnly="True"
                                        ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="UPN" Binding="{Binding Upn}" Width="200" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*" MinWidth="220" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}">
                                <Setter Property="ToolTip" Value="{Binding Reason}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultLabel}" Width="160" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellFaint}">
                                <Setter Property="ToolTip" Value="{Binding Result}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Margin="0,60,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Foreground="{DynamicResource Muted}" Text="No membership changes are expected."
                       Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}" />

            <!-- ============================================================ footer -->
            <Border Grid.Row="3" Style="{StaticResource Footer}" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding FooterText}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="Stop" Height="30" Margin="0,0,8,0"
                                Command="{Binding CancelRunCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Close" Height="30" Click="Close_Click" IsEnabled="{Binding IsNotRunning}" />

                        <Button Height="30" Margin="8,0,0,0" Content="{Binding ApplyLabel}"
                                Command="{Binding ApplyCommand}"
                                Visibility="{Binding HasRun, Converter={StaticResource NotBoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructiveApply}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBg}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
