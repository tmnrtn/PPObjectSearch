<Window x:Class="PPObjectSearch.Views.ReferenceDataCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:PPObjectSearch.Services"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="Compare reference data"
        Height="800" Width="1320"
        MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <!-- A DataGrid column lives outside the visual tree, so it reaches the view model through this. -->
        <core:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style TargetType="DataGridColumnHeader" x:Key="Head">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Cell">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="TextBlock" x:Key="MutedCell" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Environments, saved configuration and the run controls -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="SOURCE" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Source}"
                                  DisplayMemberPath="Title" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="TARGET" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Target}"
                                  DisplayMemberPath="Title" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Compare" Margin="0,16,0,0" VerticalAlignment="Bottom"
                            Command="{Binding CompareCommand}"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="2" Content="Cancel" Margin="0,16,0,0" VerticalAlignment="Bottom"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="3" Content="Export CSV" Margin="8,16,0,0" VerticalAlignment="Bottom"
                            MinWidth="100" Command="{Binding ExportCommand}" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0" MinWidth="200">
                        <TextBlock Text="SAVED CONFIGURATION" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Configurations}" SelectedItem="{Binding SelectedConfiguration}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="NAME" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding ConfigurationName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Save" MinWidth="0" Padding="12,5" Margin="0,16,0,0"
                            VerticalAlignment="Bottom" Command="{Binding SaveConfigurationCommand}"
                            ToolTip="Save these tables and settings under the name above." />
                    <Button Grid.Column="3" Content="New" MinWidth="0" Padding="12,5" Margin="6,16,0,0"
                            VerticalAlignment="Bottom" Command="{Binding NewConfigurationCommand}" />
                    <Button Grid.Column="4" Content="Delete" MinWidth="0" Padding="12,5" Margin="6,16,0,0"
                            VerticalAlignment="Bottom" Command="{Binding DeleteConfigurationCommand}" />

                    <CheckBox Grid.Column="6" Content="Match lookups by name" Margin="14,0,0,7"
                              VerticalAlignment="Bottom" IsChecked="{Binding MatchLookupsByName}"
                              ToolTip="Compare a lookup on the label it renders rather than the id behind it. Ids only agree where the target row was deployed." />

                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Bottom"
                                Margin="14,0,0,3">
                        <TextBlock Text="Row cap" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" />
                        <TextBox Text="{Binding MaxRowsPerEntity, UpdateSourceTrigger=LostFocus}"
                                 Width="70" Margin="6,0,0,0"
                                 ToolTip="Most rows read per table per environment. A table that hits the cap is reported as partial." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Configured tables | results | detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource Surface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="TABLES TO CHECK" Style="{StaticResource Label}"
                           Margin="12,12,12,6" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Entities}"
                         SelectedItem="{Binding SelectedEntity}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="Include this table in the next comparison." />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,2" />
                            <EventSetter Event="MouseDoubleClick" Handler="Entity_DoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8,12,12">
                    <Button Content="Add tables..." MinWidth="0" Padding="10,5"
                            Command="{Binding AddEntitiesCommand}" />
                    <Button Content="Settings..." MinWidth="0" Padding="10,5" Margin="6,0,0,0"
                            Command="{Binding EditEntityCommand}"
                            ToolTip="Key, row filter and which columns take part, for the selected table." />
                    <Button Content="Remove" MinWidth="0" Padding="10,5" Margin="6,0,0,0"
                            Command="{Binding RemoveEntityCommand}" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="240" MinHeight="90" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="TABLE" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding EntityFilters}"
                                  SelectedItem="{Binding SelectedEntityFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SEARCH" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Matches the key, the name and the list of differing columns." />
                    </StackPanel>

                    <CheckBox Grid.Column="2" Content="Show matching rows" Margin="14,0,0,7"
                              VerticalAlignment="Bottom" IsChecked="{Binding ShowMatches}" />
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF0F3"
                          Background="{StaticResource Surface}"
                          BorderThickness="0,1,0,0"
                          BorderBrush="{StaticResource Border}"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ColumnHeaderStyle="{StaticResource Head}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static svc:RecordCompareStatus.OnlyInSource}">
                                            <Setter Property="Foreground" Value="#B3261E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static svc:RecordCompareStatus.OnlyInTarget}">
                                            <Setter Property="Foreground" Value="#1F52C4" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static svc:RecordCompareStatus.Different}">
                                            <Setter Property="Foreground" Value="#9A6400" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static svc:RecordCompareStatus.Same}">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Table" Binding="{Binding EntityLogicalName}" Width="150"
                                            ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="230"
                                            ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                            ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="Differences" Binding="{Binding DifferenceCount}" Width="90"
                                            ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="Differing columns" Binding="{Binding DifferenceSummary}"
                                            Width="260" ElementStyle="{StaticResource MutedCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                              Background="{StaticResource Border}" />

                <Grid Grid.Row="3" Background="{StaticResource Surface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding DetailHeading}" Margin="16,10,16,8"
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DetailColumns}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF0F3"
                              Background="{StaticResource Surface}"
                              BorderThickness="0,1,0,0"
                              BorderBrush="{StaticResource Border}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ColumnHeaderStyle="{StaticResource Head}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                        <Setter Property="Background" Value="#FFF6E5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column" Binding="{Binding ColumnLabel}" Width="260"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="110"
                                                ElementStyle="{StaticResource MutedCell}" />
                            <DataGridTextColumn Header="{Binding Data.SourceHeader, Source={StaticResource Proxy}}"
                                                Binding="{Binding SourceValue}" Width="*"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="{Binding Data.TargetHeader, Source={StaticResource Proxy}}"
                                                Binding="{Binding TargetValue}" Width="*"
                                                ElementStyle="{StaticResource Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status, counts and anything that made the result partial -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Expander Margin="0,6,0,0" Foreground="#9A6400"
                          Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVis}}">
                    <Expander.Header>
                        <TextBlock>
                            <Run Text="{Binding Warnings.Count, Mode=OneWay}" />
                            <Run Text="warning(s) - the result may be partial" />
                        </TextBlock>
                    </Expander.Header>

                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,4" MaxHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"
                                           Foreground="{StaticResource TextPrimary}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
