<Window x:Class="PPObjectSearch.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PPObjectSearch.ViewModels"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="Compare environments"
        Style="{StaticResource AppWindow}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sides -->
            <Grid Grid.Row="0" Margin="16,14,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Style="{StaticResource EnvPicker}" Width="270"
                          core:Ui.InlineLabel="Left"
                          ItemsSource="{Binding Sessions}" SelectedItem="{Binding Left}" />

                <Button AutomationProperties.Name="Swap left and right" Grid.Column="1" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0"
                        Margin="6,0" FontFamily="{StaticResource IconFont}" FontSize="13"
                        Foreground="{DynamicResource Muted}" Content="&#xE8AB;"
                        ToolTip="Swap left and right" Command="{Binding SwapCommand}" />

                <ComboBox Grid.Column="2" Style="{StaticResource EnvPicker}" Width="270"
                          core:Ui.InlineLabel="Right"
                          ItemsSource="{Binding Sessions}" SelectedItem="{Binding Right}" />

                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Compare" Height="32"
                        Padding="16,0" Margin="8,0,0,0" Command="{Binding CompareCommand}" />

                <TextBlock Grid.Column="5" Text="{Binding ComparedAgo}" FontSize="11" Foreground="{DynamicResource Muted}"
                           VerticalAlignment="Center" Margin="12,0,8,0" />

                <Button Grid.Column="6" Content="Export CSV" Height="32" Command="{Binding ExportCommand}" />
            </Grid>

            <!-- Filters -->
            <Grid Grid.Row="1" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Segmented}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedToggle}" Content="All" GroupName="CompareStatus"
                                     core:Ui.DotBrush="{DynamicResource Muted}" core:Ui.Count="{Binding CountAll, StringFormat=N0}"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource SegmentedToggle}" Content="Only in left" GroupName="CompareStatus"
                                     core:Ui.DotBrush="{DynamicResource Red}" core:Ui.Count="{Binding CountOnlyLeft, StringFormat=N0}"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumEquals}, ConverterParameter=OnlyLeft}" />
                        <RadioButton Style="{StaticResource SegmentedToggle}" Content="Only in right" GroupName="CompareStatus"
                                     core:Ui.DotBrush="{DynamicResource Blue}" core:Ui.Count="{Binding CountOnlyRight, StringFormat=N0}"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumEquals}, ConverterParameter=OnlyRight}" />
                        <RadioButton Style="{StaticResource SegmentedToggle}" Content="In both" GroupName="CompareStatus"
                                     core:Ui.DotBrush="{DynamicResource Border2}" core:Ui.Count="{Binding CountBoth, StringFormat=N0}"
                                     ToolTip="Components present in both environments. Their definitions may still differ - use Diff on a row to see."
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Both}" />
                    </StackPanel>
                </Border>

                <ComboBox Grid.Column="1" MinWidth="120" MaxWidth="260" Height="30" Margin="8,0,0,0" Padding="7,0"
                          core:Ui.InlineLabel="Type" core:Ui.Placeholder="All types"
                          core:Ui.IsActive="{Binding SelectedTypeFilter.IsAll, Converter={StaticResource IsFalse}}"
                          ItemsSource="{Binding TypeFiltersView}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          Text="{Binding TypeFilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          DisplayMemberPath="Label" />

                <TextBox Grid.Column="2" Height="30" Margin="8,0,0,0"
                         core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Filter by name"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding RowsView}"
                      SelectedItem="{Binding SelectedRow}"
                      IsReadOnly="True"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="124" SortMemberPath="Status"
                                            HeaderStyle="{StaticResource FirstHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Margin="16,0,8,0" Content="{Binding StatusLabel}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CompareStatus.OnlyInLeft}">
                                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CompareStatus.OnlyInRight}">
                                                    <Setter Property="Background" Value="{DynamicResource BlueSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Blue}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CompareStatus.Same}">
                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Type" Width="200" SortMemberPath="ComponentTypeName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Cell}">
                                    <Run Text="{Binding ComponentTypeName, Mode=OneWay}" /><Run
                                         Text="{Binding SubType, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter=' · '}"
                                         Foreground="{DynamicResource Muted}" />
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="124" SortMemberPath="LeftModified"
                                        Binding="{Binding LeftModified, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=—}"
                                        ElementStyle="{StaticResource CellMuted}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource EnvBar}" Height="11" Margin="0,0,5,0"
                                        Tag="{Binding DataContext.ComparedLeft.EnvironmentSku, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <TextBlock Text="{Binding DataContext.ComparedLeft.Title, RelativeSource={RelativeSource AncestorType=DataGrid}, StringFormat={}{0} modified, FallbackValue=Left modified}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="96" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Width="124" SortMemberPath="RightModified"
                                        Binding="{Binding RightModified, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=—}"
                                        ElementStyle="{StaticResource CellMuted}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource EnvBar}" Height="11" Margin="0,0,5,0"
                                        Tag="{Binding DataContext.ComparedRight.EnvironmentSku, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <TextBlock Text="{Binding DataContext.ComparedRight.Title, RelativeSource={RelativeSource AncestorType=DataGrid}, StringFormat={}{0} modified, FallbackValue=Right modified}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="96" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- Only meaningful where both sides have the component to compare. -->
                    <DataGridTemplateColumn Header="Definition" Width="84">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Margin="8,0" HorizontalAlignment="Left"
                                        ToolTip="Show this component's definition in both environments side by side."
                                        Visibility="{Binding ExistsOnBothSides, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.CompareDefinitionCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Diff" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="9" Margin="5,1,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource StatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MatchDescription}" Foreground="{DynamicResource Muted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                    <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
