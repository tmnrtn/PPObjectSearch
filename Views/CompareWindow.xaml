<Window x:Class="PPObjectSearch.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PPObjectSearch.ViewModels"
        Title="Compare environments"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="LEFT" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Left}"
                                  DisplayMemberPath="Title" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="RIGHT" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Right}"
                                  DisplayMemberPath="Title" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Compare" Margin="0,16,0,0" VerticalAlignment="Bottom"
                            Command="{Binding CompareCommand}" />

                    <CheckBox Grid.Column="3" Content="Show identical" Margin="14,0,0,8"
                              VerticalAlignment="Bottom" IsChecked="{Binding ShowIdentical}" />

                    <Button Grid.Column="4" Content="Export CSV" Margin="14,16,0,0" VerticalAlignment="Bottom"
                            MinWidth="100" Command="{Binding ExportCommand}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0" MinWidth="250">
                        <TextBlock Text="OBJECT TYPE" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding TypeFiltersView}"
                                  SelectedItem="{Binding SelectedTypeFilter}"
                                  Text="{Binding TypeFilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  DisplayMemberPath="Label" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SEARCH" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding RowsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF0F3"
                  Background="{StaticResource Surface}"
                  BorderThickness="0"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style TargetType="TextBlock" x:Key="Cell">
                    <Setter Property="Margin" Value="8,6" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <Style TargetType="TextBlock" x:Key="MutedCell" BasedOn="{StaticResource Cell}">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CompareStatus.OnlyInLeft}">
                                    <Setter Property="Foreground" Value="#B3261E" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CompareStatus.OnlyInRight}">
                                    <Setter Property="Foreground" Value="#1F52C4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CompareStatus.Same}">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                    ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Object type" Binding="{Binding ComponentTypeName}" Width="170"
                                    ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Sub type" Binding="{Binding SubType}" Width="140"
                                    ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Left modified"
                                    Binding="{Binding LeftModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="140" ElementStyle="{StaticResource MutedCell}" />
                <DataGridTextColumn Header="Right modified"
                                    Binding="{Binding RightModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="140" ElementStyle="{StaticResource MutedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
