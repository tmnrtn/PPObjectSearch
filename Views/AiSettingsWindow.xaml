<Window x:Class="PPObjectSearch.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        Title="Ask AI settings"
        Style="{StaticResource DialogWindow}"
        Width="640" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- A provider's own settings, under the cards. -->
        <Style TargetType="Grid" x:Key="ProviderFields">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock" x:Key="CardNote">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock" x:Key="CardCan" BasedOn="{StaticResource CardNote}">
            <Setter Property="Foreground" Value="{DynamicResource Green}" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBody}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Height="30" IsCancel="True" />
                    <Button Content="Save" Height="30" Margin="8,0,0,0" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,18">
                    <!-- ============================================ on or off -->
                    <DockPanel Margin="0,0,0,16">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Ask AI on">
                            <TextBlock Text="On" Foreground="{DynamicResource Muted}" />
                        </CheckBox>
                        <StackPanel>
                            <TextBlock Style="{StaticResource WindowHeading}" Text="Ask AI" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                                       Text="Questions are sent with the screen you ask about, as text." />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel IsEnabled="{Binding IsEnabled}">
                        <!-- ============================================ provider -->
                        <TextBlock Style="{StaticResource Label}" Text="WHERE QUESTIONS GO" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource CardRadio}" IsChecked="{Binding IsClaudeCode}" Margin="0,0,4,8">
                                <StackPanel>
                                    <TextBlock Text="My Claude subscription" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource CardNote}" Text="Through Claude Code, signed in on this PC" />
                                    <TextBlock Style="{StaticResource CardNote}" Text="Answers from this screen only" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource CardRadio}" IsChecked="{Binding IsAnthropic}" Margin="4,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Claude API key" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource CardNote}" Text="Billed to your Claude Console account" />
                                    <TextBlock Style="{StaticResource CardCan}" Text="Reads other screens and searches objects" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource CardRadio}" IsChecked="{Binding IsOpenRouter}" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="OpenRouter" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource CardNote}" Text="Any model, your OpenRouter key" />
                                    <TextBlock Style="{StaticResource CardCan}" Text="Reads other screens with models that use tools" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource CardRadio}" IsChecked="{Binding IsOllama}" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ollama" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource CardNote}" Text="A local server, so nothing leaves your network" />
                                    <TextBlock Style="{StaticResource CardCan}" Text="Reads other screens with models that use tools" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- The chosen provider's own settings, in one framed group with Test at its foot. -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,4,14,14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <!-- Claude Code -->
                                <Grid Style="{StaticResource ProviderFields}" Visibility="{Binding IsClaudeCode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource CardNote}" Margin="0,0,0,10"
                                               Text="Runs the Claude Code you have installed, signed in to your Claude account - run claude in a terminal once to sign in. This app never sees your sign-in. Claude Code gets no tools, so it answers from the screen alone." />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Model" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding ClaudeCodeModels}"
                                              Text="{Binding ClaudeCodeModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Claude Code model"
                                              ToolTip="An alias such as opus or sonnet, or a full model name. Blank uses Claude Code's own choice." />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Where claude is" Margin="0,8,12,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ClaudeCodePath, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Where claude is"
                                             core:Ui.Placeholder="Found on the PATH, or where the installer puts it" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ClaudeCodeFound}" Style="{StaticResource CardNote}" Margin="0,4,0,0" />
                                </Grid>

                                <!-- Claude API -->
                                <Grid Style="{StaticResource ProviderFields}" Visibility="{Binding IsAnthropic, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Model" />
                                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding AnthropicModels}"
                                              Text="{Binding AnthropicModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Claude API model" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="API key" Margin="0,8,12,0" />
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <DockPanel Visibility="{Binding HasAnthropicKey, Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right" Content="Remove" Margin="6,0,0,0" Foreground="{DynamicResource Red}"
                                                    Command="{Binding RemoveKeyCommand}" CommandParameter="Anthropic" />
                                            <Button DockPanel.Dock="Right" Content="Replace" Margin="6,0,0,0"
                                                    Command="{Binding ReplaceKeyCommand}" CommandParameter="Anthropic" />
                                            <Border BorderBrush="{DynamicResource Border2}" BorderThickness="1" CornerRadius="4" Padding="9,0" Height="28">
                                                <TextBlock Text="Saved, encrypted for your Windows account" Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DockPanel>
                                        <PasswordBox x:Name="AnthropicKeyBox" PasswordChanged="AnthropicKey_Changed"
                                                     AutomationProperties.Name="Claude API key"
                                                     Visibility="{Binding HasAnthropicKey, Converter={StaticResource NotBoolToVis}}" />
                                    </Grid>
                                </Grid>

                                <!-- OpenRouter -->
                                <Grid Style="{StaticResource ProviderFields}" Visibility="{Binding IsOpenRouter, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Model" />
                                    <DockPanel Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="Load models" Margin="6,0,0,0"
                                                Command="{Binding LoadOpenRouterModelsCommand}" ToolTip="Read OpenRouter's list of models" />
                                        <ComboBox IsEditable="True" ItemsSource="{Binding OpenRouterModels}" AutomationProperties.Name="OpenRouter model"
                                                  Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelsStatus}" Style="{StaticResource CardNote}" Margin="0,4,0,0"
                                               Visibility="{Binding ModelsStatus, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="API key" Margin="0,8,12,0" />
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                        <DockPanel Visibility="{Binding HasOpenRouterKey, Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right" Content="Remove" Margin="6,0,0,0" Foreground="{DynamicResource Red}"
                                                    Command="{Binding RemoveKeyCommand}" CommandParameter="OpenRouter" />
                                            <Button DockPanel.Dock="Right" Content="Replace" Margin="6,0,0,0"
                                                    Command="{Binding ReplaceKeyCommand}" CommandParameter="OpenRouter" />
                                            <Border BorderBrush="{DynamicResource Border2}" BorderThickness="1" CornerRadius="4" Padding="9,0" Height="28">
                                                <TextBlock Text="Saved, encrypted for your Windows account" Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DockPanel>
                                        <PasswordBox x:Name="OpenRouterKeyBox" PasswordChanged="OpenRouterKey_Changed"
                                                     AutomationProperties.Name="OpenRouter API key"
                                                     Visibility="{Binding HasOpenRouterKey, Converter={StaticResource NotBoolToVis}}" />
                                    </Grid>
                                </Grid>

                                <!-- Ollama -->
                                <Grid Style="{StaticResource ProviderFields}" Visibility="{Binding IsOllama, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Server" />
                                    <TextBox Grid.Column="1" Text="{Binding OllamaUrl, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Ollama server" core:Ui.Placeholder="http://localhost:11434" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Model" Margin="0,8,12,0" />
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Load models" Margin="6,0,0,0"
                                                Command="{Binding LoadOllamaModelsCommand}" ToolTip="Read the models the server has" />
                                        <ComboBox IsEditable="True" ItemsSource="{Binding OllamaModels}" AutomationProperties.Name="Ollama model"
                                                  Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OllamaStatus}" Style="{StaticResource CardNote}" Margin="0,4,0,0"
                                               Visibility="{Binding OllamaStatus, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Context length" Margin="0,8,12,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Width="120" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Context length in tokens"
                                             Text="{Binding OllamaContextLength, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource CardNote}" Margin="0,4,0,0"
                                               Text="Tokens the model reads at once. A busy screen needs 30,000 or more; Ollama's own default is far less, and would cut the screen short. Longer needs more memory." />
                                </Grid>

                                <TextBlock Style="{StaticResource CardNote}" Margin="0,10,0,0" Text="Choose where questions go, above."
                                           Visibility="{Binding HasProvider, Converter={StaticResource NotBoolToVis}}" />

                                <!-- Test, beside what it tests. -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                            Visibility="{Binding HasProvider, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Test connection" Command="{Binding TestCommand}"
                                            ToolTip="Ask the chosen model one short question, with these settings, saved or not" />
                                    <Border Margin="10,0,0,0" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" MaxWidth="400"
                                            Visibility="{Binding TestResult, Converter={StaticResource EmptyToCollapsed}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestFailed}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Hover}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TestFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============================================ environments -->
                        <DockPanel Margin="0,18,0,6">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource CardNote}" Text="Production starts off" VerticalAlignment="Bottom" />
                            <TextBlock Style="{StaticResource Label}" Text="ENVIRONMENTS ASK AI MAY READ" Margin="0" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource CardNote}" Margin="0,0,0,8"
                                   Text="A screen showing an environment that's off is never sent, and Ask AI's tools pass over it. Production environments, and any whose type couldn't be read, start off; every other starts allowed." />
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasEnvironments, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Environments}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsAllowed}"
                                                          VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Ask AI may read {0}}">
                                                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                                </CheckBox>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource EnvBar}" Width="3" Height="24" Margin="0,0,10,0"
                                                        Tag="{Binding Sku}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Style="{StaticResource CardNote}" Text="No environments open yet."
                                   Visibility="{Binding HasEnvironments, Converter={StaticResource NotBoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
