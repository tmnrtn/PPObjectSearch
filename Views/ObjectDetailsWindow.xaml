<Window x:Class="PPObjectSearch.Views.ObjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Cell">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- For cells whose text is routinely wider than any sensible column: a form's XML, a
             flattened property path. The tooltip is the cell's own text, so nothing is lost. -->
        <Style TargetType="TextBlock" x:Key="CellFull" BasedOn="{StaticResource Cell}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F3" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Item.PrimaryLabel}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Item.ComponentTypeName}" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding Item.ManagedLabel}" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}"
                                   Visibility="{Binding LayersSupported, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Foreground="{StaticResource TextMuted}"
                                   Visibility="{Binding LayersSupported, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="No unmanaged layer" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnmanagedLayer}" Value="True">
                                            <Setter Property="Text" Value="Has unmanaged layer" />
                                            <Setter Property="Foreground" Value="#B45309" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding Item.ObjectId}" Foreground="{StaticResource TextMuted}"
                                   FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="Open in maker" Padding="12,6" MinWidth="0"
                        VerticalAlignment="Center" Command="{Binding OpenLinkCommand}" />
                <Button Grid.Column="2" Content="Refresh" Padding="12,6" MinWidth="0" Margin="8,0,0,0"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Containing solutions + component layers -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionHeading}"
                               Text="Solutions containing this object" />
                    <DataGrid ItemsSource="{Binding Solutions}" MaxHeight="170">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Solution" Binding="{Binding FriendlyName}" Width="*"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Unique name" Binding="{Binding UniqueName}" Width="150"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="90"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"
                                                ElementStyle="{StaticResource Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel Grid.Column="2" Visibility="{Binding LayersSupported, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeading}"
                               Text="Component layers (top of stack first)"
                               ToolTip="Every solution layering this component, the one actually in effect first. 'Unmanaged (Active)' is the single environment-wide layer shared by all unmanaged customizations." />
                    <DataGrid ItemsSource="{Binding Layers}" MaxHeight="170"
                              SelectedItem="{Binding SelectedLayer}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="*"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Publisher" Binding="{Binding PublisherName}" Width="110"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="120"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Changes" Binding="{Binding ChangeSummary}" Width="90"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" Padding="8,2" MinWidth="0" Margin="4,2"
                                                ToolTip="Show the properties this layer changed, against the layer beneath it."
                                                Command="{Binding DataContext.ViewLayerChangesCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                    </Style>
                </TabControl.Resources>

                <!-- Dependencies, both directions -->
                <TabItem Header="Dependencies">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeading}"
                                       Text="Depends on this (blocks deletion)"
                                       ToolTip="Components that would break if this object were deleted." />
                            <DataGrid ItemsSource="{Binding Dependents}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"
                                                        ElementStyle="{StaticResource Cell}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding ComponentTypeName}" Width="150"
                                                        ElementStyle="{StaticResource Cell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeading}"
                                       Text="Required by this"
                                       ToolTip="Components this object needs in order to work." />
                            <DataGrid ItemsSource="{Binding Required}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"
                                                        ElementStyle="{StaticResource Cell}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding ComponentTypeName}" Width="150"
                                                        ElementStyle="{StaticResource Cell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- What the table owns - only a table has any of this, and when it does, it is
                     what the window was most likely opened for, so it starts selected. -->
                <TabItem Header="Table components"
                         Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}"
                         IsSelected="{Binding IsTable, Mode=OneTime}">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" MinWidth="130" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.3*" MinWidth="200" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeading}" Text="Owned by this table" />
                            <ListBox ItemsSource="{Binding ChildGroups}" SelectedItem="{Binding SelectedChildGroup}"
                                     Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}"
                                                       Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch"
                                      Background="Transparent" />

                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding SelectedChildGroup.Label}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Filter" Style="{StaticResource Label}" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBox Text="{Binding ChildFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                         ToolTip="Narrows this list by name, display name or detail." />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedChild}"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                                        ElementStyle="{StaticResource CellFull}" />
                                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"
                                                        ElementStyle="{StaticResource CellFull}" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="160"
                                                        ElementStyle="{StaticResource CellFull}" />
                                    <DataGridTextColumn Header="State" Binding="{Binding ManagedLabel}" Width="90"
                                                        ElementStyle="{StaticResource Cell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Column="3" Width="12" HorizontalAlignment="Stretch"
                                      Background="Transparent" />

                        <DockPanel Grid.Column="4">
                            <TextBlock DockPanel.Dock="Top" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
                                        <Setter Property="Text"
                                                Value="{Binding SelectedChild.PrimaryLabel, StringFormat='Properties of {0}'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChild}" Value="{x:Null}">
                                                <Setter Property="Text" Value="Properties" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ProgressBar DockPanel.Dock="Top" Height="3" IsIndeterminate="True" BorderThickness="0"
                                         Margin="0,0,0,4"
                                         Visibility="{Binding IsLoadingProperties, Converter={StaticResource BoolToVis}}" />

                            <Grid>
                                <DataGrid ItemsSource="{Binding ChildProperties}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="200"
                                                            ElementStyle="{StaticResource CellFull}" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"
                                                            ElementStyle="{StaticResource CellFull}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Sits over the empty grid rather than below it, so the reason
                                     there is nothing to show is where the rows would have been. -->
                                <TextBlock Text="{Binding ChildStatus}" Foreground="{StaticResource TextMuted}"
                                           Margin="12,34,12,0" TextWrapping="Wrap" VerticalAlignment="Top"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
