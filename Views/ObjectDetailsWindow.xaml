<Window x:Class="PPObjectSearch.Views.ObjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        xmlns:core="clr-namespace:PPObjectSearch.Core"
        xmlns:models="clr-namespace:PPObjectSearch.Models"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- DataGrid columns are outside the visual tree; this carries the window's view model to them. -->
        <core:BindingProxy x:Key="WindowProxy" Data="{Binding}" />

        <!-- For cells whose text is routinely wider than any sensible column: a form's XML, a
             flattened property path. The tooltip is the cell's own text, so nothing is lost. -->
        <Style TargetType="TextBlock" x:Key="CellFull" BasedOn="{StaticResource Cell}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="CellFullFirst" BasedOn="{StaticResource CellFull}">
            <Setter Property="Margin" Value="12,0,8,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="CellMonoFull" BasedOn="{StaticResource CellMono}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="CellMonoFullFirst" BasedOn="{StaticResource CellMonoFull}">
            <Setter Property="Margin" Value="12,0,8,0" />
        </Style>
        <Style TargetType="DataGridColumnHeader" x:Key="PaneFirstHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="12,0,8,0" />
        </Style>

        <!-- A pane's heading row: 36 tall, heading at left, extras at right. -->
        <Style TargetType="Border" x:Key="PaneHeading">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- Content comes from the caller; the colour from the Outcome of the row it sits in. -->
        <Style TargetType="ContentControl" x:Key="OutcomePill" BasedOn="{StaticResource StatusPill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:RunOutcome.Succeeded}">
                    <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:RunOutcome.Failed}">
                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:RunOutcome.Running}">
                    <Setter Property="Background" Value="{DynamicResource BlueSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:RunOutcome.Other}">
                    <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="DetailKey">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="DetailValue">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="DataGridRow" x:Key="CopyRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================ header -->
            <Grid Grid.Row="0" Margin="18,14,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Item.PrimaryLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
                        <Run Text="{Binding Item.SecondaryLabel, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource Muted}" />
                    </TextBlock>

                    <WrapPanel Margin="0,6,0,0">
                        <ContentControl Style="{StaticResource Chip}" Margin="0,0,4,0">
                            <TextBlock>
                                <Run Text="{Binding Item.ComponentTypeName, Mode=OneWay}" /><Run
                                     Text="{Binding Item.SubType, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter=' · '}" />
                            </TextBlock>
                        </ContentControl>
                        <ContentControl Style="{StaticResource Chip}" Margin="0,0,4,0" Content="{Binding Item.ManagedLabel}" />
                        <ContentControl Margin="0,0,4,0"
                                        Visibility="{Binding LayersSupported, Converter={StaticResource BoolToVis}}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Content" Value="No unmanaged layer" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnmanagedLayer}" Value="True">
                                            <Setter Property="Content" Value="Has unmanaged layer" />
                                            <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AmberSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <TextBlock Text="{Binding Item.ObjectId}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="Copy" Height="20" Padding="4,0" Margin="2,0,0,0"
                                FontSize="11" Command="{Binding CopyIdCommand}" ToolTip="Copy the object id" />

                        <!-- Tables only: an exact row count, found by probing pages rather than reading every row. -->
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                    Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource RowButton}" Content="{Binding CountButtonLabel}"
                                    Command="{Binding CountRowsCommand}"
                                    ToolTip="An exact, current count: one aggregate request up to 50,000 rows, and beyond that a search for the last page of 5,000 - a couple of dozen requests even for millions of rows. The number shown before counting is Dataverse's stored count, refreshed about daily." />
                            <TextBlock Text="{Binding RowCountText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="{Binding RowCountDetail}" />
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Amber}"
                                       Margin="6,0,0,0" ToolTip="{Binding RowCountWarning}"
                                       Visibility="{Binding RowCountWarning, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource PrimaryButton}" Content="Open in maker portal" Height="30"
                            Command="{Binding OpenLinkCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Height="30" Width="30" Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}" ToolTip="Read everything again" />
                </StackPanel>
            </Grid>

            <!-- ============================================================ tabs -->
            <Grid Grid.Row="1">
                <TabControl>
                    <!-- Containing solutions + component layers -->
                    <TabItem Header="Solutions &amp; layers" core:Ui.Count="{Binding SolutionsTabCount}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                                    <TextBlock Style="{StaticResource SectionHeading}" VerticalAlignment="Center"
                                               Text="Solutions containing this object" />
                                </Border>
                                <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding Solutions}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Solution" Binding="{Binding FriendlyName}" Width="*"
                                                            HeaderStyle="{StaticResource PaneFirstHeader}"
                                                            ElementStyle="{StaticResource CellFullFirst}" />
                                        <DataGridTextColumn Header="Unique name" Binding="{Binding UniqueName}" Width="150"
                                                            ElementStyle="{StaticResource CellMonoFull}" />
                                        <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="84"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="76"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <DockPanel Grid.Column="1"
                                       Visibility="{Binding LayersSupported, Converter={StaticResource BoolToVis}}">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}" BorderThickness="1,0,0,1">
                                    <TextBlock VerticalAlignment="Center"
                                               ToolTip="Every solution layering this component, the one actually in effect first. 'Unmanaged (Active)' is the single environment-wide layer shared by all unmanaged customizations.">
                                        <Run Text="Component layers" FontWeight="SemiBold" />
                                        <Run Text=" top of stack first" FontSize="11" Foreground="{DynamicResource Faint}" />
                                    </TextBlock>
                                </Border>
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                    <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding Layers}"
                                              SelectedItem="{Binding SelectedLayer}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Solution" Width="*" SortMemberPath="SolutionName"
                                                                    HeaderStyle="{StaticResource PaneFirstHeader}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="12,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse x:Name="LayerDot" Style="{StaticResource Dot}" Margin="0,1,7,0" />
                                                            <TextBlock x:Name="LayerName" Text="{Binding SolutionName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnmanagedLayer}" Value="True">
                                                                <Setter TargetName="LayerDot" Property="Fill" Value="{DynamicResource Amber}" />
                                                                <Setter TargetName="LayerName" Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Publisher" Binding="{Binding PublisherName}" Width="100"
                                                                ElementStyle="{StaticResource CellMuted}" />
                                            <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="120"
                                                                ElementStyle="{StaticResource Cell}" />
                                            <DataGridTextColumn Header="Changes" Binding="{Binding ChangeSummary}" Width="70"
                                                                ElementStyle="{StaticResource CellMuted}" />
                                            <DataGridTemplateColumn Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource RowButton}" Content="View" Margin="8,0"
                                                                HorizontalAlignment="Left"
                                                                ToolTip="Show the properties this layer changed, against the layer beneath it."
                                                                Command="{Binding DataContext.ViewLayerChangesCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- Dependencies, both directions -->
                    <TabItem Header="Dependencies" core:Ui.Count="{Binding DependencyCount, StringFormat=N0}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                                    <TextBlock Style="{StaticResource SectionHeading}" VerticalAlignment="Center"
                                               Text="Depends on this (blocks deletion)"
                                               ToolTip="Components that would break if this object were deleted." />
                                </Border>
                                <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding Dependents}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"
                                                            HeaderStyle="{StaticResource PaneFirstHeader}"
                                                            ElementStyle="{StaticResource CellFullFirst}" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding ComponentTypeName}" Width="150"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <DockPanel Grid.Column="1">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}" BorderThickness="1,0,0,1">
                                    <TextBlock Style="{StaticResource SectionHeading}" VerticalAlignment="Center"
                                               Text="Required by this"
                                               ToolTip="Components this object needs in order to work." />
                                </Border>
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                    <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding Required}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"
                                                                HeaderStyle="{StaticResource PaneFirstHeader}"
                                                                ElementStyle="{StaticResource CellFullFirst}" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding ComponentTypeName}" Width="150"
                                                                ElementStyle="{StaticResource CellMuted}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- An environment variable as this environment resolves it. -->
                    <TabItem Header="Value"
                             Visibility="{Binding IsEnvironmentVariable, Converter={StaticResource BoolToVis}}"
                             IsSelected="{Binding IsEnvironmentVariable, Mode=OneTime}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14,18,18" MaxWidth="900">
                                <TextBlock Text="{Binding EnvironmentVariableStatus}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />

                                <Grid DataContext="{Binding EnvironmentVariable}"
                                      Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Schema name" Style="{StaticResource DetailKey}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}"
                                               FontFamily="{StaticResource MonoFont}" Text="{Binding SchemaName}" />

                                    <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource DetailKey}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding TypeLabel}" />

                                    <TextBlock Grid.Row="2" Text="Description" Style="{StaticResource DetailKey}"
                                               Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Description}"
                                               Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}" />

                                    <TextBlock Grid.Row="3" Text="Current value" Style="{StaticResource DetailKey}" Margin="0,8,10,6" />
                                    <Border Grid.Row="3" Grid.Column="1" Margin="0,6,0,8" BorderBrush="{DynamicResource Border2}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <TextBox Style="{StaticResource CodeBox}" Text="{Binding CurrentValue, Mode=OneWay}"
                                                     TextWrapping="Wrap" MaxHeight="220" Background="Transparent"
                                                     Visibility="{Binding HasCurrentValue, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="Not set in this environment" Foreground="{DynamicResource Faint}" Margin="10,8"
                                                       Visibility="{Binding HasCurrentValue, Converter={StaticResource NotBoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="4" Text="Default value" Style="{StaticResource DetailKey}" Margin="0,8,10,6" />
                                    <Border Grid.Row="4" Grid.Column="1" Margin="0,6,0,8" BorderBrush="{DynamicResource Border2}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <TextBox Style="{StaticResource CodeBox}" Text="{Binding DefaultValue, Mode=OneWay}"
                                                     TextWrapping="Wrap" MaxHeight="220" Background="Transparent"
                                                     Visibility="{Binding DefaultValue, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="No default" Foreground="{DynamicResource Faint}" Margin="10,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DefaultValue}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                               Text="A secret holds an Azure Key Vault reference, not the secret itself. The value is resolved by Key Vault at run time."
                                               Visibility="{Binding IsSecret, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- A cloud flow drawn as the designer draws it. Read-only. -->
                    <TabItem Header="Design" Visibility="{Binding IsCloudFlow, Converter={StaticResource BoolToVis}}"
                             IsSelected="{Binding IsDesignTabSelected}">
                        <Grid>
                            <TextBlock Text="{Binding DesignStatus}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Margin="24,60,24,0"
                                       Visibility="{Binding HasFlowDiagram, Converter={StaticResource NotBoolToVis}}" />
                            <local:FlowDiagramView DataContext="{Binding FlowDiagram}"
                                                   Visibility="{Binding DataContext.HasFlowDiagram, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </TabItem>

                    <!-- A web resource's source, or a cloud flow's JSON definition. -->
                    <TabItem Header="{Binding SourceTabHeader}"
                             Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}"
                             IsSelected="{Binding IsWebResource, Mode=OneTime}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallButton}" Content="Copy" Command="{Binding CopySourceCommand}" />
                                        <Button Style="{StaticResource SmallButton}" Content="Save as..." Margin="6,0,0,0"
                                                Command="{Binding SaveSourceCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SourceStatus}" Foreground="{DynamicResource Muted}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SourceStatus}" />
                                </DockPanel>
                            </Border>
                            <local:CodeView Code="{Binding SourceText}" Syntax="{Binding SourceLanguage}" />
                        </DockPanel>
                    </TabItem>

                    <!-- A process's runs: cloud flow runs from flowrun, classic workflow system jobs.
                         What a flow is usually opened for, so it starts selected. -->
                    <TabItem Header="Run history" core:Ui.Count="{Binding RunsTabCount}"
                             Visibility="{Binding HasRunHistory, Converter={StaticResource BoolToVis}}"
                             IsSelected="{Binding HasRunHistory, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" MinWidth="360" />
                                <ColumnDefinition Width="*" MinWidth="280" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                                    <TextBlock Text="{Binding RunsStatus}" Foreground="{DynamicResource Muted}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RunsStatus}" />
                                </Border>
                                <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding Runs}"
                                          SelectedItem="{Binding SelectedRun}" SelectionMode="Single" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="Status"
                                                                HeaderStyle="{StaticResource PaneFirstHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Style="{StaticResource OutcomePill}" Margin="12,0,8,0"
                                                                    Content="{Binding Status}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Started" Width="140" SortMemberPath="StartTime"
                                                            Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                        <DataGridTextColumn Header="Duration" Width="76" SortMemberPath="DurationMs"
                                                            Binding="{Binding DurationLabel}" ElementStyle="{StaticResource CellMuted}" />
                                        <DataGridTextColumn Header="Trigger" Width="110" Binding="{Binding TriggerType}"
                                                            ElementStyle="{StaticResource CellFull}" />
                                        <DataGridTextColumn Header="Error" Width="*" Binding="{Binding ErrorMessage}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellFull}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="86" CanUserSort="False"
                                                                Visibility="{Binding Data.IsCloudFlow, Source={StaticResource WindowProxy}, Converter={StaticResource BoolToVis}}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource RowButton}" Margin="8,0" HorizontalAlignment="Left"
                                                            ToolTip="Show this run on the flow's diagram, step by step"
                                                            Command="{Binding DataContext.ShowRunOnDiagramCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Diagram" />
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="9" Margin="5,1,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="72" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource RowButton}" Margin="8,0" HorizontalAlignment="Left"
                                                            ToolTip="Open this run in Power Automate"
                                                            Visibility="{Binding HasPortalUrl, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.OpenRunCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Open" />
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="9" Margin="5,1,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- The selected run -->
                            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <TextBlock Text="Select a run to see its details." Foreground="{DynamicResource Faint}"
                                               Margin="16,14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRun}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <DockPanel DataContext="{Binding SelectedRun}"
                                               Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}">
                                        <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Style="{StaticResource OutcomePill}" Content="{Binding Status}" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" HorizontalAlignment="Left"
                                                    Content="Show on diagram"
                                                    Visibility="{Binding DataContext.IsCloudFlow, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ShowRunOnDiagramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Draw this run on the flow's diagram: each step's outcome, duration and error" />
                                            <Button Margin="0" HorizontalAlignment="Left"
                                                    Content="Open run in Power Automate"
                                                    Visibility="{Binding HasPortalUrl, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding PortalUrl}" />
                                            </StackPanel>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="Started" Style="{StaticResource DetailKey}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}"
                                                           Text="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                <TextBlock Grid.Row="1" Text="Ended" Style="{StaticResource DetailKey}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}"
                                                           Text="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=—}" />
                                                <TextBlock Grid.Row="2" Text="Duration" Style="{StaticResource DetailKey}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}"
                                                           Text="{Binding DurationLabel}" />
                                                <TextBlock Grid.Row="3" Text="Trigger" Style="{StaticResource DetailKey}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}"
                                                           Text="{Binding TriggerType, TargetNullValue=—}" />
                                                <TextBlock Grid.Row="4" Text="Regarding" Style="{StaticResource DetailKey}"
                                                           Visibility="{Binding Regarding, Converter={StaticResource EmptyToCollapsed}}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}"
                                                           Text="{Binding Regarding}"
                                                           Visibility="{Binding Regarding, Converter={StaticResource EmptyToCollapsed}}" />
                                                <TextBlock Grid.Row="5" Text="Error code" Style="{StaticResource DetailKey}"
                                                           Visibility="{Binding ErrorCode, Converter={StaticResource EmptyToCollapsed}}" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}"
                                                           FontFamily="{StaticResource MonoFont}" Text="{Binding ErrorCode}"
                                                           Visibility="{Binding ErrorCode, Converter={StaticResource EmptyToCollapsed}}" />
                                            </Grid>
                                        </StackPanel>

                                        <DockPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                            <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}"
                                                    BorderThickness="0,1,0,1" Background="{DynamicResource Surface2}">
                                                <TextBlock Text="Error" Style="{StaticResource SectionHeading}"
                                                           Foreground="{DynamicResource Red}" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBox Style="{StaticResource CodeBox}" Text="{Binding ErrorMessage, Mode=OneWay}"
                                                     TextWrapping="Wrap" Background="{DynamicResource Surface}" />
                                        </DockPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- A plug-in's trace log: its trace text and any exception, per execution. -->
                    <TabItem Header="Trace log" core:Ui.Count="{Binding TraceTabCount}"
                             Visibility="{Binding HasTraceLog, Converter={StaticResource BoolToVis}}"
                             IsSelected="{Binding HasTraceLog, Mode=OneTime}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" MinWidth="380" />
                                <ColumnDefinition Width="*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <!-- Tracing off: nothing new will appear until it is turned on. -->
                            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Banner}" Margin="12,10,12,2"
                                    Visibility="{Binding IsTraceOff, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Plug-in tracing is off in this environment." FontWeight="SemiBold"
                                         Foreground="{DynamicResource Amber}" />
                                    <Run Text="Only entries written before it was turned off are shown. Turn it on under Settings &gt; Administration &gt; System settings &gt; Customization." />
                                </TextBlock>
                            </Border>

                            <DockPanel Grid.Row="1" Grid.Column="0">
                                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                                    <TextBlock Text="{Binding TraceStatus}" Foreground="{DynamicResource Muted}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TraceStatus}" />
                                </Border>
                                <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding TraceEntries}"
                                          SelectedItem="{Binding SelectedTrace}" SelectionMode="Single" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Result" Width="96" SortMemberPath="HasException"
                                                                HeaderStyle="{StaticResource PaneFirstHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Style="{StaticResource OutcomePill}" Margin="12,0,8,0"
                                                                    Content="{Binding OutcomeLabel}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="When" Width="140" SortMemberPath="CreatedOn"
                                                            Binding="{Binding CreatedOn, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                        <DataGridTextColumn Header="Plug-in" Width="*" Binding="{Binding ShortTypeName}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellMono}">
                                                    <Setter Property="ToolTip" Value="{Binding TypeName}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Message" Width="90" Binding="{Binding MessageName}"
                                                            ElementStyle="{StaticResource Cell}" />
                                        <DataGridTextColumn Header="Table" Width="110" Binding="{Binding PrimaryEntity}"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                        <DataGridTextColumn Header="Duration" Width="70" SortMemberPath="DurationMs"
                                                            Binding="{Binding DurationLabel}" ElementStyle="{StaticResource CellMuted}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- The selected execution -->
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <TextBlock Text="Select an entry to see its trace." Foreground="{DynamicResource Faint}"
                                               Margin="16,14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTrace}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Grid DataContext="{Binding SelectedTrace}"
                                          Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="16,12,16,10">
                                            <TextBlock Text="{Binding TypeName}" FontFamily="{StaticResource MonoFont}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding MessageName, Mode=OneWay}" />
                                                <Run Text="{Binding PrimaryEntity, Mode=OneWay, Converter={StaticResource Prefix}, ConverterParameter='of '}" />
                                                <Run Text="·" Foreground="{DynamicResource Faint}" />
                                                <Run Text="{Binding Mode, Mode=OneWay}" />
                                                <Run Text="·" Foreground="{DynamicResource Faint}" />
                                                <Run Text="{Binding Depth, Mode=OneWay, StringFormat=depth {0}}" />
                                                <Run Text="·" Foreground="{DynamicResource Faint}" />
                                                <Run Text="{Binding DurationLabel, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Faint}"
                                                       Text="{Binding CorrelationId, StringFormat=Correlation id {0}}"
                                                       Visibility="{Binding CorrelationId, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>

                                        <Border Grid.Row="1" Style="{StaticResource PaneHeading}" BorderThickness="0,1,0,1"
                                                Background="{DynamicResource Surface2}">
                                            <TextBlock Text="Trace" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Takes the exception's rows too when there is no exception. -->
                                        <TextBox Grid.Row="2" Text="{Binding MessageBlock, Mode=OneWay}"
                                                 Background="{DynamicResource Surface}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource CodeBox}">
                                                    <Setter Property="Grid.RowSpan" Value="3" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasException}" Value="True">
                                                            <Setter Property="Grid.RowSpan" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <Border Grid.Row="3" Style="{StaticResource PaneHeading}" BorderThickness="0,1,0,1"
                                                Background="{DynamicResource Surface2}"
                                                Visibility="{Binding HasException, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Exception" Style="{StaticResource SectionHeading}"
                                                       Foreground="{DynamicResource Red}" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBox Grid.Row="4" Style="{StaticResource CodeBox}" Text="{Binding ExceptionDetails, Mode=OneWay}"
                                                 Background="{DynamicResource Surface}"
                                                 Visibility="{Binding HasException, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- What the table owns - only a table has any of this, and when it does, it is
                         what the window was most likely opened for, so it starts selected. -->
                    <TabItem Header="Table components" core:Ui.Count="{Binding ComponentCount, StringFormat=N0}"
                             Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}"
                             IsSelected="{Binding IsTable, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" MinWidth="130" />
                                <ColumnDefinition Width="1.3*" MinWidth="200" />
                                <ColumnDefinition Width="*" MinWidth="200" />
                            </Grid.ColumnDefinitions>

                            <!-- Groups -->
                            <Border Grid.Column="0" Background="{DynamicResource Surface2}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                                <ListBox Margin="6,8" ItemsSource="{Binding ChildGroups}" SelectedItem="{Binding SelectedChildGroup}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Height" Value="28" />
                                            <Setter Property="Padding" Value="10,0" />
                                            <Setter Property="Margin" Value="0,0,0,1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="Normal"
                                                           Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Children -->
                            <DockPanel Grid.Column="1">
                                <Border DockPanel.Dock="Top" Height="44" Padding="12,0" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedChildGroup.Label}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox Text="{Binding ChildFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                 core:Ui.Icon="&#xE721;"
                                                 core:Ui.Placeholder="{Binding SelectedChildGroup.Label, StringFormat=Filter {0}}"
                                                 ToolTip="Narrows this list by name, display name or detail." />
                                    </DockPanel>
                                </Border>
                                <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding Children}"
                                          SelectedItem="{Binding SelectedChild}" SelectionMode="Single" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                                            HeaderStyle="{StaticResource PaneFirstHeader}"
                                                            ElementStyle="{StaticResource CellMonoFullFirst}" />
                                        <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"
                                                            ElementStyle="{StaticResource CellFull}" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellFull}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="State" Binding="{Binding ManagedLabel}" Width="78"
                                                            ElementStyle="{StaticResource CellMuted}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- Properties -->
                            <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="44" Padding="12,0" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="0,0,0,1">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="Click a row to copy its value" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedChild}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
                                                        <Setter Property="Text"
                                                                Value="{Binding SelectedChild.PrimaryLabel, StringFormat='Properties of {0}'}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedChild}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="Properties" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>

                                    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}"
                                                 Visibility="{Binding IsLoadingProperties, Converter={StaticResource BoolToVis}}" />

                                    <Grid>
                                        <!-- A property is looked at in order to use it somewhere else, so
                                             a click on the row copies its value - see the code-behind. -->
                                        <DataGrid Style="{StaticResource NestedGrid}" ItemsSource="{Binding ChildProperties}"
                                                  RowStyle="{StaticResource CopyRow}" IsReadOnly="True"
                                                  PreviewMouseLeftButtonUp="OnPropertyClicked">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="170"
                                                                    HeaderStyle="{StaticResource PaneFirstHeader}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellFullFirst}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"
                                                                    ElementStyle="{StaticResource CellMonoFull}" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Sits over the empty grid rather than below it, so the reason
                                             there is nothing to show is where the rows would have been. -->
                                        <TextBlock Text="{Binding ChildStatus}" Foreground="{DynamicResource Muted}"
                                                   Margin="12,38,12,0" TextWrapping="Wrap" VerticalAlignment="Top"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Under the tab strip, where the grid starts. -->
                <ProgressBar Style="{StaticResource BusyBar}" VerticalAlignment="Top" Margin="0,31,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
