<Window x:Class="PPObjectSearch.Views.ImportLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Style="{StaticResource AppWindow}"
        Height="660" Width="1100"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="16,14,16,10">
                <CheckBox Content="Failures and warnings only" Margin="0,0,16,6" VerticalAlignment="Center" IsChecked="{Binding ProblemsOnly}" />
                <Button Content="Copy failures as Markdown" Height="32" Margin="0,0,8,6" Command="{Binding CopyProblemsCommand}" />
                <Button Content="Save raw XML…" Height="32" Margin="0,0,8,6" Command="{Binding SaveXmlCommand}"
                        ToolTip="The log exactly as Dataverse keeps it - what the maker portal offers as a download" />
            </WrapPanel>

            <ProgressBar Grid.Row="1" Height="4" Margin="16,0,16,8" Maximum="100" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"
                         AutomationProperties.Name="Import progress"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

            <DataGrid Grid.Row="2" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True"
                      AutomationProperties.Name="Components in the import"
                      BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Result" Width="96" SortMemberPath="Result" HeaderStyle="{StaticResource FirstHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Margin="16,0,8,0" Content="{Binding ResultLabel}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource StatusPill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Width="140" Binding="{Binding Section}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Component" Width="240" Binding="{Binding Name}" ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Error" Width="*" Binding="{Binding ErrorText}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="ToolTip" Value="{Binding ErrorText}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Finished" Width="90" Binding="{Binding At, StringFormat={}{0:HH:mm:ss}}" ElementStyle="{StaticResource CellMuted}" />
                    <DataGridTextColumn Header="Took" Width="70" Binding="{Binding DurationLabel}" SortMemberPath="Duration" ElementStyle="{StaticResource CellMuted}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource StatusBar}">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding Status}" />
            </Border>
        </Grid>
    </Border>
</Window>
