<Window x:Class="PPObjectSearch.Views.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBody}">
        <StackPanel>
            <StackPanel Margin="18,16,18,16">
                <TextBlock x:Name="Prompt" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBox x:Name="NameBox" />
            </StackPanel>

            <Border Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Height="30" IsCancel="True" />
                    <Button Content="OK" Height="30" Margin="8,0,0,0" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
