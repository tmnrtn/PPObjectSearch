<UserControl x:Class="PPObjectSearch.Views.FlowDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PPObjectSearch.Core"
             xmlns:local="clr-namespace:PPObjectSearch.Views"
             xmlns:models="clr-namespace:PPObjectSearch.Models"
             xmlns:vm="clr-namespace:PPObjectSearch.ViewModels">

    <UserControl.Resources>
        <!-- The line between one step and the next; none above the first of a column. -->
        <Style TargetType="Rectangle" x:Key="Connector">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{DynamicResource Border2}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="Row">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- A column of steps under a label: Yes, No, a switch case, or a parallel branch. -->
        <DataTemplate x:Key="Branch" DataType="{x:Type vm:FlowBranchViewModel}">
            <StackPanel Margin="10,0" VerticalAlignment="Top" MinWidth="120">
                <Border HorizontalAlignment="Center" CornerRadius="10" Padding="10,2" Margin="0,0,0,8"
                        Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BlueSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Yes">
                                    <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="No">
                                    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Blue}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="Yes">
                                        <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="No">
                                        <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <ItemsControl ItemsSource="{Binding Steps}" HorizontalAlignment="Center" Focusable="False" />

                <TextBlock Text="No steps" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Faint}"
                           HorizontalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Parallel branches, side by side in a light frame. -->
        <DataTemplate DataType="{x:Type vm:FlowParallelViewModel}">
            <StackPanel HorizontalAlignment="Center">
                <Rectangle Style="{StaticResource Connector}" />
                <Border BorderBrush="{DynamicResource Border2}" BorderThickness="1" CornerRadius="8" Padding="6,6,6,10">
                    <StackPanel>
                        <TextBlock Text="{Binding Heading}" FontSize="10" Foreground="{DynamicResource Faint}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Branches}" ItemTemplate="{StaticResource Branch}"
                                      ItemsPanel="{StaticResource Row}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- One outcome of a run-after condition: Succeeded, Failed, Timed out, Skipped. -->
        <DataTemplate x:Key="StatusChip" DataType="{x:Type vm:FlowStatusChip}">
            <Border x:Name="Chip" CornerRadius="9" Padding="6,1,7,1" Margin="0,0,4,0" Background="{DynamicResource Surface2}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChipGlyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="9"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="ChipLabel" Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RunAfterTone.Succeeded}">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource GreenSoft}" />
                    <Setter TargetName="ChipGlyph" Property="Foreground" Value="{DynamicResource Green}" />
                    <Setter TargetName="ChipLabel" Property="Foreground" Value="{DynamicResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RunAfterTone.Failed}">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RedSoft}" />
                    <Setter TargetName="ChipGlyph" Property="Foreground" Value="{DynamicResource Red}" />
                    <Setter TargetName="ChipLabel" Property="Foreground" Value="{DynamicResource Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RunAfterTone.TimedOut}">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AmberSoft}" />
                    <Setter TargetName="ChipGlyph" Property="Foreground" Value="{DynamicResource Amber}" />
                    <Setter TargetName="ChipLabel" Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "after Try:" and its outcomes - one line per earlier step the condition names. -->
        <DataTemplate x:Key="RunAfterCondition" DataType="{x:Type vm:FlowRunAfterCondition}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                <TextBlock Text="{Binding AfterLabel}" FontSize="10" Foreground="{DynamicResource Faint}"
                           VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                <ItemsControl ItemsSource="{Binding Statuses}" ItemTemplate="{StaticResource StatusChip}"
                              ItemsPanel="{StaticResource Row}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- A trigger or action. A container frames its branches beneath its card. -->
        <DataTemplate DataType="{x:Type vm:FlowCardViewModel}">
            <StackPanel HorizontalAlignment="Center">
                <!-- Solid for plain success; dashed red, with the outcomes beneath, where the step
                     runs only after something else - the way the designer draws it. -->
                <Line x:Name="Wire" X1="1" Y1="0" X2="1" Y2="18" Width="2" Height="18" StrokeThickness="2"
                      Stroke="{DynamicResource Border2}" HorizontalAlignment="Center" />
                <ItemsControl x:Name="RunAfter" ItemsSource="{Binding RunAfterConditions}"
                              ItemTemplate="{StaticResource RunAfterCondition}" HorizontalAlignment="Center"
                              Margin="0,2,0,5" Focusable="False" Visibility="Collapsed"
                              ToolTip="{Binding RunAfterSummary}" />

                <Border x:Name="Frame" CornerRadius="8" HorizontalAlignment="Center">
                    <StackPanel>
                        <Border x:Name="Card" Width="300" HorizontalAlignment="Center" Cursor="Hand"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border2}"
                                BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True"
                                ToolTip="{Binding Summary}">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                              Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border.InputBindings>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Bar" CornerRadius="5,0,0,5" Background="{DynamicResource Faint}" />

                                <StackPanel Grid.Column="1" Margin="10,8,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="Icon" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13"
                                                   Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button x:Name="Toggle" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Width="22" Height="22" Padding="0" Margin="6,-2,-2,-2" Visibility="Collapsed"
                                                Command="{Binding ToggleCommand}" ToolTip="Show or hide the steps inside">
                                            <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10"
                                                       Foreground="{DynamicResource Muted}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis" Margin="21,2,0,0" />

                                    <!-- In a run: the outcome and how long it took; a loop, how often it went round. -->
                                    <StackPanel x:Name="RunRow" Orientation="Horizontal" Margin="21,5,0,0" Visibility="Collapsed">
                                        <Border x:Name="RunPill" CornerRadius="9" Padding="6,1,7,1" Background="{DynamicResource Surface2}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="RunGlyph" Style="{StaticResource Icon}" Text="{Binding RunGlyph}" FontSize="9"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock x:Name="RunText" Text="{Binding RunBadge}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding IterationLabel}" FontSize="10" Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding HasIterationLabel, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"
                                               Margin="21,3,0,0" ToolTip="{Binding DetailTooltip}"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="{Binding Description}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Muted}" Margin="21,4,0,0" MaxHeight="48"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="Branches" ItemsSource="{Binding Branches}" ItemTemplate="{StaticResource Branch}"
                                      ItemsPanel="{StaticResource Row}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                      Focusable="False" Visibility="Collapsed" />

                        <TextBlock x:Name="Collapsed" Text="{Binding CollapsedLabel}" FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="Wire" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRunAfterConditions}" Value="True">
                    <Setter TargetName="Wire" Property="Stroke" Value="{DynamicResource Red}" />
                    <Setter TargetName="Wire" Property="StrokeDashArray" Value="2 1.5" />
                    <Setter TargetName="RunAfter" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsContainer}" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Surface2}" />
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Border}" />
                    <Setter TargetName="Frame" Property="BorderThickness" Value="1" />
                    <Setter TargetName="Frame" Property="Padding" Value="10" />
                    <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Branches" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsContainer}" Value="True" />
                        <Condition Binding="{Binding IsExpanded}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Branches" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Collapsed" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                </MultiDataTrigger>

                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:FlowNodeCategory.Trigger}">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:FlowNodeCategory.Control}">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource EnvTrial}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource EnvTrial}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:FlowNodeCategory.Connector}">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Green}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:FlowNodeCategory.Data}">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Amber}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:FlowNodeCategory.Variable}">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Blue}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:FlowNodeCategory.Http}">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource EnvSandbox}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource EnvSandbox}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:FlowNodeCategory.ChildFlow}">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource EnvDefault}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource EnvDefault}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding InRun}" Value="True">
                    <Setter TargetName="RunRow" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunOutcome}" Value="{x:Static models:FlowStepOutcome.Succeeded}">
                    <Setter TargetName="RunPill" Property="Background" Value="{DynamicResource GreenSoft}" />
                    <Setter TargetName="RunGlyph" Property="Foreground" Value="{DynamicResource Green}" />
                    <Setter TargetName="RunText" Property="Foreground" Value="{DynamicResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunOutcome}" Value="{x:Static models:FlowStepOutcome.Failed}">
                    <Setter TargetName="RunPill" Property="Background" Value="{DynamicResource RedSoft}" />
                    <Setter TargetName="RunGlyph" Property="Foreground" Value="{DynamicResource Red}" />
                    <Setter TargetName="RunText" Property="Foreground" Value="{DynamicResource Red}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Red}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunOutcome}" Value="{x:Static models:FlowStepOutcome.TimedOut}">
                    <Setter TargetName="RunPill" Property="Background" Value="{DynamicResource AmberSoft}" />
                    <Setter TargetName="RunGlyph" Property="Foreground" Value="{DynamicResource Amber}" />
                    <Setter TargetName="RunText" Property="Foreground" Value="{DynamicResource Amber}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Amber}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunOutcome}" Value="{x:Static models:FlowStepOutcome.Running}">
                    <Setter TargetName="RunPill" Property="Background" Value="{DynamicResource BlueSoft}" />
                    <Setter TargetName="RunGlyph" Property="Foreground" Value="{DynamicResource Blue}" />
                    <Setter TargetName="RunText" Property="Foreground" Value="{DynamicResource Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunOutcome}" Value="{x:Static models:FlowStepOutcome.Waiting}">
                    <Setter TargetName="RunPill" Property="Background" Value="{DynamicResource BlueSoft}" />
                    <Setter TargetName="RunGlyph" Property="Foreground" Value="{DynamicResource Blue}" />
                    <Setter TargetName="RunText" Property="Foreground" Value="{DynamicResource Blue}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AmberSoft}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="TextBlock" x:Key="DetailHeading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,12,0,3" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ toolbar -->
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallButton}" Content="Copy as Mermaid" Margin="0,0,14,0"
                            Command="{Binding CopyMermaidCommand}"
                            ToolTip="Copy the flow as a Mermaid flowchart, to paste into a wiki, a README or a pull request." />
                    <Button Style="{StaticResource SmallButton}" Content="Expand all" Command="{Binding ExpandAllCommand}" />
                    <Button Style="{StaticResource SmallButton}" Content="Collapse all" Margin="6,0,14,0"
                            Command="{Binding CollapseAllCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Width="26" Height="26"
                            Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+wheel)" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding ZoomLabel}" MinWidth="48" Height="26"
                            Command="{Binding ResetZoomCommand}" ToolTip="Back to 100%" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Width="26" Height="26"
                            Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl+wheel)" />
                </StackPanel>

                <TextBox Width="260" Height="28" HorizontalAlignment="Left"
                         core:Ui.Icon="&#xE721;" core:Ui.Placeholder="Find a step - name, type, connector"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                <TextBlock Text="{Binding MatchLabel}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"
                           Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Green}" VerticalAlignment="Center"
                           Margin="14,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" />
            </DockPanel>
        </Border>

        <!-- ============================================================ the run on show -->
        <Border Grid.Row="1" Padding="14,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasRunBanner, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunFailed}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasRunNotice}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Surface2}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunNoticeError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Loading, or why a run could not be shown. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding RunNotice}" TextWrapping="Wrap"
                           Visibility="{Binding HasRunNotice, Converter={StaticResource BoolToVis}}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding IsRunMode, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SmallButton}" Content="Jump to first failure" Margin="0,0,6,0"
                            Command="{Binding JumpToFailureCommand}"
                            ToolTip="Select the first step that failed, opening whatever holds it" />
                    <Button Style="{StaticResource SmallButton}" Content="Back to design" Command="{Binding ClearRunCommand}"
                            ToolTip="Show the flow's design without this run" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsRunMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RunHeading}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RunDetail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RunMismatch}" FontSize="11" Foreground="{DynamicResource Amber}" Margin="0,4,0,0"
                               TextWrapping="Wrap" Visibility="{Binding HasRunMismatch, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding RunError}" FontSize="11" Foreground="{DynamicResource Red}" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding RunError}"
                               Visibility="{Binding HasRunError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Banner}" Margin="12,8,12,0"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ the diagram -->
            <ScrollViewer x:Name="Canvas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Bg}" PreviewMouseWheel="Canvas_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Steps}" Margin="32,24,32,48" HorizontalAlignment="Center"
                              Focusable="False">
                    <ItemsControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </ItemsControl.LayoutTransform>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext" />

            <!-- ============================================================ the selected step -->
            <Grid Grid.Column="2" Background="{DynamicResource Surface}">
                <TextBlock Text="Select a step to see its details." Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" Margin="0,60,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasSelection, Converter={StaticResource NotBoolToVis}}" />

                <Grid Margin="14,12,14,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding Selected.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.Summary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="Name in the definition:" />
                            <Run Text="{Binding Selected.Node.Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                            <Run Text="·" />
                            <Run Text="{Binding Selected.Node.Type, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Selected.Description}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Muted}"
                                   Visibility="{Binding Selected.HasDescription, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Runs after" Style="{StaticResource DetailHeading}" />
                        <TextBlock Text="{Binding SelectedRunAfter}" TextWrapping="Wrap" />

                        <!-- The step in the run on show. -->
                        <StackPanel Visibility="{Binding IsRunMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="In this run" Style="{StaticResource DetailHeading}" />
                            <TextBlock Text="{Binding SelectedRunStatus}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding SelectedError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="{DynamicResource RedSoft}" Foreground="{DynamicResource Red}"
                                     Padding="6,4" Margin="0,6,0,0" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                     Visibility="{Binding HasSelectedError, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding IterationStatus}" FontSize="11" Foreground="{DynamicResource Muted}"
                                       TextWrapping="Wrap" Margin="0,8,0,4"
                                       Visibility="{Binding IterationStatus, Converter={StaticResource EmptyToCollapsed}}" />
                            <ListBox ItemsSource="{Binding SelectedIterations}" SelectedItem="{Binding SelectedIteration}"
                                     DisplayMemberPath="Summary" MaxHeight="130"
                                     Visibility="{Binding HasSelectedIterations, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource SmallButton}" Content="Show inputs" Command="{Binding ShowInputsCommand}"
                                        ToolTip="Read what the step was given. Fetched only when you ask, and never saved." />
                                <Button Style="{StaticResource SmallButton}" Content="Show outputs" Margin="6,0,0,0"
                                        Command="{Binding ShowOutputsCommand}"
                                        ToolTip="Read what the step returned. Fetched only when you ask, and never saved." />
                                <Button Style="{StaticResource LinkButton}" Content="Back to definition" Margin="10,0,0,0"
                                        Command="{Binding ShowDefinitionCommand}"
                                        Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Text="Reading..." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                                       Visibility="{Binding IsContentLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ContentError}" FontSize="11" Foreground="{DynamicResource Red}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasContentError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding DetailCodeTitle}" Style="{StaticResource DetailHeading}" />
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,12">
                        <local:CodeView Code="{Binding DetailCode}" Syntax="Json" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
