<Window x:Class="PPObjectSearch.Views.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PPObjectSearch.Views"
        Style="{StaticResource DialogWindow}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <!-- Every question the app asks: where, what, and two buttons named for what they do. -->
    <Border Style="{StaticResource WindowBody}">
        <StackPanel>
            <StackPanel Margin="18,16,18,16">
                <local:EnvironmentLine x:Name="Environment" Visibility="Collapsed" />
                <TextBlock x:Name="Heading" Style="{StaticResource WindowHeading}" Margin="0,0,0,8" TextWrapping="Wrap" />
                <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="18" />
                <ItemsControl x:Name="Points" Margin="12,4,0,0" Focusable="False" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="Note" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="18"
                           Margin="0,10,0,0" Visibility="Collapsed" />
                <Border x:Name="Acknowledgement" Margin="0,14,0,0" Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource RedSoft}" Visibility="Collapsed">
                    <CheckBox x:Name="AcknowledgeBox" Style="{StaticResource DangerCheckBox}"
                              Checked="Acknowledge_Changed" Unchecked="Acknowledge_Changed">
                        <TextBlock x:Name="AcknowledgeText" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </CheckBox>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Height="30" IsCancel="True" />
                    <Button x:Name="ConfirmButton" Height="30" Margin="8,0,0,0" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
