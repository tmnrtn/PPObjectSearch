<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="Bg" Color="#F4F4F5" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface2" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Hover" Color="#F1F1F3" />
    <SolidColorBrush x:Key="Selected" Color="#EDF1FB" />
    <SolidColorBrush x:Key="Border" Color="#E7E7EA" />
    <SolidColorBrush x:Key="Border2" Color="#D6D6DB" />
    <SolidColorBrush x:Key="Text" Color="#18181B" />
    <SolidColorBrush x:Key="Muted" Color="#62626B" />
    <SolidColorBrush x:Key="Faint" Color="#8E8E96" />
    <SolidColorBrush x:Key="Accent" Color="#0B57D0" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E9EFFC" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Link" Color="#0B57D0" />
    <SolidColorBrush x:Key="Shadow" Color="#1F000000" />

    <!-- Status: fg / soft background -->
    <SolidColorBrush x:Key="Red" Color="#B3261E" />
    <!-- A destructive button's fill and text: white on this red is about 6.5:1. -->
    <SolidColorBrush x:Key="DangerBg" Color="#B3261E" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RedSoft" Color="#FCEFEE" />
    <SolidColorBrush x:Key="Blue" Color="#1F52C4" />
    <SolidColorBrush x:Key="BlueSoft" Color="#EEF3FC" />
    <SolidColorBrush x:Key="Amber" Color="#9A6400" />
    <SolidColorBrush x:Key="AmberSoft" Color="#FFF6E5" />
    <SolidColorBrush x:Key="Green" Color="#1F8A4C" />
    <SolidColorBrush x:Key="GreenSoft" Color="#ECF8EF" />
    <SolidColorBrush x:Key="DiffAddedBg" Color="#DDF3E2" />
    <SolidColorBrush x:Key="DiffRemovedBg" Color="#FBE3E1" />
    <SolidColorBrush x:Key="DiffAddedWord" Color="#A8E0B0" />
    <SolidColorBrush x:Key="DiffRemovedWord" Color="#F5B4AC" />

    <!-- A diff gap row: 1px diagonal lines every 5px, so the panes stay aligned. -->
    <DrawingBrush x:Key="HatchBrush" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute"
                  Viewbox="0,0,5,5" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 L5,5">
                <GeometryDrawing.Pen>
                    <Pen Brush="#E7E7EA" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Environment types -->
    <SolidColorBrush x:Key="EnvProduction" Color="#C0392F" />
    <SolidColorBrush x:Key="EnvDefault" Color="#C0701A" />
    <SolidColorBrush x:Key="EnvSandbox" Color="#0079A8" />
    <SolidColorBrush x:Key="EnvDeveloper" Color="#2B8A4B" />
    <SolidColorBrush x:Key="EnvTrial" Color="#8356B8" />
    <SolidColorBrush x:Key="EnvUnknown" Color="#8E8E96" />

    <Color x:Key="AccentColor">#0B57D0</Color>

    <!-- System colours used inside stock templates (scroll viewer corner, text selection, disabled text). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#18181B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#18181B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8E8E96" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EDF1FB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#18181B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EDF1FB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#18181B" />

</ResourceDictionary>
